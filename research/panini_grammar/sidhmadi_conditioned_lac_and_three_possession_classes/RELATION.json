  "source_policy_decisions":[
    {"id":"COORDINATED_ALTERNATIVE","status":"Accepted/Open","decision":"Treat anyatarasyām as coordinating lac with matup, not as admitting ini/ṭhan; full sidhmādi membership remains Open."},
