    {"id":"OWNED_OPERATIONS","status":"Accepted","decision":"Assign pre-l lengthening and ūṅ augmentation to their stated bases before lac."},
    {"id":"VASU_EXTENSIONS","status":"Accepted/Open","decision":"Accept source-given galūla and kaṭāla while retaining their roster status relative to Kāśikā as Open."},
    {"id":"CENSURE_GUARD","status":"Accepted/Excluded","decision":"Accept lac/ilac under censure and matup without censure; exclude the matup control only from the censure branch."},
    {"id":"ORGANISM_DISEASE","status":"Accepted/Open","decision":"Accept the five displayed organism/disease outputs; broader class membership remains Open."},
    {"id":"LOVE_STRENGTH","status":"Accepted/Excluded","decision":"Require lac for the special love/strength predicates and retain matup controls in other senses."},
    {"id":"PHENA_CHOICES","status":"Accepted","decision":"Correlate ilac, lac and matup as three owned histories for one phena position."},
    {"id":"THREE_CLASSES","status":"Accepted/Open","decision":"Keep ś, na and ilac class owners and conditioned operations distinct; retain picchavān/picchivān and full rosters Open."}
