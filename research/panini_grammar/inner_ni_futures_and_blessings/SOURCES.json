{
  "edition": "5744762f010d677cfb43f347a42d02796cf615d6",
  "fields": [
    {
      "work": "kashika",
      "rule": "1.2.4",
      "field": "12004",
      "text": "सार्वधातुकं यदपित् तद् ङिद्वद् भवति। कुरुतः, कुर्वन्ति। चिनुतः, चिन्वन्ति। सार्वधातुकमिति किम्? कर्ता। कर्तुम्। कर्तव्यम्। अपिदिति किम्? करोति। करोषि। करोमि॥"
    },
    {
      "work": "kashika",
      "rule": "1.4.59",
      "field": "14059",
      "text": "प्रादयः क्रियायोगे उपसर्गसंज्ञा भवन्ति। प्रणयति। परिणयति। प्रणायकः। परिणायकः। क्रियायोग इति किम्? प्रगतो नायकोऽस्माद्देशात् प्रनायको देशः॥ मरुच्छब्दस्य चोपसंख्यानं कर्तव्यम् (म०भा० [[१.४.५९]] वा० २) ॥ मरुद्भिर्दत्तो मरुत्तः। संज्ञाविधानसामर्थ्यादनजन्तत्वेऽपि <<अच उपसर्गात्तः>> [[७.४.४७]] इति तत्वं भवति ॥ श्रच्छब्दस्योपसंख्यानम् (म०भा० [[१.४.५९]] वा० ३ ) ॥ <<आतश्चोपसर्गे>> [[३.३.१०६]] इत्यङ् भवति। श्रद्धा। उपसर्गप्रदेशाः — <<उपसर्गे घोः किः>> [[३.३.९३]] इत्येवमादयः॥"
    },
    {
      "work": "kashika",
      "rule": "6.1.77",
      "field": "61077",
      "text": "अचि परत इको यणादेशो भवति। दध्यत्र। मध्वत्र। कर्त्रर्थम्। हर्त्रर्थम्। लाकृतिः॥ इकः प्लुतपूर्वस्य सवर्णदीर्घबाधनार्थं यणादेशो वक्तव्यः॥ भो३ इ इन्द्रम्। भो३यिन्द्रम्। अचीति चायमधिकारः  <<संप्रसारणाच्च>> [[६.१.१०८]] इति यावत्॥"
    },
    {
      "work": "kashika",
      "rule": "7.2.35",
      "field": "72035",
      "text": "छन्दसीति निवृत्तम्। आर्धधातुकस्य वलादेरिडागमो भवति। लविता। लवितुम्। लवितव्यम्। पविता। पवितुम्। पवितव्यम्। आर्धधातुकस्येति किम्? आस्ते। शेते। वस्ते। <<रुदादिभ्यः सार्वधातके>> [[७.२.७६]] इत्येतस्मिन् नियमार्थे विज्ञायमाने प्रतिपत्तिगौरवं भवतीति आर्धधातुक्रहणं क्रियते। वलादेरिति किम्? लव्यम्। पव्यम्। लवनीयम्। पवनीयम्। इडिति वर्तमाने पुनरिड्ग्रहणं प्रतिषेधनिवृत्त्यर्थम्॥"
    },
    {
      "work": "kashika",
      "rule": "7.3.74",
      "field": "73074",
      "text": "शमादीनामष्टानां दीर्घो भवति श्यनि परतः। शम् — शाम्यति। तम् — ताम्यति। दम् — दाम्यति। श्रम् — श्राम्यति। भ्रम् — भ्राम्यति। क्षम् — क्षाम्यति। क्लम् — क्लाम्यति। मदी — माद्यति। अष्टानामिति किम्?। अस्यति। श्यनीति किम्? भ्रमति। <<वा भ्राश०>> [[३.१.७०]] इति श्यनो विकल्पः। बभ्राम॥"
    },
    {
      "work": "kashika",
      "rule": "8.4.17",
      "field": "84017",
      "text": "नि इत्येतस्योपसर्गस्थाद् निमित्तादुत्तरस्य नकारस्य णकारादेशो भवति गद नद पत पद घु मा स्यति हन्ति याति वाति द्राति प्साति वपति वहति शाम्यति चिनोति देग्धि इत्येतेषु परतः। गद — प्रणिगदति। परिणिगदति। नद — प्रणिनदति। परिणिनदति। पत — प्रणिपतति। परिणिपतति। पद — प्रणिपद्यते। परिणिपद्यते। घु — प्रणिददाति। परिणिददाति। प्रणिदधाति। परिणिदधाति। माङ् — प्रणिमिमीते। परिणिमिमीते। मेङ् — प्रणिमयते। परिणिमयते। मा इति माङ्मेङोर्ग्रहणमिष्यते। स्यति — प्रणिष्यति। परिणिष्यति। हन्ति — प्रणिहन्ति। परिणिहन्ति। याति — प्रणियाति। परिणियाति। वाति — प्रणिवाति। परिणिवाति। द्राति — प्रणिद्राति। परिणिद्राति। प्साति — प्रणिप्साति। परिणिप्साति। वपति — प्रणिवपति। परिणिवपति। वहति — प्रणिवहति। परिणिवहति। शाम्यति — प्रणिशाम्यति। परिणिशाम्यति। चिनोति — प्रणिचिनोति। परिणिचिनोति। देग्धि — प्रणिदेग्धि। परिणिदेग्धि। अड्व्यवायेऽपि नेर्गदादिषु णत्वमिष्यते। प्रण्यगदत्। परिण्यगदत्॥"
    },
    {
      "work": "kashika",
      "rule": "8.4.55",
      "field": "84055",
      "text": "खरि च परतो झलां चरादेशो भवति। जश्ग्रहणं नानुवर्तते पूर्वसूत्रे चानुकृष्टत्वात्। भेत्ता। भेत्तुम्। भेत्तव्यम्। युयुत्सते। आरिप्सते। आलिप्सते॥"
    }
  ],
