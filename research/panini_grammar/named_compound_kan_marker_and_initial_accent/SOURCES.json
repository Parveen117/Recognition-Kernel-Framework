  "new_fields": [
    {
      "source": "kashika.txt",
      "field": "53075",
      "text": "कुत्सित इत्येव। कुत्सितत्वोपाधिकेऽर्थे वर्तमानात् प्रातिपदिकात् कन् प्रत्ययो भवति, कस्यापवादः, प्रत्ययान्तेन चेत् संज्ञा गम्यते। शूद्रकः। धारकः। पूर्णकः ॥"
    },
    {
      "source": "kashika.txt",
      "field": "61197",
      "text": "ञिति निति च नित्यमादिरुदात्तो भवति। <<गर्गादिभ्यो यञ्>> [[४.१.१०५]] — गार्ग्यः॑। वात्स्यः॑। <<वासुदेवार्जुनाभ्यां वुन्>> [[४.३.९८]] — वासु॑देवकः। अर्जु॑नकः। प्रत्ययस्वरापवादोऽयं योगः। प्रत्ययलक्षणमत्र नेष्यते, तेन ग॒र्गाः, बि॒दाः, च॒ञ्चा इत्यत्र यञि कनि च लुप्ते न भवति॥"
    },
    {
      "source": "kashika.txt",
      "field": "31003",
      "text": "अयमप्यधिकारः परिभाषा वा। आद्युदात्तश्च स भवति यः प्रत्ययसंज्ञः। अनियतस्वर — प्रत्ययप्रसङ्गेऽनेकाक्षु च प्रत्ययेषु देशस्यानियमे सति वचनमिदमादेरुदात्तार्थम्।कर्तव्यम्। तैत्तिरीयम्॥"
    },
    {
      "source": "kaumudi.txt",
      "field": "53075",
      "text": "कुत्सिते कन् स्यात्तदन्तेन चेत्संज्ञा गम्यते । शूद्रकः । राधकः । स्वरार्थं वचनम् ॥"
    },
    {
      "source": "balamanorama.txt",
      "field": "53075",
      "text": "<<संज्ञायां कन्>> - संज्ञायां कन् । कुत्सिते इत्यनुवर्तते । तदाह — कुत्सित इति । तदन्तेन चेदिति । कुत्साहेतुकसंज्ञाविषये कनिति यावत् ।"
    }
  ],
