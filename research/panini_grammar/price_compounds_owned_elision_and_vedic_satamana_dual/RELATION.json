  "source_policy_decisions": [
    {
      "id": "COIN",
      "sources": "K25,M25,K29",
      "decision": "Separate the affix, feminine marker and optional base replacement. Luk cannot leave visible prati in the listed 29 outcomes."
    },
    {
      "id": "BASKET",
      "sources": "K26,K28,M28",
      "decision": "A single basket gives añ or ṭhañ. The two-basket compound is already owned by PG751. Patañjali also distinguishes the analytical phrase with a feminine basket input."
    },
    {
      "id": "METAL",
      "sources": "K27,M136,M137,SB,EG",
      "decision": "Keep derived initial vṛddhi apart from the base noun. The silver coin standard in Manu and the paired sacrificial pieces in Śatapatha have their own attestations and cases."
    },
    {
      "id": "MANY",
      "sources": "M31,K31",
      "decision": "The bahu examples are explicit vārttika extensions. The dvi/tri niṣka predicate positions already counted at PG751 take no new credit."
    },
    {
      "id": "POSITIVE",
      "sources": "K32,K33",
      "decision": "Kha and īkan have positive work precisely where ordinary elision would erase the affix; bare khārī and bare kākiṇī need their own authority. An online first-example discrepancy at 32 stays a source observation."
    },
    {
      "id": "QUARTER",
      "sources": "K34,K35",
      "decision": "Pāda used as a monetary fraction retains its vowel; the limb substitution cannot run. Śata receives an additional zero reading only under its own supplementary clause."
    },
    {
      "id": "THREE",
      "sources": "K35,K36",
      "decision": "One and a half allows two readings and two or three allow a third. The initial member strengthens with aṇ because śāṇa is expressly excepted at 7.3.17."
    }
  ]
}
