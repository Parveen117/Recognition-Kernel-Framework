  "source_policy_decisions": [
    {
      "id": "POSSESSION",
      "sources": "K56,K57",
      "decision": "Three possible relations share a numeral, but a single interrogative input has to specify which. For census the three five-unit histories are represented by one surface-case position with three queryable semantic branches."
    },
    {
      "id": "STUDY",
      "sources": "K58",
      "decision": "Counting chapters, members of an animate association, and repetitions of study are distinct. The names of works are grammatical testimony to their descriptions."
    },
    {
      "id": "STOMA",
      "sources": "K58,VS",
      "decision": "Three bare stoma adjectives have direct Mādhyandina support; no generic original Vedic suffix assignment follows from a matching word."
    },
    {
      "id": "MONTH",
      "sources": "K58,TS7",
      "decision": "Retain the underlying word end of both nominatives through external sandhi; the predicate series and the paired calendar nouns determine case."
    },
    {
      "id": "SEERS",
      "sources": "K58,GB",
      "decision": "The Gopatha source assigns the seer group an accusative. Additional short citations without a governing verb cannot alone establish a nominative."
    },
    {
      "id": "SEVEN",
      "sources": "K61,TS5,TC",
      "decision": "The traditional creation example and the checked primary gratification clause share the group word and case. Exact source of the grammatical example with creation stays Open."
    }
