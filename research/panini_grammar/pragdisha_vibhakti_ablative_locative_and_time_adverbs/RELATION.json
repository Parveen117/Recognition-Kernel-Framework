  "source_policy_decisions":[
    {"id":"PRAGDISHA_BOUNDARY","status":"Accepted","decision":"Treat the suffixes through but excluding 5.3.27 as vibhakti; later suffixes do not inherit this label."},
    {"id":"LOCAL_OPTIONALITY","status":"Accepted/Open","decision":"Accept Kāśikā/Vasu optional case-expression for the early prāgdiśa examples; retain PG4 quarantine against blanket 4.1.82 vā inheritance across later svārthikas."},
    {"id":"BASE_RANGE","status":"Accepted/Excluded","decision":"Admit kim, eligible pronouns and numerical bahu; exclude dvi onward, ordinary nouns and non-numerical bahu only from this base contract."},
    {"id":"SUBSTITUTION_OWNERS","status":"Accepted/Open","decision":"Keep idam and etad whole-base substitutions distinct; Kāśikā aś and reported Patañjali an priority remains Open without changing credited surfaces."},
    {"id":"SARVA_OPTION","status":"Accepted/Excluded","decision":"Accept sarvadā/sadā only before the licensed d-initial prāgdiśa suffix; ordinary sarva+dā 'giving all' is outside this substitution."},
    {"id":"TASIL_HISTORIES","status":"Accepted","decision":"Retain direct 5.3.7 tasil and 5.3.8 tasi-to-tasil as separate derivational readings of four equal surfaces."},
    {"id":"PARI_ABHI_GUARD","status":"Accepted/Excluded","decision":"Accept paritaḥ for all-around and abhitaḥ for both-sides; other pari/abhi senses are outside this rule."},
    {"id":"LOCATIVE_EXCEPTIONS","status":"Accepted/Open","decision":"Accept iha, kva and the reported optional kutra while preserving their distinct substitution and affix owners."},
    {"id":"VEDIC_H_LOCATOR","status":"Accepted/Open","decision":"Accept source-attested kuha and Vedic kva; Kāśikā 8.73.4 versus Vasu 8.62.4 locator conflict remains unresolved."},
    {"id":"OTHER_CASE_LEXICON","status":"Accepted/Open","decision":"Accept the fourteen displayed bhavat contexts; the wider dīrghāyus/āyuṣmat/devānāṃ priya realization remains unconstructed."},
    {"id":"TIME_DA","status":"Accepted/Excluded","decision":"Accept dā only under the time guard; retain sarvatra deśe as the explicit place control."},
    {"id":"ACCENT_AND_PARADIGMS","status":"Open","decision":"Complete accent and non-displayed paradigmatic distribution before any wider closure claim."}
  ]
