{
  "edition": "5744762f010d677cfb43f347a42d02796cf615d6",
  "fields": [
    {
      "work": "kashika",
      "rule": "1.2.17",
      "field": "12017",
      "text": "सिजात्मनेपदेष्विति वर्तते। तिष्ठतेर्धातोर्घुसंज्ञकानां च इकारश्चान्तादेशः सिच्च किद् भवत्यात्मनेपदेषु परतः। उपास्थित, उपास्थिषाताम्, उपास्थिषत। घुसंज्ञकानाम् — अदित। अधित॥\n\nइच्च कस्य तकारेत्त्वं दीर्घो मा भूदृतेऽपि सः।\n\nअनन्तरे प्लुतो मा भूत् प्लुतश्च विषये स्मृतः॥ (म० भा० [[१.२.१७]], वा० १-५)"
    },
    {
      "work": "kashika",
      "rule": "1.3.72",
      "field": "13072",
      "text": "णेरिति निवृत्तम्। शेषात् कर्तरि परस्मैपदे ([[१.३.७८]]) प्राप्ते, स्वरितेतो ये धातवो ञितश्च तेभ्य आत्मनेपदं भवति, कर्तारं चेत्क्रियाफलमभिप्रैति। क्रियायाः फलं क्रियाफलं प्रधानभूतम्, यदर्थमसौ क्रियारभ्यते तच्चेत् कर्तुर्लकारवाच्यस्य भवति। यजते। पचते। ञितः खल्वपि — सुनुते। कुरुते। स्वर्गादि प्रधानफलमिह कर्तारमभिप्रैति। कर्त्रभिप्राये इति किम्? यजन्ति याजकाः। पचन्ति पाचकाः। कुर्वन्ति कर्मकराः। यद्यपि दक्षिणा भृतिश्च कर्तुः फलमिहास्ति, तथापि न तदर्थः क्रियारम्भः॥"
    },
    {
      "work": "kashika",
      "rule": "2.4.77",
      "field": "24077",
      "text": "लुगनुवर्तते, न श्लुः। गाति स्था घु पा भू इत्येतेभ्यः परस्य सिचो लुग् भवति परस्मैपदेषु परतः। अगात्। अस्थात्। अदात्। अधात्। अपात्। अभूत्॥ गापोर्गर्हणे इण्पिबत्योर्ग्रहणम्॥ गायतेः पातेश्च न भवति। अगासीन् नटः। अपासीन् नृपः। परस्मैपदेष्विति किम्? अगासातां ग्रामौ देवदत्तेन॥"
    },
    {
      "work": "kashika",
      "rule": "6.1.77",
      "field": "61077",
      "text": "अचि परत इको यणादेशो भवति। दध्यत्र। मध्वत्र। कर्त्रर्थम्। हर्त्रर्थम्। लाकृतिः॥ इकः प्लुतपूर्वस्य सवर्णदीर्घबाधनार्थं यणादेशो वक्तव्यः॥ भो३ इ इन्द्रम्। भो३यिन्द्रम्। अचीति चायमधिकारः  <<संप्रसारणाच्च>> [[६.१.१०८]] इति यावत्॥"
    },
    {
      "work": "kashika",
      "rule": "6.4.64",
      "field": "64064",
      "text": "इट्यजादावार्धधातुके क्ङिति चाकारान्तस्याङ्गस्य लोपो भवति। इटि — पपिथ। तस्थिथ। किति — पपतुः, पपुः। तस्थतुः, तस्थुः। गोदः। कम्बलदः। ङिति — प्रदा। प्रधा। आर्धधातुक इत्येव — यान्ति। वान्ति। व्यत्यरे। व्यत्यले। रातेर्लातेश्च लङीटि रूपम्। अचीत्येव — ग्लायते। दासीय॥"
    },
    {
      "work": "kashika",
      "rule": "7.2.6",
      "field": "72006",
      "text": "ऊर्णोतेरिडादौ सिचि परस्मैपदपरे परतो विभाषा वृद्धिर्न भवति। प्रौर्णवीत्, प्रौर्णावीत्। <<विभाषोर्णोः>>[[१.२.३]] इत्यङित्त्वपक्षे वृद्धिविकल्पोऽयम्। ङित्त्वपक्षे तु गुणवृद्ध्योरभाव उवङ् भवति। प्रौर्णुवीत्॥"
    },
    {
      "work": "kashika",
      "rule": "8.4.17",
      "field": "84017",
      "text": "नि इत्येतस्योपसर्गस्थाद् निमित्तादुत्तरस्य नकारस्य णकारादेशो भवति गद नद पत पद घु मा स्यति हन्ति याति वाति द्राति प्साति वपति वहति शाम्यति चिनोति देग्धि इत्येतेषु परतः। गद — प्रणिगदति। परिणिगदति। नद — प्रणिनदति। परिणिनदति। पत — प्रणिपतति। परिणिपतति। पद — प्रणिपद्यते। परिणिपद्यते। घु — प्रणिददाति। परिणिददाति। प्रणिदधाति। परिणिदधाति। माङ् — प्रणिमिमीते। परिणिमिमीते। मेङ् — प्रणिमयते। परिणिमयते। मा इति माङ्मेङोर्ग्रहणमिष्यते। स्यति — प्रणिष्यति। परिणिष्यति। हन्ति — प्रणिहन्ति। परिणिहन्ति। याति — प्रणियाति। परिणियाति। वाति — प्रणिवाति। परिणिवाति। द्राति — प्रणिद्राति। परिणिद्राति। प्साति — प्रणिप्साति। परिणिप्साति। वपति — प्रणिवपति। परिणिवपति। वहति — प्रणिवहति। परिणिवहति। शाम्यति — प्रणिशाम्यति। परिणिशाम्यति। चिनोति — प्रणिचिनोति। परिणिचिनोति। देग्धि — प्रणिदेग्धि। परिणिदेग्धि। अड्व्यवायेऽपि नेर्गदादिषु णत्वमिष्यते। प्रण्यगदत्। परिण्यगदत्॥"
    }
  ],
