  "source_policy_decisions": [
    {
      "id": "TIME",
      "sources": "K79,K80,K85",
      "decision": "The interval over which teaching or work occurs is distinct from the instant at which the appointment or payment was made. Retain the dissenting completion analysis at 85."
    },
    {
      "id": "AGE",
      "sources": "K81,K83,K84",
      "decision": "Preserve the three routes for six months as age and the two for duration. The identical ṣāṇmāsya can have different inputs."
    },
    {
      "id": "DAWN",
      "sources": "RAM,RAM22,K79,MAL",
      "decision": "Do not duplicate the independent āhnikam surface or force the epic daily duty and the monthly recurring fee into the grammatical accomplishment predicate."
    },
    {
      "id": "COMPOUND",
      "sources": "K85,K87,K88",
      "decision": "Record locus of strengthening, exceptional day stem and deletion even where the resulting terminal spelling is shared."
    },
    {
      "id": "TEXT",
      "sources": "K88,MAN,YAJ,IDX",
      "decision": "Maintain the two distinct literary compounds and the explicitly supplied possessive vigraha. They do not provide a second form of the simple nominative boy example."
    },
    {
