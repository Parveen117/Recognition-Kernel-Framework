  "sutra_texts": [
    {
      "sutra_id": "1.1.3",
      "source_key": "11003",
      "text": "इको गुणवृद्धी"
    },
    {
      "sutra_id": "1.1.5",
      "source_key": "11005",
      "text": "क्ङिति च"
    },
    {
      "sutra_id": "1.1.46",
      "source_key": "11046",
      "text": "आद्यन्तौ टकितौ"
    },
    {
      "sutra_id": "1.1.50",
      "source_key": "11050",
      "text": "स्थानेऽन्तरतमः"
    },
    {
      "sutra_id": "1.1.53",
      "source_key": "11053",
      "text": "ङिच्च"
    },
    {
      "sutra_id": "1.1.56",
      "source_key": "11056",
      "text": "स्थानिवदादेशोऽनल्विधौ"
    },
    {
      "sutra_id": "1.1.57",
      "source_key": "11057",
      "text": "अचः परस्मिन् पूर्वविधौ"
    },
    {
      "sutra_id": "1.1.65",
      "source_key": "11065",
      "text": "अलोऽन्त्यात् पूर्व उपधा"
    },
    {
      "sutra_id": "1.3.2",
      "source_key": "13002",
      "text": "उपदेशेऽजनुनासिक इत्"
    },
    {
      "sutra_id": "1.3.3",
      "source_key": "13003",
      "text": "हलन्त्यम्"
    },
    {
      "sutra_id": "1.3.7",
      "source_key": "13007",
      "text": "चुटू"
    },
    {
      "sutra_id": "1.3.9",
      "source_key": "13009",
      "text": "तस्य लोपः"
    },
    {
      "sutra_id": "1.3.13",
      "source_key": "13013",
      "text": "भावकर्मणोः"
    },
    {
      "sutra_id": "1.3.69",
      "source_key": "13069",
      "text": "गृधिवञ्च्योः प्रलम्भने"
    },
    {
      "sutra_id": "1.3.74",
      "source_key": "13074",
      "text": "णिचश्च"
    },
    {
      "sutra_id": "1.3.78",
      "source_key": "13078",
      "text": "शेषात् कर्तरि परस्मैपदम्"
    },
    {
      "sutra_id": "1.4.49",
      "source_key": "14049",
      "text": "कर्तुरीप्सिततमं कर्म"
    },
    {
      "sutra_id": "3.1.26",
      "source_key": "31026",
      "text": "हेतुमति च"
    },
    {
      "sutra_id": "3.1.32",
      "source_key": "31032",
      "text": "सनाद्यन्ता धातवः"
    },
    {
      "sutra_id": "3.1.55",
      "source_key": "31055",
      "text": "पुषादिद्युताद्यॢदितः परस्मैपदेषु"
    },
    {
      "sutra_id": "3.1.68",
      "source_key": "31068",
      "text": "कर्तरि शप्"
    },
    {
      "sutra_id": "3.1.87",
      "source_key": "31087",
      "text": "कर्मवत् कर्मणा तुल्यक्रियः"
    },
    {
      "sutra_id": "3.2.111",
      "source_key": "32111",
      "text": "अनद्यतने लङ्"
    },
    {
      "sutra_id": "3.2.123",
      "source_key": "32123",
      "text": "वर्तमाने लट्"
    },
    {
      "sutra_id": "3.3.13",
      "source_key": "33013",
      "text": "लृट् शेषे च"
    },
    {
      "sutra_id": "3.3.15",
      "source_key": "33015",
      "text": "अनद्यतने लुट्"
    },
    {
      "sutra_id": "3.3.139",
      "source_key": "33139",
      "text": "लिङ्निमित्ते लृङ् क्रियातिपत्तौ"
    },
    {
      "sutra_id": "3.3.140",
      "source_key": "33140",
      "text": "भूते च"
    },
    {
      "sutra_id": "3.3.147",
      "source_key": "33147",
      "text": "जातुयदोर्लिङ्"
    },
    {
      "sutra_id": "3.3.161",
      "source_key": "33161",
      "text": "विधिनिमन्त्रणामन्त्रणाधीष्टसंप्रश्नप्रार्थनेषु लिङ्"
    },
    {
      "sutra_id": "3.3.162",
      "source_key": "33162",
      "text": "लोट् च"
    },
    {
      "sutra_id": "3.3.173",
      "source_key": "33173",
      "text": "आशिषि लिङ्लोटौ"
    },
    {
      "sutra_id": "3.4.78",
      "source_key": "34078",
      "text": "तिप्तस्झिसिप्थस्थमिब्वस्मस् तातांझथासाथांध्वमिड्वहिमहिङ्"
    },
    {
      "sutra_id": "3.4.79",
      "source_key": "34079",
      "text": "टित आत्मनेपदानां टेरे"
    },
    {
      "sutra_id": "3.4.80",
      "source_key": "34080",
      "text": "थासस्से"
    },
    {
      "sutra_id": "3.4.85",
      "source_key": "34085",
      "text": "लोटो लङ्वत्"
    },
    {
      "sutra_id": "3.4.86",
      "source_key": "34086",
      "text": "एरुः"
    },
    {
      "sutra_id": "3.4.87",
      "source_key": "34087",
      "text": "सेर्ह्यपिच्च"
    },
    {
      "sutra_id": "3.4.89",
      "source_key": "34089",
      "text": "मेर्निः"
    },
    {
      "sutra_id": "3.4.90",
      "source_key": "34090",
      "text": "आमेतः"
    },
    {
      "sutra_id": "3.4.91",
      "source_key": "34091",
      "text": "सवाभ्यां वामौ"
    },
    {
      "sutra_id": "3.4.92",
      "source_key": "34092",
      "text": "आडुत्तमस्य पिच्च"
    },
    {
      "sutra_id": "3.4.93",
      "source_key": "34093",
      "text": "एत ऐ"
    },
    {
      "sutra_id": "3.4.94",
      "source_key": "34094",
      "text": "लेटोऽडाटौ"
    },
    {
      "sutra_id": "3.4.95",
      "source_key": "34095",
      "text": "आत ऐ"
    },
    {
      "sutra_id": "3.4.96",
      "source_key": "34096",
      "text": "वैतोऽन्यत्र"
    },
    {
      "sutra_id": "3.4.97",
      "source_key": "34097",
      "text": "इतश्च लोपः परस्मैपदेषु"
    },
    {
      "sutra_id": "3.4.98",
      "source_key": "34098",
      "text": "स उत्तमस्य"
    },
    {
      "sutra_id": "3.4.99",
      "source_key": "34099",
      "text": "नित्यं ङितः"
    },
    {
      "sutra_id": "3.4.100",
      "source_key": "34100",
      "text": "इतश्च"
    },
    {
      "sutra_id": "3.4.101",
      "source_key": "34101",
      "text": "तस्थस्थमिपां तांतंतामः"
    },
    {
      "sutra_id": "3.4.102",
      "source_key": "34102",
      "text": "लिङस्सीयुट्"
    },
    {
      "sutra_id": "3.4.103",
      "source_key": "34103",
      "text": "यासुट् परस्मैपदेषूदात्तो ङिच्च"
    },
    {
      "sutra_id": "3.4.104",
      "source_key": "34104",
      "text": "किदाशिषि"
    },
    {
      "sutra_id": "3.4.105",
      "source_key": "34105",
      "text": "झस्य रन्"
    },
    {
      "sutra_id": "3.4.106",
      "source_key": "34106",
      "text": "इटोऽत्"
    },
    {
      "sutra_id": "3.4.107",
      "source_key": "34107",
      "text": "सुट् तिथोः"
    },
    {
      "sutra_id": "3.4.108",
      "source_key": "34108",
      "text": "झेर्जुस्"
    },
    {
      "sutra_id": "3.4.113",
      "source_key": "34113",
      "text": "तिङ्शित्सार्वधातुकम्"
    },
    {
      "sutra_id": "3.4.114",
      "source_key": "34114",
      "text": "आर्धधातुकं शेषः"
    },
    {
      "sutra_id": "6.1.64",
      "source_key": "61064",
      "text": "धात्वादेः षः सः"
    },
    {
      "sutra_id": "6.1.78",
      "source_key": "61078",
      "text": "एचोऽयवायावः"
    },
    {
      "sutra_id": "6.1.87",
      "source_key": "61087",
      "text": "आद्गुणः"
    },
    {
      "sutra_id": "6.1.97",
      "source_key": "61097",
      "text": "अतो गुणे"
    },
    {
      "sutra_id": "6.1.101",
      "source_key": "61101",
      "text": "अकः सवर्णे दीर्घः"
    },
    {
      "sutra_id": "6.4.51",
      "source_key": "64051",
      "text": "णेरनिटि"
    },
    {
      "sutra_id": "6.4.62",
      "source_key": "64062",
      "text": "स्यसिच्सीयुट्तासिषु भावकर्मणोरुपदेशेऽज्झनग्रहदृशां वा चिण्वदिट् च"
    },
    {
      "sutra_id": "6.4.71",
      "source_key": "64071",
      "text": "लुङ्लङ्लृङ्क्ष्वडुदात्तः"
    },
    {
      "sutra_id": "6.4.105",
      "source_key": "64105",
      "text": "अतो हेः"
    },
    {
      "sutra_id": "7.1.3",
      "source_key": "71003",
      "text": "झोऽन्तः"
    },
    {
      "sutra_id": "7.1.5",
      "source_key": "71005",
      "text": "आत्मनेपदेष्वनतः"
    },
    {
      "sutra_id": "7.2.35",
      "source_key": "72035",
      "text": "आर्धधातुकस्येड् वलादेः"
    },
    {
      "sutra_id": "7.2.79",
      "source_key": "72079",
      "text": "लिङः सलोपोऽनन्त्यस्य"
    },
    {
      "sutra_id": "7.2.80",
      "source_key": "72080",
      "text": "अतो येयः"
    },
    {
      "sutra_id": "7.2.81",
      "source_key": "72081",
      "text": "आतो ङितः"
    },
    {
      "sutra_id": "7.2.82",
      "source_key": "72082",
      "text": "आने मुक्"
    },
    {
      "sutra_id": "7.2.115",
      "source_key": "72115",
      "text": "अचो ञ्णिति"
    },
    {
      "sutra_id": "7.2.116",
      "source_key": "72116",
      "text": "अत उपधायाः"
    },
    {
      "sutra_id": "7.3.84",
      "source_key": "73084",
      "text": "सार्वधातुकार्धधातुकयोः"
    },
    {
      "sutra_id": "7.3.86",
      "source_key": "73086",
      "text": "पुगन्तलघूपधस्य च"
    },
    {
      "sutra_id": "7.3.101",
      "source_key": "73101",
      "text": "अतो दीर्घो यञि"
    },
    {
      "sutra_id": "8.2.25",
      "source_key": "82025",
      "text": "धि च"
    },
    {
      "sutra_id": "8.2.29",
      "source_key": "82029",
      "text": "स्कोः संयोगाद्योरन्ते च"
    },
    {
      "sutra_id": "8.2.66",
      "source_key": "82066",
      "text": "ससजुषो रुः"
    },
    {
      "sutra_id": "8.3.15",
      "source_key": "83015",
      "text": "खरवसानयोर्विसर्जनीयः"
    },
    {
      "sutra_id": "8.3.59",
      "source_key": "83059",
      "text": "आदेशप्रत्यययोः"
    },
    {
      "sutra_id": "8.3.78",
      "source_key": "83078",
      "text": "इणः षीध्वंलुङ्लिटां धोऽङ्गात्"
    },
    {
      "sutra_id": "8.3.79",
      "source_key": "83079",
      "text": "विभाषेटः"
    },
    {
      "sutra_id": "8.4.37",
      "source_key": "84037",
      "text": "पदान्तस्य"
    },
    {
      "sutra_id": "8.4.40",
      "source_key": "84040",
      "text": "स्तोः श्चुना श्चुः"
    },
    {
      "sutra_id": "8.4.41",
      "source_key": "84041",
      "text": "ष्टुना ष्टुः"
    },
    {
      "sutra_id": "8.4.56",
      "source_key": "84056",
      "text": "वाऽवसाने"
    }
  ],
  "commentary_entries": [
    {
      "source": "kashika",
      "sutra_id": "1.3.69",
      "source_key": "13069",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG96_CONTROLLING_SENSE_LEXICAL_OR_INTERFACE_SOURCE",
      "text": "णेरिति वर्तते। अकर्त्रभिप्रायार्थोऽयमारम्भः। <<गृधु अभिकाङ्क्षायाम्>> (धा० पा० १२४७) , <<वञ्चु गतौ>> (धा० पा० १८९)  इत्येतयोर्ण्यन्तयोः प्रलम्भने वर्तमानयोरात्मनेपदं भवति। प्रलम्भनं विसंवादनं मिथ्याफलाख्यानम्। माणवकं गर्धयते। माणवकं वञ्चयते। प्रलम्भन इति किम्? श्वानं गर्धयति। गर्धनमस्योत्पादयतीत्यर्थः। अहिं वञ्चयति। परिहरतीत्यर्थः॥"
    },
    {
      "source": "kashika",
      "sutra_id": "1.3.74",
      "source_key": "13074",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG96_CONTROLLING_SENSE_LEXICAL_OR_INTERFACE_SOURCE",
      "text": "कर्त्रभिप्राये क्रियाफले इति वर्तते। णिजन्तादात्मनेपदं भवति कर्त्रभिप्राये क्रियाफले। कटं कारयते। ओदनं पाचयते। कर्त्रभिप्राय इत्येव — कटं कारयति परस्य॥"
    },
    {
      "source": "kashika",
      "sutra_id": "1.3.78",
      "source_key": "13078",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG96_CONTROLLING_SENSE_LEXICAL_OR_INTERFACE_SOURCE",
      "text": "पूर्वेण प्रकरणेनात्मनेपदनियमः कृतः, न परस्मैपदनियमः। तत् सर्वतः प्राप्नोति, तदर्थमिदमुच्यते। येभ्यो धातुभ्यो येन विशेषणेनात्मनेपदमुक्तं ततो यदन्यत् स शेषः। शेषात् कर्तरि परस्मैपदं भवति, शेषादेव नान्यस्मात्। <<अनुदात्तङित आत्मनेपदम्>> [[१.३.१२]] उक्तम् — आस्ते। शेते। ततोऽन्यत्र परस्मैपदं भवति — याति। वाति। <<नेर्विशः>> [[१.३.१७]] आत्मनेपदमुक्तम् — निविशते। ततोऽन्यत्र परस्मैपदम् — आविशति। प्रविशति। कर्तरीति किम्? पच्यते। गम्यते। कर्मकर्तरि कस्मात्परस्मैपदं न भवति — पच्यत ओदनः स्वयमेव? <<कर्तरि कर्मव्यतिहारे>> [[१.३.१४]] इति द्वितीयं कर्तृग्रहणमनुवर्तते। तेन कर्तैव यः कर्ता (म० भा० [[१.३.३८]]), तत्र परस्मैपदं भवति, कर्मकर्तरि न भवति॥"
    },
    {
      "source": "kashika",
      "sutra_id": "3.1.26",
      "source_key": "31026",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG96_CONTROLLING_SENSE_LEXICAL_OR_INTERFACE_SOURCE",
      "text": "हेतुः स्वतन्त्रस्य कर्तुः प्रयोजकः, तदीयो व्यापारः प्रेषणादिलक्षणो हेतुमान्, तस्मिन्नभिधेये धातोर्णिच् प्रत्ययो भवति। कटं कारयति। ओदनं पाचयति॥ तत्करोतीत्युपसंख्यानं सूत्रयतीत्याद्यर्थम्॥ सूत्रं करोति, सूत्रयति॥ आख्यानात् कृतस्तदाचष्ट इति णिच् कृल्लुक् प्रकृतिप्रत्यापत्तिः प्रकृतिवच्च कारकम्॥ आख्यानात् कृदन्ताण् णिज् वक्तव्यस्तदाचष्ट इत्येतस्मिन्नर्थे, कृल्लुक् , प्रकृतिप्रत्यापत्तिः, प्रकृतिवच्च कारकं भवति। कंसवधमाचष्टे, कंसं घातयति। बलिबन्धमाचष्टे, बलिं बन्धयति। राजागमनमाचष्टे, राजानमागमयति॥ आङ्लोपश्च कालात्यन्तसंयोगे मर्यादायाम्॥ आरात्रिविवासमाचष्टे, रात्रिं विवासयति॥ चित्रीकरणे प्रापि॥ उज्जयिन्याः प्रस्थितो माहिष्मत्यां सूर्योद्गमनं संभावयते, सूर्यमुद्गमयति॥ नक्षत्रयोगे ज्ञि॥ पुष्ययोगं जानाति, पुष्येण योजयति। मघाभिर्योजयति॥"
    },
    {
      "source": "kashika",
      "sutra_id": "3.1.32",
      "source_key": "31032",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG96_CONTROLLING_SENSE_LEXICAL_OR_INTERFACE_SOURCE",
      "text": "सन् आदिर्येषां ते सनादयः। सनादयोऽन्ते येषां ते सनाद्यन्ताः। सनाद्यन्ताः समुदाया धातुसंज्ञका भवन्ति। प्रत्ययग्रहणपरिभाषा एव पदसंज्ञायामन्तवचनेन लिङ्गेन प्रतिषिद्धा सती पुनरिहान्तवचनेन प्रतिप्रसूयते। चिकीर्षति। पुत्रीयति। पुत्रकाम्यति॥"
    },
    {
      "source": "kashika",
      "sutra_id": "3.1.68",
      "source_key": "31068",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG96_CONTROLLING_SENSE_LEXICAL_OR_INTERFACE_SOURCE",
      "text": "कर्तृवाचिनि सार्वधातुके परतो धातोः शप् प्रत्ययो भवति। पकारः स्वरार्थः, शकारः सार्वधातुकसंज्ञार्थः। भवति। पचति॥"
    },
    {
      "source": "kashika",
      "sutra_id": "6.4.51",
      "source_key": "64051",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG96_CONTROLLING_SENSE_LEXICAL_OR_INTERFACE_SOURCE",
      "text": "अनिडादावार्धधातुके णेर्लोपो भवति। इयङ्यण्गुणवृद्धिदीर्घाणामपवादः। अततक्षत्। अररक्षत्। आशिशत्। आटिटत्। कारणा। हारणा। कारकः। हारकः। कार्यते। हार्यते। ज्ञीप्सति। अनिटीति किम्? कारयिता। हारयिता॥"
    },
    {
      "source": "kashika",
      "sutra_id": "7.2.35",
      "source_key": "72035",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG96_CONTROLLING_SENSE_LEXICAL_OR_INTERFACE_SOURCE",
      "text": "छन्दसीति निवृत्तम्। आर्धधातुकस्य वलादेरिडागमो भवति। लविता। लवितुम्। लवितव्यम्। पविता। पवितुम्। पवितव्यम्। आर्धधातुकस्येति किम्? आस्ते। शेते। वस्ते। <<रुदादिभ्यः सार्वधातके>> [[७.२.७६]] इत्येतस्मिन् नियमार्थे विज्ञायमाने प्रतिपत्तिगौरवं भवतीति आर्धधातुक्रहणं क्रियते। वलादेरिति किम्? लव्यम्। पव्यम्। लवनीयम्। पवनीयम्। इडिति वर्तमाने पुनरिड्ग्रहणं प्रतिषेधनिवृत्त्यर्थम्॥"
    },
    {
      "source": "kashika",
      "sutra_id": "7.2.116",
      "source_key": "72116",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG96_CONTROLLING_SENSE_LEXICAL_OR_INTERFACE_SOURCE",
      "text": "अङ्गोपधाया अकारस्य स्थाने ञिति णिति च प्रत्यये वृद्धिर्भवति। पाकः। त्यागः। यागः। पाचयति। पाचकः। पाठयति। पाठकः। अत इति किम्? भेदयति। भेदकः। उपधाया इति किम्? चकासयति। तक्षकः॥"
    },
    {
      "source": "kashika",
      "sutra_id": "7.3.86",
      "source_key": "73086",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG96_CONTROLLING_SENSE_LEXICAL_OR_INTERFACE_SOURCE",
      "text": "पुगन्तस्याङ्गस्य लघूपधस्य च सार्वधातुकार्धधातुकयोर्गुणो भवति। पुगन्तस्य — व्लेपयति। ह्रेपयति। क्नोपयति। लघूपधस्य — भेदनम्। छेदनम्। भेत्ता। छेत्ता। प्रत्ययादेरङ्गावयवस्य च हलोरानन्तर्ये सति लघूपधगुणो न व्यावर्त्यत इति ज्ञापितमेतत् क्नुसनोः कित्करणेन, <<त्रसिगृधिधृषिक्षिपेः क्नुः>> [[३.२.१४०]],<<हलन्ताच्च>> [[१.२.१०]] इति।\n\nसंयोगे गुरुसंज्ञायां गुणो भेत्तुर्न सिध्यति।\n\nविध्यपेक्षं लघोश्चासौ कथं कुण्डिर्न दुष्यति ॥ १॥\n\nधातोर्नुमः कथं रञ्जेः स्यन्दिश्रन्थ्योर्निपातनात्।\n\nअनङ्लोपशिदीर्घत्वे विध्यपेक्षे न सिध्यतः ॥ २॥\n\nअभ्यस्तस्य यदाहाचि लङर्थं तत्कृतं भवेत्।\n\nक्नुसनोर्यत् कृतं कित्त्वं ज्ञापकं स्याल्लघोर्गुणे ॥ ३॥\n\nउपधा चात्र इगेव गृह्यते, ततो भिनत्तीति गुणो न भवति। अपरे पुकि अन्तः पुगन्तः, लघ्वी उपधा लघूपधा च पुगन्तश्च लघूपधा च पुगन्तलघूपधमिति सूत्रार्थं वर्णयन्ति॥"
    },
    {
      "source": "kashika",
      "sutra_id": "8.3.79",
      "source_key": "83079",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG96_CONTROLLING_SENSE_LEXICAL_OR_INTERFACE_SOURCE",
      "text": "इणः परस्मादिट उत्तरेषां षीध्वंलुङ्लिटां यो धकारस्तस्य मूर्धन्यादेशो भवति विभाषा। लविषीढ्वम्, लविषीध्वम्। पविषीढ्वम्, पविषीध्वम्। लुङ् — अलविढ्वम्, अलविध्वम्। लिट् — लुलुविढ्वे, लुलुविध्वे। इण इत्येव — आसिषीध्वम्। अथेह कथं भवितव्यम् — उपदिदीयिध्वे? केचिदाहुः — इणन्तादङ्गादुत्तरस्येट आनन्तर्यं युटा व्यवहितमिति न भवितव्यं ढत्वेनेति। अपरेषां दर्शनम् — अङ्गादिति निवृत्तम्, इण इत्यनुवर्तते, ततश्च यकारादेव इणः परोऽनन्तर इडिति पक्षे भवितव्यं मूर्धन्येनेति॥"
    },
    {
      "source": "kashika",
      "sutra_id": "8.4.40",
      "source_key": "84040",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG96_CONTROLLING_SENSE_LEXICAL_OR_INTERFACE_SOURCE",
      "text": "सकारतवर्गयोः शकारचवर्गाभ्यां सन्निपाते  शकारचवर्गावादेशौ भवतः। स्तोःश्चुनेति यथासंख्यमत्र नेष्यते। सकारस्य शकारेण चवर्गेण द्वाभ्यामपि संनिपाते शकारो भवति। तवर्गस्यापि च शकारेण चवर्गेण च संनिपाते चवर्गो भवति। आदेशे तु यथासंख्यमिष्यते। सकारस्य शकारः, तवर्गस्य च चवर्ग इति। सकारस्य शकारेण संनिपाते — वृक्षश्शेते। प्लक्षश्शेते तस्यैव चवर्गेण — वृक्षश्चिनोति। प्लक्षश्चिनोति। वृक्षश् छादयति।  प्लक्षश्छादयति। तवर्गस्य शकारेण — अग्निचिच्छेते। सोमसुच्छेते। तस्यैव चवर्गेण — अग्निचिच्चिनोति। सोमसुच्चिनोति। अग्निचिच्छादयति। सोमसुच्छादयति। अग्निचिज्जयति। सोमसुज्जयति। अग्निचिज्झकारः। सोमसुज्झकारः। अग्निचिञ्ञकारः। सोमसुञ्ञकारः। मस्जेः — मज्जति। भ्रस्जेः — भृज्जति। व्रस्चेः — वृश्चति। यजेः — यज्ञः। याचेः — याच्ञा। <<शात्>> [[८.४.४४]] इति प्रतिषेधो ज्ञापकः संख्यातानुदेशाभावस्य। स्तोः श्चाविति सप्तमीनिर्देशो न कृतः, पूर्वेण परेण च श्चुना संनिपाते श्चुत्वं यथा स्यादिति॥"
    },
