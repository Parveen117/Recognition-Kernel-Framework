  "source_policy_decisions": [
    {
      "id": "ACT",
      "sources": "K124,K125,MANU,G4",
      "decision": "Activity and own sense are distinct inputs. The creation verse exemplifies the latter on a different word from the theft example."
    },
    {
      "id": "CASE",
      "sources": "K126,R1,R4",
      "decision": "The formal homograph in the two halves of one verse receives two cases specifically under the commentator's supplied predicate. The friends in the dative are different participants."
    },
    {
      "id": "TRADE",
      "sources": "K126,K124",
      "decision": "Distinguish the two initial vowels and suffix paths of the trade terms. Kapi and jñāti under 127 do not force a distribution of senses by order."
    },
    {
      "id": "HOUSE",
      "sources": "K128,R10,HARA,GADA",
      "decision": "Keep PG736's dative profiles. A further commentator's alternative fire interpretation in a parallel ritual text is a source reading only."
    },
    {
      "id": "GOOD",
      "sources": "K129,R3,R6,GADA,HARA,R10",
      "decision": "Register the bare mantra dative, plural blessings and tva dative separately. Gadādhara's collective is a competing inner analysis. Keep one case on the wedding dative."
    },
    {
      "id": "AGE",
      "sources": "K129,K130,G2",
      "decision": "Childhood and youth are parallel in the poem despite different suffix markers. The final feminine term anchors the clause and receives no new age-derivation credit."
    }
  ]
}
