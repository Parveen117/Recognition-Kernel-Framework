  "kashika_fields": [
    {"rule":"3.1.35","field":"31035","selected_text":"प्रत्ययान्तेभ्यश्च धातुभ्य आम् प्रत्ययो भवति लिटि परतोऽमन्त्रविषये"},
    {"rule":"3.1.40","field":"31040","selected_text":"आम्प्रत्ययस्य पश्चात् कृञनुप्रयुज्यते लिटि परतः ... पाचयाञ्चकार। पाचयाम्बभूव। पाचयामास"},
    {"rule":"3.1.48","field":"31048","selected_text":"ण्यन्तेभ्यो धातुभ्यः ... परस्य च्लेश्चङादेशो भवति कर्तृवाचिनि लुङि परतः"},
    {"rule":"6.1.11","field":"61011","selected_text":"पचादीनां ण्यन्तानां चङि कृते णिलोप उपधाह्रस्वत्वं द्विर्वचनमित्येषां कार्याणां प्रवृत्तिक्रमः"},
    {"rule":"6.4.51","field":"64051","selected_text":"अनिडादावार्धधातुके णेर्लोपो भवति"},
    {"rule":"6.4.55","field":"64055","selected_text":"आम् ... परतो णेरयादेशो भवति। कारयांचकार। हारयांचकार"},
    {"rule":"7.4.1","field":"74001","selected_text":"चङ्परे णौ यदङ्गम्, तस्य उपधाया ह्रस्वो भवति"},
    {"rule":"7.4.93","field":"74093","selected_text":"लघुनि धात्वक्षरे परतो योऽभ्यासः तस्य चङ्परे णौ परतः सनीव कार्यं भवति अनग्लोपे"},
    {"rule":"7.4.94","field":"74094","selected_text":"दीर्घा भवति लघोः अभ्यासस्य लघुनि णौ चङ्परे अनग्लोपे"}
  ],
