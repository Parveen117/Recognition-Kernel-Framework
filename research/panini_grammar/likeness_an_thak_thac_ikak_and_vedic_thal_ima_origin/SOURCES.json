  "new_fields": [
    {
      "source": "kashika.txt",
      "field": "53107",
      "text": "शर्करा इत्येवमादिभ्यः प्रातिपदिकेभ्य इवार्थेऽण् प्रत्ययो भवति। शर्करेव शार्करम्। कापालिकम्॥ शर्करा। कपालिका। पिष्टिक। पुण्डरीक। शतपत्र। गोलोमन्। गोपुच्छ। नरालि। नकुला। सिकता। शर्करादिः॥"
    },
    {
      "source": "kashika.txt",
      "field": "53108",
      "text": "अङ्गुल्यादिभ्य इवार्थे ठक्  प्रत्ययो भवति। अङ्गुलीवाङ्गुलिकः। भारुजिकः॥ अङ्गुलि। भरुज। बभ्रु। वल्गु। मण्डर। मण्डल। शष्कुल। कपि। उदश्वित्। गोणी। उरस्। शिखर। कुलिश। अङ्गुल्यादिः॥"
    },
    {
      "source": "kashika.txt",
      "field": "53109",
      "text": "एकशालाशब्दादिवार्थेऽन्यतरस्यां ठच् प्रत्ययो भवति। अन्यतरस्यांग्रहणेनानन्तरष्ठक् प्राप्यते। एकशालेव एकशालिकः, ऐकशालिकः॥"
    },
    {
      "source": "kashika.txt",
      "field": "53110",
      "text": "कर्कलोहितशब्दाभ्यामिवार्थ ईकक्  प्रत्ययो भवति। कर्कः शुक्लोऽश्वः, तेन सदृशः कार्कीकः। लौहितीकः स्फटिकः। स्वयमलोहितोऽप्युपाश्रयवशात् तथा प्रतीयते॥"
    },
    {
      "source": "kashika.txt",
      "field": "53111",
      "text": "प्रत्न पूर्व विश्व इम इत्येतेभ्य इवार्थे थाल् प्रत्ययो भवति छन्दसि विषये। तं प्॒रत्नथा॑ पू॒र्वथा॑ वि॒श्वथे॒मथा॑ (ऋ० ५.४४.१)॥"
    },
    {
      "source": "kashika.txt",
      "field": "72118",
      "text": "किति च तद्धिते परतोऽङ्गस्याचामादेरचः स्थाने वृद्धिर्भवति। <<नडादिभ्यः फक्>> [[४.१.९९]] — नाडायनः। चारायणः। <<प्राग् वहतेष्ठक्>> [[४.४.१]] — आक्षिकः। शालाकिकः॥\n\n॥ इति श्रीवामनविरचितायां काशिकायां वृत्तौ सप्तमाध्यायस्य द्वितीयः पादः॥"
    },
    {
      "source": "kashika.txt",
      "field": "41045",
      "text": "बहु इत्येवमादिभ्यः प्रातिपदिकेभ्यः स्त्रियां वा ङीष् प्रत्ययो भवति। बह्वी, बहुः॥ बहु। पद्धति। अङ्कति। अञ्चति। अंहति। वंहति। शकटि। शक्तिः शस्त्रे (ग०सू० ४७)। शारि। वारि। गति। अहि। कपि। मुनि। यष्टि। इतः प्राण्यङ्गात् (ग०सू० ४८)। कृदिकारादक्तिनः। (ग०सू० ४९)। सर्वतोऽक्तिन्नर्थादित्येके (ग०सू०५०)। चण्ड। अराल। कमल। कृपाण। विकट। विशाल। विशङ्कट। भरुज। ध्वज। चन्द्रभागाद् नद्याम् (ग०सू० ५१)। कल्याण। उदार। पुराण। अहन्। बहुशब्दो गुणवचन एव। तस्येह पाठ उत्तरार्थः॥"
    },
    {
      "source": "kashika.txt",
      "field": "11038",
      "text": "तद्धितान्तः शब्दोऽसर्वविभक्तिरव्ययसंज्ञो भवति। यस्मान्न सर्वविभक्तेरुत्पत्तिः सोऽसर्वविभक्तिः। ततः। यतः। तत्र। यत्र। तदा। यदा। सर्वदा। सदा। तद्धितः इति किम्? एकः। द्वौ। बहवः। असर्वविभक्तिरिति किम्? औपगवः, औपगवौ, औपगवाः॥"
    },
    {
      "source": "kashika.txt",
      "field": "53023",
      "text": "<<किंसर्वनामबहुभ्योऽद्व्यादिभ्यः>> [[५.३.२]] इति वर्तते। सप्तम्या इति काल इति च निवृत्तम्। सामान्यस्य भेदको विशेषः प्रकारः। प्रकृत्यर्थविशेषणं चैतत्। प्रकारवृत्तिभ्यः किंसर्वनामबहुभ्यः स्वार्थे थाल् प्रत्ययो भवति। तेन प्रकारेण तथा। यथा। सर्वथा। जातीयरोऽपीदृशमेव लक्षणम्। स तु स्वभावात् प्रकारवति वर्तते, थाल् पुनः प्रकारमात्रे॥"
    },
    {
      "source": "kashika.txt",
      "field": "43091",
      "text": "सोऽस्याभिजन इति वर्तते। आयुधजीविभ्य इति तादर्थ्ये चतुर्थी, पर्वत इति प्रकृतिविशेषणम्। पर्वतवाचिनः प्रथमासमर्थादभिजनादस्येति षष्ठ्यर्थे छः प्रत्ययो भवति। आयुधजीविभ्य आयुधजीव्यर्थम् आयुधजीविनोऽभिधातुं प्रत्ययो भवतीत्यर्थः। हृद्गोलः पर्वतोऽभिजन एषामायुधजीविनां हृद्गोलीयाः। अन्धकवर्तीयाः। रोहितगिरीयाः। आयुध जीविभ्य इति किम् ? ऋक्षोदः पर्वतोऽभिजन एषां ब्राह्मणानाम्, आर्क्षोदा ब्राह्मणाः। पर्वत इति किम्? सांकाश्यका आयुधजीविनः॥"
    },
    {
      "source": "balamanorama.txt",
      "field": "53107",
      "text": "<<शर्कराऽऽदिभ्योऽण्>> - शर्करादिभ्योऽण् । इवे इत्येव । शार्करमिति ।स्वार्थिकाः प्रकृतितो लिङ्गवचनान्यतिवर्तन्ते॑ इति विशेष्यनिघ्नतेति भावः ।"
    },
    {
      "source": "balamanorama.txt",
      "field": "53108",
      "text": "<<अङ्गुल्यादिभ्यष्ठक्>> - अङ्गुल्यादिभ्यष्ठक् । इवे इत्येव । अङ्गुलीवेति । अङ्गुलिशब्दात् कृदिकारादक्तिनः॑ इति ङीष् । आङ्गुलिक इति । पूर्ववद्विशेष्यनिघ्नता । भारूजिक इति । पूर्ववद्विशेष्यनिघ्नता ।"
    },
    {
      "source": "balamanorama.txt",
      "field": "53109",
      "text": "<<एकशालायाष्ठजन्यतरस्याम्>> - एकशालायाः । पक्षे ठगिति । अन्यतरस्याङ्ग्रहणमनन्तरठ,कः समुच्चयार्थमिति भावः ।ठज्वे॑त्येव सुवचम् ।"
    },
    {
      "source": "balamanorama.txt",
      "field": "53110",
      "text": "<<कर्कलोहितादीकक्>> - कर्कलोहितादीकक् । कर्कः शुक्लोऽआ इति । अआउपर्यायेषु 'सितः कर्कः' इत्यमरः । लौहितीकः स्फटिक इति । जपापुष्पादिसम्पर्कवशाल्लोहित इवेत्यर्थः ।"
    },
    {
      "source": "nyaas_5744762.txt",
      "field": "53109",
      "text": "`अन्यतरस्यांग्रहणेन` इत्यादि। पूर्वसूत्रेण  [[5.3.108]]  विहितत्वाट्ठगेवानन्तरः। अन्यतरस्यांग्रहणं समुच्चयार्थम्। अतस्तेन `अनन्तरस्य विधिर्वा भवति प्रतिषेधो वा` (व्या।प।19) इति स एव प्राप्यते॥"
    },
    {
      "source": "nyaas_5744762.txt",
      "field": "53110",
      "text": "`इमथ` इति। इमेतीदमा समानार्थं प्रकृत्यन्तरमस्ति। तत इदं प्रत्ययविषानम्॥"
    },
    {
      "source": "kaumudi.txt",
      "field": "53108",
      "text": "अङ्गुलीव आङ्गुलिकः । भरुजेव भारुजिकः ॥"
    },
    {
      "source": "kaumudi.txt",
      "field": "53109",
      "text": "एकशालाशब्दादिवार्थे ठज्वा पक्षे ठक् । एकशालेव एकशालिकः । ऐकशालिकः ॥"
    },
    {
      "source": "kaumudi.txt",
      "field": "53111",
      "text": "इवार्थे । तं प्रत्नथा पूर्वथा विश्वथेमथा (तं प्र॒त्नथा॑ पूर्वथा॑ वि॒श्वथे॒मथा॑) ॥"
    }
  ],
