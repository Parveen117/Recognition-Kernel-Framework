  "source_policy_decisions":[
    {"id":"DHA_MANNER","status":"Accepted/Excluded","decision":"Accept numeral dhā only for the manner of an action; a bare numeral relation does not inherit it."},
    {"id":"DHA_REDISTRIBUTION","status":"Accepted","decision":"Keep change in the number/distribution of a substance distinct from manner even when the surface is ekadhā or pañcadhā."},
    {"id":"EKA_REPLACEMENT","status":"Accepted","decision":"Apply optional dhyamuñ in both inherited relations and retain dhā as the correlated alternative."},
    {"id":"DVI_TRI_DHAMUN","status":"Accepted","decision":"Own dhamuñ separately from dhā and keep the further ḍa vārttika limited to its displayed mati compounds."},
    {"id":"DVI_TRI_EDHAC","status":"Accepted","decision":"Keep edhāc outputs distinct from both dhā and dhamuñ histories while preserving all three alternatives."},
    {"id":"CENSURED_QUALITY","status":"Accepted/Excluded","decision":"License pāśap only when the designation-conferring expertise is censured; unrelated bad character is excluded."},
    {"id":"TIIYA_PART","status":"Accepted","decision":"Construct a part relation and accent history, not a duplicate ordinal-completion reading."},
    {"id":"PART_RANGE_REGISTER","status":"Accepted/Excluded/Open","decision":"Apply non-Vedic an below eleven; keep eleven and higher outside this rule and exact Vedic accent comparison Open."},
    {"id":"SIXTH_EIGHTH_ALTERNATIVES","status":"Accepted","decision":"Retain ñ and an as correlated part alternatives with independent accent histories."},
    {"id":"SPECIAL_PART_DOMAINS","status":"Accepted/Excluded","decision":"Restrict kan to a sixth of a measure and affix-luk to an eighth animal body-part; do not transfer them to generic fractions."},
    {"id":"SOLITARY_EKA","status":"Accepted/Excluded","decision":"Treat eka as nonnumeral solitary and preserve singular, dual and plural ākini plus kan/lopa alternatives; exclude mere cardinal one."},
    {"id":"FORMER_STATE","status":"Accepted","decision":"Attach caraṭ to a base qualified by former state and retain its explicit feminine owner."},
    {"id":"FORMER_POSSESSION","status":"Accepted","decision":"Use a genitive possessor as input and keep rūpya/caraṭ alternatives distinct from rule-53 former-state qualification."}
  ]
}
