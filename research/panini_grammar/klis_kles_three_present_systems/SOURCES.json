{
  "edition": "5744762f010d677cfb43f347a42d02796cf615d6",
  "fields": [
    {
      "work": "kashika",
      "rule": "1.4.49",
      "field": "14049",
      "text": "कर्तुः क्रियया यदाप्तुमिष्टतमम्, तत् कारकं कर्मसंज्ञं भवति। कटं करोति। ग्रामं गच्छति। कर्तुरिति किम्? माषेष्वश्वं बध्नाति। कर्मण ईप्सिता माषा न कर्तुः। तमब्ग्रहणं किम्? पयसौदनं भुङ्क्ते। कर्मेत्यनुवर्तमाने पुनः कर्मग्रहणमाधारनिवृत्त्यर्थम्। इतरथाधारस्यैव हि स्यात्। गेहं प्रविशतीति। ओदनं पचति सक्तून् पिबतीत्यादिषु न स्यात्। पुनः कर्मग्रहणात् सर्वत्र सिद्धं भवति। कर्मप्रेदशाः — <<कर्मणि द्वितीया>> [[२.३.२]] इत्येवमादयः॥"
    },
    {
      "work": "kashika",
      "rule": "2.3.2",
      "field": "23002",
      "text": "द्वितीयादयः शब्दाः पूर्वाचार्यैः सुपां त्रिकेषु स्मर्यन्ते, तैरेवात्र व्यवहारः। कर्मणि कारके या संख्या तत्र द्वितीया विभक्तिर्भवति। कटं करोति। ग्रामं गच्छति।\n\nउभसर्वतसोः कार्या धिगुपर्यादिषु त्रिषु।\n\nद्वितीयाम्रेडितान्तेषु ततोन्यत्रापि दृश्यते॥\n\nउभयतो ग्रामम्। सर्वतो ग्रामम्। धिग् देवदत्तम्। उपर्युपरि ग्रामम्। अध्यधि ग्रामम्। अधोऽधो ग्रामम्॥ अभितः परितः समयानिकषाहाप्रतियोगेषु च दृश्यते॥ अभितो ग्रामम्। परितो ग्रामम्। समया ग्रामम्। निकषा ग्रामम्। हा देवदत्तम्। बुभुक्षितं न प्रति भाति किञ्चित्॥"
    },
    {
      "work": "kashika",
      "rule": "3.1.68",
      "field": "31068",
      "text": "कर्तृवाचिनि सार्वधातुके परतो धातोः शप् प्रत्ययो भवति। पकारः स्वरार्थः, शकारः सार्वधातुकसंज्ञार्थः। भवति। पचति॥"
    },
    {
      "work": "kashika",
      "rule": "3.1.69",
      "field": "31069",
      "text": "दिव् इत्येवमादिभ्यो धातुभ्यः श्यन् प्रत्ययो भवति। शपोऽपवादः। नकारः स्वरार्थः, शकारः सार्वधातुकार्थः। दीव्यति। सीव्यति॥"
    },
    {
      "work": "kashika",
      "rule": "3.1.81",
      "field": "31081",
      "text": "<<डुक्रीञ् द्रव्यविनिमये>> इत्येवमादिभ्यो धातुभ्यः श्नाप्रत्ययो भवति। शपोऽपवादः। शकारः सार्वधातुकसंज्ञार्थः। क्रीणाति। प्रीणाति॥"
    },
    {
      "work": "kashika",
      "rule": "3.1.83",
      "field": "31083",
      "text": "हल उत्तरस्य श्नाप्रत्ययस्य शानजादेशो भवति हौ परतः। मुषाण। पुषाण। हल इति किम्? क्रीणीहि। हाविति किम्? मुष्णाति। श्न इति स्थानिनिर्देश आदेशसंप्रत्ययार्थः। इतरथा हि प्रत्ययान्तरमेव सर्वविषयं विज्ञायेत॥"
    },
    {
      "work": "kashika",
      "rule": "6.4.112",
      "field": "64112",
      "text": "श्ना इत्येतस्याभ्यस्तानां चाङ्गानामाकारस्य लोपो भवति सार्वधातुके क्ङिति परतः। लुनते । लुनताम् ।अलुनत। अभ्यस्तानाम् — मिमते। मिमताम्। अमिमत। संजिहते। संजिहताम्। समजिहत। श्नाभ्यस्तयोरिति किम्? यान्ति। वान्ति। आत इति किम् ? बिभ्रति। क्ङितीत्येव — अलुनात्। अजहात्। आद्ग्रहणं स्पष्टार्थम्॥"
    },
    {
      "work": "kashika",
      "rule": "6.4.113",
      "field": "64113",
      "text": "श्नान्तानामङ्गानामभ्यस्तानां च घुवर्जितानामात ईकारादेशो भवति इलादौ सार्वधातुके क्ङिति परतः। लुनीतः। पुनीतः। लुनीथः। पुनीथः। लुनीते। पुनीते। अभ्यस्तानाम् — मिमीते। मिमीषे। मिमीध्वे। संजिहीते। संजिहीषे। संजिहीध्वे। हलीति किम्? लुनन्ति। मिमते। अघोरिति किम्? दत्तः। धत्तः। क्ङितीत्येव — लुनाति। जहाति॥"
    },
    {
      "work": "kashika",
      "rule": "7.1.35",
      "field": "71035",
      "text": "तु हि इत्येतयोराशिषि विषये तातङादेशो भवत्यन्यतरस्याम्। जीवताद् भवान्। जीवतात् त्वम्। जीवतु भवान्। जीव त्वम्। ङित्करणं गुणवृद्धिप्रतिषेधार्थमिति सर्वादेशस्तातङ् भवति। ङित्त्वात् चास्य स्थानिवद्भावाद् यत् पित्त्वं प्राप्नोति तद् निवर्तते। ङित् च पिद् न भवति। तेन  <<ब्रुव ईट्>> [[७.३.९३]] इति ब्रूताद् भवानितीड् न भवति। आशिषीति किम् ? ग्रामं गच्छतु भवान्। गच्छ त्वम्॥\n\nतातङि ङित्त्वं संक्रमकृत् स्यादन्त्यविधिश्चेत् तच्च तथा न।\n\nहेरधिकारे हेरधिकारो लोपविधौ तु ज्ञापकमाह ॥ १॥\n\nतातङो ङित्त्वसामर्थ्याद् नायमन्त्यविधिः स्मृतः।\n\nन तद्वदनङादीनां तेन तेऽन्त्यविकारजाः ॥२॥"
    },
    {
      "work": "kashika",
      "rule": "8.4.44",
      "field": "84044",
      "text": "तोरिति वर्तते। शकारादुत्तरस्य तवर्गस्य यदुक्तं तद् न भवति। प्रश्नः। विश्नः॥"
    }
  ],
