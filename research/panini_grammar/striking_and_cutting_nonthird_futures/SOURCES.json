{
  "edition": "5744762f010d677cfb43f347a42d02796cf615d6",
  "fields": [
    {
      "work": "kashika",
      "rule": "2.4.85",
      "field": "24085",
      "text": "लुडादेशस्य प्रथमपुरुषस्य परस्मैपदस्यात्मनेपदस्य च यथाक्रमं डा रौ रस् इत्येत आदेशा भवन्ति। कर्ता, कर्तारौ, कर्तारः। आत्मनेपदस्य — अध्येता, अध्येतारौ, अध्येतारः। प्रथमस्येति किम्? श्वः कर्तासि। श्वोऽध्येतासे॥\n\n॥ इति श्रीजयादित्यविरचितायां काशिकायां वृत्तौ द्वितीयाध्यायस्य चतुर्थः पादः॥"
    },
    {
      "work": "kashika",
      "rule": "3.1.33",
      "field": "31033",
      "text": "लृरूपमुत्सृष्टानुबन्धं सामान्यमेकमेव, तस्मिन् लुटि च परतो धातोर्यथासंख्यं स्यतासी प्रत्ययौ भवतः। करिष्यति। अकरिष्यत्। श्वः कर्ता। इदित्करणमनुनासिकलोपप्रतिबन्धार्थम्। मन्ता। संगन्ता॥"
    },
    {
      "work": "kashika",
      "rule": "3.4.78",
      "field": "34078",
      "text": "लस्य तिबादय आदेशा भवन्ति। तिप्सिप्मिपां पकारः स्वरार्थः। इटष्टकार <<इटोऽत्>>[[३.४.१०६]] इति विशेषणार्थः, तिबादिभिरादेशैस्तुल्यत्वाद् न देशविध्यर्थः। महिङो ङकारस्तिङ् इति प्रत्याहारग्रहणार्थः। पचति, पचतः, पचन्ति। पचसि, पचथः, पचथ। पचामि, पचावः, पचामः। पचते, पचेते, पचन्ते। पचसे, पचेथे, पचध्वे। पचे, पचावहे, पचामहे। एवमन्येष्वपि लकारेषूदाहार्यम्॥"
    },
    {
      "work": "kashika",
      "rule": "3.4.99",
      "field": "34099",
      "text": "लेट इति, निवृत्तम्। ङितो लकारस्य य उत्तमः, तस्य नित्यं सकारस्य लोपो भवति। अपचाव। अपचाम। नित्यग्रहणं विकल्पनिवृत्त्यर्थम्॥"
    },
    {
      "work": "kashika",
      "rule": "3.4.100",
      "field": "34100",
      "text": "ङितो इत्येव। ङिल्लकारसंबन्धिन इकारस्य नित्यं लोपो भवति। अपचत्। अपाक्षीत्। परस्मैपदेष्वित्येव — अपचावहि। अपचामहि॥"
    },
    {
      "work": "kashika",
      "rule": "3.4.101",
      "field": "34101",
      "text": "ङित इत्येव। ङिल्लकारसंबन्धिनां चतुर्णां यथासंख्यं तामादय आदेशा भवन्ति। अपचताम्। अपचतम्। अपचत। अपचम्। अपाक्ताम्। अपाक्तम्। अपाक्त। अपाक्षम्॥"
    }
  ],
