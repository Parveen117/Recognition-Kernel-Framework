  "kashika":{
    "rule_1_3_76":{"field":"13076","text":"कर्त्रभिप्राय इति वर्तते। अनुपसर्गाज्जानातेः कर्त्रभिप्राये क्रियाफले आत्मनेपदं भवति। गां जानीते। अश्वं जानीते। अनुपसर्गादिति किम्? स्वर्गंलोकं न प्रजानाति मूढः। कर्त्रभिप्राय इत्येव — देवदत्तस्य गां जानाति॥"},
    "rule_1_3_78":{"field":"13078","selected_text":"शेषात् कर्तरि परस्मैपदं भवति, शेषादेव नान्यस्मात्"}
