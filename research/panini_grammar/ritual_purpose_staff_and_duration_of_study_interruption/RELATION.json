  "source_policy_decisions": [
    {
      "id": "ORDER",
      "sources": "K109,K110,KUM,NY,BV,MAG",
      "decision": "Respect the two ordered pairs. The Nyāsa admits both the preparation and the stirring implement in the first pair. Count the attested compound separately from its inner member."
    },
    {
      "id": "FOOD",
      "sources": "K111,ASV,GOB,GOB2",
      "decision": "A ritual request and the name of the oblations license distinct cases. The rite itself and its associated foods keep different referents and editorial numbering."
    },
    {
      "id": "BEN",
      "sources": "K111,MAN2",
      "decision": "Purpose is licensed in the grammar. Medhātithi supplies a benefit and desired-result reading, with no independent marker decision for the verse."
    },
    {
      "id": "LIMIT",
      "sources": "K111,K112,K113",
      "decision": "Carry deletion and controller history through the readout. Mere existence of a prior segment or a single house as an aim is insufficient for the two later prescriptions."
    },
    {
      "id": "TIME",
      "sources": "K114,MAN4,DEV,GOB2,SPRING,BV",
      "decision": "The flash and its consequence for study have different durations even in the same meteorological setting. Preserve the scope of ṭhañ ending at 114."
    }
  ]
