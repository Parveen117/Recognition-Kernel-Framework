  "source_policy_decisions":[
    {"id":"ASTATI_DOMAIN","status":"Accepted/Excluded","decision":"Accept primitive direction words under direction/place/time and three case-contexts; exclude derivative directions, accusative government and non-directional former-person readings."},
    {"id":"ATASUC_SOUTH_NORTH","status":"Accepted/Excluded","decision":"Accept atasuc as the rule-28 astāti blocker; exclude a temporal reading for dakṣiṇa while retaining direction/place."},
    {"id":"PARA_AVARA_OPTION","status":"Accepted/Open","decision":"Keep atasuc and astāti alternatives; preserve Kāśikā avastāt and Vasu avarastāt separately while their rule-29 priority remains Open."},
    {"id":"ANC_DOUBLE_LOPA","status":"Accepted","decision":"Own both astāti luk and the consequent feminine-suffix lopa under 1.2.49."},
    {"id":"UPARI_NIPATANA","status":"Accepted","decision":"Retain ūrdhva-to-upa substitution and distinct ril/riṣṭātil histories."},
    {"id":"PASCAT_FAMILY","status":"Accepted","decision":"Own apara-to-paśc substitution, āti and the five displayed compound extensions without generalizing the roster."},
    {"id":"VEDIC_PASCA","status":"Accepted/Open","decision":"Credit paśca and paścā and extend paścāt as Vedic; wider attestations and accent remain Open."},
    {"id":"ATI_TRIAD","status":"Accepted","decision":"Apply āti independently across three bases and three contexts; no yathāsaṃkhya pairing is imposed."},
    {"id":"ENAP_SCOPE","status":"Accepted/Open/Excluded","decision":"Accept near non-ablative enap; exclude ablative and distant uses; retain pūrveṇa/apareṇa as a source-labelled wider-school fork pending priority."},
    {"id":"DAKSINA_A","status":"Accepted/Excluded","decision":"Accept non-ablative dakṣiṇā without inheriting the near guard; exclude the ablative context."},
    {"id":"DISTANT_SOUTH","status":"Accepted/Excluded","decision":"Accept distant dakṣiṇāhi and the repeated dakṣiṇā history; exclude non-distant and ablative use from this rule."},
    {"id":"DISTANT_NORTH","status":"Accepted/Excluded","decision":"Accept distant uttarā/uttarāhi in non-ablative contexts; retain uttareṇa and uttarāt under their own guards."},
    {"id":"ASI_SUBSTITUTIONS","status":"Accepted","decision":"Keep pur/adh/av substitutions, asi ownership and all three contexts explicit."},
    {"id":"ASTATI_SUBSTITUTIONS","status":"Accepted/Open","decision":"Attach rule-40 histories to prior surfaces and retain rule-41 av/avara option; source priority at rule 29 remains Open rather than converted to exclusion."}
  ]
}
