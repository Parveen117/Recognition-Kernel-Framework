{
  "schema": "rkf.panini.pg110.sources.v1",
  "author": "Monty",
  "date": "2026-11-10",
  "primary_edition": {
    "repository": "ashtadhyayi-com/data",
    "commit": "5744762f010d677cfb43f347a42d02796cf615d6"
  },
  "policy": "Literal fields with explicit dossier and electronic-error boundaries; no generated paradigms as authority.",
  "sutra_texts": [
    {
      "sutra_id": "1.1.5",
      "source_key": "11005",
      "text": "क्ङिति च"
    },
    {
      "sutra_id": "1.1.46",
      "source_key": "11046",
      "text": "आद्यन्तौ टकितौ"
    },
    {
      "sutra_id": "1.1.47",
      "source_key": "11047",
      "text": "मिदचोऽन्त्यात्परः"
    },
    {
      "sutra_id": "1.1.50",
      "source_key": "11050",
      "text": "स्थानेऽन्तरतमः"
    },
    {
      "sutra_id": "1.1.52",
      "source_key": "11052",
      "text": "अलोऽन्त्यस्य"
    },
    {
      "sutra_id": "1.1.56",
      "source_key": "11056",
      "text": "स्थानिवदादेशोऽनल्विधौ"
    },
    {
      "sutra_id": "1.1.57",
      "source_key": "11057",
      "text": "अचः परस्मिन् पूर्वविधौ"
    },
    {
      "sutra_id": "1.1.58",
      "source_key": "11058",
      "text": "न पदान्तद्विर्वचनवरेयलोपस्वरसवर्णानुस्वारदीर्घजश्चर्विधिषु"
    },
    {
      "sutra_id": "1.2.4",
      "source_key": "12004",
      "text": "सार्वधातुकमपित्"
    },
    {
      "sutra_id": "1.2.5",
      "source_key": "12005",
      "text": "असंयोगाल्लिट् कित्"
    },
    {
      "sutra_id": "1.2.11",
      "source_key": "12011",
      "text": "लिङ्सिचावात्मनेपदेषु"
    },
    {
      "sutra_id": "1.2.41",
      "source_key": "12041",
      "text": "अपृक्त एकाल् प्रत्ययः"
    },
    {
      "sutra_id": "1.3.2",
      "source_key": "13002",
      "text": "उपदेशेऽजनुनासिक इत्"
    },
    {
      "sutra_id": "1.3.3",
      "source_key": "13003",
      "text": "हलन्त्यम्"
    },
    {
      "sutra_id": "1.3.4",
      "source_key": "13004",
      "text": "न विभक्तौ तुस्माः"
    },
    {
      "sutra_id": "1.3.5",
      "source_key": "13005",
      "text": "आदिर्ञिटुडवः"
    },
    {
      "sutra_id": "1.3.7",
      "source_key": "13007",
      "text": "चुटू"
    },
    {
      "sutra_id": "1.3.8",
      "source_key": "13008",
      "text": "लशक्वतद्धिते"
    },
    {
      "sutra_id": "1.3.9",
      "source_key": "13009",
      "text": "तस्य लोपः"
    },
    {
      "sutra_id": "1.3.13",
      "source_key": "13013",
      "text": "भावकर्मणोः"
    },
    {
      "sutra_id": "1.3.14",
      "source_key": "13014",
      "text": "कर्तरि कर्मव्यतिहारे"
    },
    {
      "sutra_id": "1.3.17",
      "source_key": "13017",
      "text": "नेर्विशः"
    },
    {
      "sutra_id": "1.3.32",
      "source_key": "13032",
      "text": "गन्धनावक्षेपणसेवनसाहसिक्यप्रतियत्नप्रकथनोपयोगेषु कृञः"
    },
    {
      "sutra_id": "1.3.72",
      "source_key": "13072",
      "text": "स्वरितञितः कर्त्रभिप्राये क्रियाफले"
    },
    {
      "sutra_id": "1.3.77",
      "source_key": "13077",
      "text": "विभाषोपपदेन प्रतीयमाने"
    },
    {
      "sutra_id": "1.3.78",
      "source_key": "13078",
      "text": "शेषात् कर्तरि परस्मैपदम्"
    },
    {
      "sutra_id": "1.3.79",
      "source_key": "13079",
      "text": "अनुपराभ्यां कृञः"
    },
    {
      "sutra_id": "1.3.80",
      "source_key": "13080",
      "text": "अभिप्रत्यतिभ्यः क्षिपः"
    },
    {
      "sutra_id": "1.3.81",
      "source_key": "13081",
      "text": "प्राद्वहः"
    },
    {
      "sutra_id": "1.4.49",
      "source_key": "14049",
      "text": "कर्तुरीप्सिततमं कर्म"
    },
    {
      "sutra_id": "1.4.54",
      "source_key": "14054",
      "text": "स्वतन्त्रः कर्ता"
    },
    {
      "sutra_id": "1.4.58",
      "source_key": "14058",
      "text": "प्रादयः"
    },
    {
      "sutra_id": "1.4.59",
      "source_key": "14059",
      "text": "उपसर्गाः क्रियायोगे"
    },
    {
      "sutra_id": "1.4.60",
      "source_key": "14060",
      "text": "गतिश्च"
    },
    {
      "sutra_id": "1.4.80",
      "source_key": "14080",
      "text": "ते प्राग्धातोः"
    },
    {
      "sutra_id": "1.4.81",
      "source_key": "14081",
      "text": "छन्दसि परेऽपि"
    },
    {
      "sutra_id": "1.4.82",
      "source_key": "14082",
      "text": "व्यवहिताश्च"
    },
    {
      "sutra_id": "1.4.101",
      "source_key": "14101",
      "text": "तिङस्त्रीणि त्रीणि प्रथममध्यमोत्तमाः"
    },
    {
      "sutra_id": "1.4.102",
      "source_key": "14102",
      "text": "तान्येकवचनद्विवचनबहुवचनान्येकशः"
    },
    {
      "sutra_id": "1.4.104",
      "source_key": "14104",
      "text": "विभक्तिश्च"
    },
    {
      "sutra_id": "1.4.105",
      "source_key": "14105",
      "text": "युष्मद्युपपदे समानाधिकरणे स्थानिन्यपि मध्यमः"
    },
    {
      "sutra_id": "1.4.107",
      "source_key": "14107",
      "text": "अस्मद्युत्तमः"
    },
    {
      "sutra_id": "1.4.108",
      "source_key": "14108",
      "text": "शेषे प्रथमः"
    },
    {
      "sutra_id": "2.4.77",
      "source_key": "24077",
      "text": "गातिस्थाघुपाभूभ्यः सिचः परस्मैपदेषु"
    },
    {
      "sutra_id": "2.4.78",
      "source_key": "24078",
      "text": "विभाषा घ्राधेट्शाच्छासः"
    },
    {
      "sutra_id": "2.4.79",
      "source_key": "24079",
      "text": "तनादिभ्यस्तथासोः"
    },
    {
      "sutra_id": "2.4.85",
      "source_key": "24085",
      "text": "लुटः प्रथमस्य डारौरसः"
    },
    {
      "sutra_id": "3.1.33",
      "source_key": "31033",
      "text": "स्यतासी लृलुटोः"
    },
    {
      "sutra_id": "3.1.43",
      "source_key": "31043",
      "text": "च्लि लुङि"
    },
    {
      "sutra_id": "3.1.44",
      "source_key": "31044",
      "text": "च्लेः सिच्"
    },
    {
      "sutra_id": "3.1.45",
      "source_key": "31045",
      "text": "शल इगुपधादनिटः क्सः"
    },
    {
      "sutra_id": "3.1.46",
      "source_key": "31046",
      "text": "श्लिष आलिङ्गने"
    },
    {
      "sutra_id": "3.1.47",
      "source_key": "31047",
      "text": "न दृशः"
    },
    {
      "sutra_id": "3.1.48",
      "source_key": "31048",
      "text": "णिश्रिद्रुस्रुभ्यः कर्तरि चङ्"
    },
    {
      "sutra_id": "3.1.49",
      "source_key": "31049",
      "text": "विभाषा धेट्श्व्योः"
    },
    {
      "sutra_id": "3.1.50",
      "source_key": "31050",
      "text": "गुपेश्छन्दसि"
    },
    {
      "sutra_id": "3.1.51",
      "source_key": "31051",
      "text": "नोनयतिध्वनयत्येलयत्यर्दयतिभ्यः"
    },
    {
      "sutra_id": "3.1.52",
      "source_key": "31052",
      "text": "अस्यतिवक्तिख्यातिभ्योऽङ्"
    },
    {
      "sutra_id": "3.1.53",
      "source_key": "31053",
      "text": "लिपिसिचिह्वश्च"
    },
    {
      "sutra_id": "3.1.54",
      "source_key": "31054",
      "text": "आत्मनेपदेष्वन्यतरस्याम्"
    },
    {
      "sutra_id": "3.1.55",
      "source_key": "31055",
      "text": "पुषादिद्युताद्यॢदितः परस्मैपदेषु"
    },
    {
      "sutra_id": "3.1.56",
      "source_key": "31056",
      "text": "सर्त्तिशास्त्यर्तिभ्यश्च"
    },
    {
      "sutra_id": "3.1.57",
      "source_key": "31057",
      "text": "इरितो वा"
    },
    {
      "sutra_id": "3.1.58",
      "source_key": "31058",
      "text": "जॄस्तम्भुम्रुचुम्लुचुग्रुचुग्लुचुग्लुञ्चुश्विभ्यश्च"
    },
    {
      "sutra_id": "3.1.59",
      "source_key": "31059",
      "text": "कृमृदृरुहिभ्यश्छन्दसि"
    },
    {
      "sutra_id": "3.1.60",
      "source_key": "31060",
      "text": "चिण् ते पदः"
    },
    {
      "sutra_id": "3.1.61",
      "source_key": "31061",
      "text": "दीपजनबुधपूरितायिप्यायिभ्योऽन्यतरस्याम्"
    },
    {
      "sutra_id": "3.1.62",
      "source_key": "31062",
      "text": "अचः कर्मकर्तरि"
    },
    {
      "sutra_id": "3.1.63",
      "source_key": "31063",
      "text": "दुहश्च"
    },
    {
      "sutra_id": "3.1.64",
      "source_key": "31064",
      "text": "न रुधः"
    },
    {
      "sutra_id": "3.1.65",
      "source_key": "31065",
      "text": "तपोऽनुतापे च"
    },
    {
      "sutra_id": "3.1.66",
      "source_key": "31066",
      "text": "चिण् भावकर्मणोः"
    },
    {
      "sutra_id": "3.1.68",
      "source_key": "31068",
      "text": "कर्तरि शप्"
    },
    {
      "sutra_id": "3.1.73",
      "source_key": "31073",
      "text": "स्वादिभ्यः श्नुः"
    },
    {
      "sutra_id": "3.1.77",
      "source_key": "31077",
      "text": "तुदादिभ्यः शः"
    },
    {
      "sutra_id": "3.1.78",
      "source_key": "31078",
      "text": "रुधादिभ्यः श्नम्"
    },
    {
      "sutra_id": "3.1.79",
      "source_key": "31079",
      "text": "तनादिकृञ्भ्य उः"
    },
    {
      "sutra_id": "3.1.87",
      "source_key": "31087",
      "text": "कर्मवत् कर्मणा तुल्यक्रियः"
    },
    {
      "sutra_id": "3.2.110",
      "source_key": "32110",
      "text": "लुङ्"
    },
    {
      "sutra_id": "3.2.111",
      "source_key": "32111",
      "text": "अनद्यतने लङ्"
    },
    {
      "sutra_id": "3.2.115",
      "source_key": "32115",
      "text": "परोक्षे लिट्"
    },
    {
      "sutra_id": "3.2.123",
      "source_key": "32123",
      "text": "वर्तमाने लट्"
    },
    {
      "sutra_id": "3.3.13",
      "source_key": "33013",
      "text": "लृट् शेषे च"
    },
    {
      "sutra_id": "3.3.15",
      "source_key": "33015",
      "text": "अनद्यतने लुट्"
    },
    {
      "sutra_id": "3.3.139",
      "source_key": "33139",
      "text": "लिङ्निमित्ते लृङ् क्रियातिपत्तौ"
    },
    {
      "sutra_id": "3.3.147",
      "source_key": "33147",
      "text": "जातुयदोर्लिङ्"
    },
    {
      "sutra_id": "3.3.161",
      "source_key": "33161",
      "text": "विधिनिमन्त्रणामन्त्रणाधीष्टसंप्रश्नप्रार्थनेषु लिङ्"
    },
    {
      "sutra_id": "3.3.162",
      "source_key": "33162",
      "text": "लोट् च"
    },
    {
      "sutra_id": "3.3.173",
      "source_key": "33173",
      "text": "आशिषि लिङ्लोटौ"
    },
    {
      "sutra_id": "3.4.69",
      "source_key": "34069",
      "text": "लः कर्मणि च भावे चाकर्मकेभ्यः"
    },
    {
      "sutra_id": "3.4.77",
      "source_key": "34077",
      "text": "लस्य"
    },
    {
      "sutra_id": "3.4.78",
      "source_key": "34078",
      "text": "तिप्तस्झिसिप्थस्थमिब्वस्मस् तातांझथासाथांध्वमिड्वहिमहिङ्"
    },
    {
      "sutra_id": "3.4.79",
      "source_key": "34079",
      "text": "टित आत्मनेपदानां टेरे"
    },
    {
      "sutra_id": "3.4.80",
      "source_key": "34080",
      "text": "थासस्से"
    },
    {
      "sutra_id": "3.4.81",
      "source_key": "34081",
      "text": "लिटस्तझयोरेशिरेच्"
    },
    {
      "sutra_id": "3.4.82",
      "source_key": "34082",
      "text": "परस्मैपदानां णलतुसुस्थलथुसणल्वमाः"
    },
    {
      "sutra_id": "3.4.83",
      "source_key": "34083",
      "text": "विदो लटो वा"
    },
    {
      "sutra_id": "3.4.84",
      "source_key": "34084",
      "text": "ब्रुवः पञ्चानामादित आहो ब्रुवः"
    },
    {
      "sutra_id": "3.4.85",
      "source_key": "34085",
      "text": "लोटो लङ्वत्"
    },
    {
      "sutra_id": "3.4.86",
      "source_key": "34086",
      "text": "एरुः"
    },
    {
      "sutra_id": "3.4.87",
      "source_key": "34087",
      "text": "सेर्ह्यपिच्च"
    },
    {
      "sutra_id": "3.4.88",
      "source_key": "34088",
      "text": "वा छन्दसि"
    },
    {
      "sutra_id": "3.4.89",
      "source_key": "34089",
      "text": "मेर्निः"
    },
    {
      "sutra_id": "3.4.90",
      "source_key": "34090",
      "text": "आमेतः"
    },
    {
      "sutra_id": "3.4.91",
      "source_key": "34091",
      "text": "सवाभ्यां वामौ"
    },
    {
      "sutra_id": "3.4.92",
      "source_key": "34092",
      "text": "आडुत्तमस्य पिच्च"
    },
    {
      "sutra_id": "3.4.93",
      "source_key": "34093",
      "text": "एत ऐ"
    },
    {
      "sutra_id": "3.4.98",
      "source_key": "34098",
      "text": "स उत्तमस्य"
    },
    {
      "sutra_id": "3.4.99",
      "source_key": "34099",
      "text": "नित्यं ङितः"
    },
    {
      "sutra_id": "3.4.100",
      "source_key": "34100",
      "text": "इतश्च"
    },
    {
      "sutra_id": "3.4.101",
      "source_key": "34101",
      "text": "तस्थस्थमिपां तांतंतामः"
    },
    {
      "sutra_id": "3.4.102",
      "source_key": "34102",
      "text": "लिङस्सीयुट्"
    },
    {
      "sutra_id": "3.4.103",
      "source_key": "34103",
      "text": "यासुट् परस्मैपदेषूदात्तो ङिच्च"
    },
    {
      "sutra_id": "3.4.104",
      "source_key": "34104",
      "text": "किदाशिषि"
    },
    {
      "sutra_id": "3.4.105",
      "source_key": "34105",
      "text": "झस्य रन्"
    },
    {
      "sutra_id": "3.4.106",
      "source_key": "34106",
      "text": "इटोऽत्"
    },
    {
      "sutra_id": "3.4.107",
      "source_key": "34107",
      "text": "सुट् तिथोः"
    },
    {
      "sutra_id": "3.4.108",
      "source_key": "34108",
      "text": "झेर्जुस्"
    },
    {
      "sutra_id": "3.4.109",
      "source_key": "34109",
      "text": "सिजभ्यस्तविदिभ्यश्च"
    },
    {
      "sutra_id": "3.4.113",
      "source_key": "34113",
      "text": "तिङ्शित्सार्वधातुकम्"
    },
    {
      "sutra_id": "3.4.114",
      "source_key": "34114",
      "text": "आर्धधातुकं शेषः"
    },
    {
      "sutra_id": "3.4.115",
      "source_key": "34115",
      "text": "लिट् च"
    },
    {
      "sutra_id": "3.4.116",
      "source_key": "34116",
      "text": "लिङाशिषि"
    },
    {
      "sutra_id": "6.1.8",
      "source_key": "61008",
      "text": "लिटि धातोरनभ्यासस्य"
    },
    {
      "sutra_id": "6.1.15",
      "source_key": "61015",
      "text": "वचिस्वपियजादीनां किति"
    },
    {
      "sutra_id": "6.1.17",
      "source_key": "61017",
      "text": "लिट्यभ्यासस्योभयेषाम्"
    },
    {
      "sutra_id": "6.1.66",
      "source_key": "61066",
      "text": "लोपो व्योर्वलि"
    },
    {
      "sutra_id": "6.1.68",
      "source_key": "61068",
      "text": "हल्ङ्याब्भ्यो दीर्घात् सुतिस्यपृक्तं हल्"
    },
    {
      "sutra_id": "6.1.77",
      "source_key": "61077",
      "text": "इको यणचि"
    },
    {
      "sutra_id": "6.1.78",
      "source_key": "61078",
      "text": "एचोऽयवायावः"
    },
    {
      "sutra_id": "6.1.87",
      "source_key": "61087",
      "text": "आद्गुणः"
    },
    {
      "sutra_id": "6.1.97",
      "source_key": "61097",
      "text": "अतो गुणे"
    },
    {
      "sutra_id": "6.1.101",
      "source_key": "61101",
      "text": "अकः सवर्णे दीर्घः"
    },
    {
      "sutra_id": "6.1.108",
      "source_key": "61108",
      "text": "सम्प्रसारणाच्च"
    },
    {
      "sutra_id": "6.3.112",
      "source_key": "63112",
      "text": "सहिवहोरोदवर्णस्य"
    },
    {
      "sutra_id": "6.4.23",
      "source_key": "64023",
      "text": "श्नान्नलोपः"
    },
    {
      "sutra_id": "6.4.47",
      "source_key": "64047",
      "text": "भ्रस्जो रोपधयोः रमन्यतरस्याम्"
    },
    {
      "sutra_id": "6.4.71",
      "source_key": "64071",
      "text": "लुङ्लङ्लृङ्क्ष्वडुदात्तः"
    },
    {
      "sutra_id": "6.4.74",
      "source_key": "64074",
      "text": "न माङ्योगे"
    },
    {
      "sutra_id": "6.4.77",
      "source_key": "64077",
      "text": "अचि श्नुधातुभ्रुवां य्वोरियङुवङौ"
    },
    {
      "sutra_id": "6.4.82",
      "source_key": "64082",
      "text": "एरनेकाचोऽसंयोगपूर्वस्य"
    },
    {
      "sutra_id": "6.4.87",
      "source_key": "64087",
      "text": "हुश्नुवोः सार्वधातुके"
    },
    {
      "sutra_id": "6.4.105",
      "source_key": "64105",
      "text": "अतो हेः"
    },
    {
      "sutra_id": "6.4.106",
      "source_key": "64106",
      "text": "उतश्च प्रत्ययादसंयोगपूर्वात्"
    },
    {
      "sutra_id": "6.4.107",
      "source_key": "64107",
      "text": "लोपश्चास्यान्यतरस्यां म्वोः"
    },
    {
      "sutra_id": "6.4.108",
      "source_key": "64108",
      "text": "नित्यं करोतेः"
    },
    {
      "sutra_id": "6.4.109",
      "source_key": "64109",
      "text": "ये च"
    },
    {
      "sutra_id": "6.4.110",
      "source_key": "64110",
      "text": "अत उत् सार्वधातुके"
    },
    {
      "sutra_id": "6.4.111",
      "source_key": "64111",
      "text": "श्नसोरल्लोपः"
    },
    {
      "sutra_id": "6.4.120",
      "source_key": "64120",
      "text": "अत एकहल्मध्येऽनादेशादेर्लिटि"
    },
    {
      "sutra_id": "6.4.121",
      "source_key": "64121",
      "text": "थलि च सेटि"
    },
    {
      "sutra_id": "6.4.126",
      "source_key": "64126",
      "text": "न शसददवादिगुणानाम्"
    },
    {
      "sutra_id": "6.4.143",
      "source_key": "64143",
      "text": "टेः"
    },
    {
      "sutra_id": "7.1.3",
      "source_key": "71003",
      "text": "झोऽन्तः"
    },
    {
      "sutra_id": "7.1.5",
      "source_key": "71005",
      "text": "आत्मनेपदेष्वनतः"
    },
    {
      "sutra_id": "7.1.35",
      "source_key": "71035",
      "text": "तुह्योस्तातङ्ङाशिष्यन्यतरस्याम्"
    },
    {
      "sutra_id": "7.1.91",
      "source_key": "71091",
      "text": "णलुत्तमो वा"
    },
    {
      "sutra_id": "7.2.1",
      "source_key": "72001",
      "text": "सिचि वृद्धिः परस्मैपदेषु"
    },
    {
      "sutra_id": "7.2.2",
      "source_key": "72002",
      "text": "अतो ल्रान्तस्य"
    },
    {
      "sutra_id": "7.2.3",
      "source_key": "72003",
      "text": "वदव्रजहलन्तस्याचः"
    },
    {
      "sutra_id": "7.2.4",
      "source_key": "72004",
      "text": "नेटि"
    },
    {
      "sutra_id": "7.2.5",
      "source_key": "72005",
      "text": "ह्म्यन्तक्षणश्वसजागृणिश्व्येदिताम्"
    },
    {
      "sutra_id": "7.2.6",
      "source_key": "72006",
      "text": "ऊर्णोतेर्विभाषा"
    },
    {
      "sutra_id": "7.2.7",
      "source_key": "72007",
      "text": "अतो हलादेर्लघोः"
    },
    {
      "sutra_id": "7.2.10",
      "source_key": "72010",
      "text": "एकाच उपदेशेऽनुदात्तात्"
    },
    {
      "sutra_id": "7.2.13",
      "source_key": "72013",
      "text": "कृसृभृवृस्तुद्रुस्रुश्रुवो लिटि"
    },
    {
      "sutra_id": "7.2.35",
      "source_key": "72035",
      "text": "आर्धधातुकस्येड् वलादेः"
    },
    {
      "sutra_id": "7.2.42",
      "source_key": "72042",
      "text": "लिङ्सिचोरात्मनेपदेषु"
    },
    {
      "sutra_id": "7.2.61",
      "source_key": "72061",
      "text": "अचस्तास्वत् थल्यनिटो नित्यम्"
    },
    {
      "sutra_id": "7.2.62",
      "source_key": "72062",
      "text": "उपदेशेऽत्वतः"
    },
    {
      "sutra_id": "7.2.63",
      "source_key": "72063",
      "text": "ऋतो भारद्वाजस्य"
    },
    {
      "sutra_id": "7.2.70",
      "source_key": "72070",
      "text": "ऋद्धनोः स्ये"
    },
    {
      "sutra_id": "7.2.79",
      "source_key": "72079",
      "text": "लिङः सलोपोऽनन्त्यस्य"
    },
    {
      "sutra_id": "7.2.80",
      "source_key": "72080",
      "text": "अतो येयः"
    },
    {
      "sutra_id": "7.2.81",
      "source_key": "72081",
      "text": "आतो ङितः"
    },
    {
      "sutra_id": "7.2.115",
      "source_key": "72115",
      "text": "अचो ञ्णिति"
    },
    {
      "sutra_id": "7.2.116",
      "source_key": "72116",
      "text": "अत उपधायाः"
    },
    {
      "sutra_id": "7.3.72",
      "source_key": "73072",
      "text": "क्सस्याचि"
    },
    {
      "sutra_id": "7.3.73",
      "source_key": "73073",
      "text": "लुग्वा दुहदिहलिहगुहामात्मनेपदे दन्त्ये"
    },
    {
      "sutra_id": "7.3.84",
      "source_key": "73084",
      "text": "सार्वधातुकार्धधातुकयोः"
    },
    {
      "sutra_id": "7.3.86",
      "source_key": "73086",
      "text": "पुगन्तलघूपधस्य च"
    },
    {
      "sutra_id": "7.3.96",
      "source_key": "73096",
      "text": "अस्तिसिचोऽपृक्ते"
    },
    {
      "sutra_id": "7.3.101",
      "source_key": "73101",
      "text": "अतो दीर्घो यञि"
    },
    {
      "sutra_id": "7.4.25",
      "source_key": "74025",
      "text": "अकृत्सार्वधातुकयोर्दीर्घः"
    },
    {
      "sutra_id": "7.4.28",
      "source_key": "74028",
      "text": "रिङ् शयग्लिङ्क्षु"
    },
    {
      "sutra_id": "7.4.50",
      "source_key": "74050",
      "text": "तासस्त्योर्लोपः"
    },
    {
      "sutra_id": "7.4.51",
      "source_key": "74051",
      "text": "रि च"
    },
    {
      "sutra_id": "7.4.52",
      "source_key": "74052",
      "text": "ह एति"
    },
    {
      "sutra_id": "7.4.59",
      "source_key": "74059",
      "text": "ह्रस्वः"
    },
    {
      "sutra_id": "7.4.60",
      "source_key": "74060",
      "text": "हलादिः शेषः"
    },
    {
      "sutra_id": "7.4.62",
      "source_key": "74062",
      "text": "कुहोश्चुः"
    },
    {
      "sutra_id": "7.4.66",
      "source_key": "74066",
      "text": "उरत्"
    },
    {
      "sutra_id": "8.2.1",
      "source_key": "82001",
      "text": "पूर्वत्रासिद्धम्"
    },
    {
      "sutra_id": "8.2.23",
      "source_key": "82023",
      "text": "संयोगान्तस्य लोपः"
    },
    {
      "sutra_id": "8.2.26",
      "source_key": "82026",
      "text": "झलो झलि"
    },
    {
      "sutra_id": "8.2.27",
      "source_key": "82027",
      "text": "ह्रस्वादङ्गात्"
    },
    {
      "sutra_id": "8.2.28",
      "source_key": "82028",
      "text": "इट ईटि"
    },
    {
      "sutra_id": "8.2.29",
      "source_key": "82029",
      "text": "स्कोः संयोगाद्योरन्ते च"
    },
    {
      "sutra_id": "8.2.30",
      "source_key": "82030",
      "text": "चोः कुः"
    },
    {
      "sutra_id": "8.2.31",
      "source_key": "82031",
      "text": "हो ढः"
    },
    {
      "sutra_id": "8.2.36",
      "source_key": "82036",
      "text": "व्रश्चभ्रस्जसृजमृजयजराजभ्राजच्छशां षः"
    },
    {
      "sutra_id": "8.2.39",
      "source_key": "82039",
      "text": "झलां जशोऽन्ते"
    },
    {
      "sutra_id": "8.2.40",
      "source_key": "82040",
      "text": "झषस्तथोर्धोऽधः"
    },
    {
      "sutra_id": "8.2.41",
      "source_key": "82041",
      "text": "षढोः कः सि"
    },
    {
      "sutra_id": "8.2.66",
      "source_key": "82066",
      "text": "ससजुषो रुः"
    },
    {
      "sutra_id": "8.2.77",
      "source_key": "82077",
      "text": "हलि च"
    },
    {
      "sutra_id": "8.2.79",
      "source_key": "82079",
      "text": "न भकुर्छुराम्"
    },
    {
      "sutra_id": "8.3.13",
      "source_key": "83013",
      "text": "ढो ढे लोपः"
    },
    {
      "sutra_id": "8.3.15",
      "source_key": "83015",
      "text": "खरवसानयोर्विसर्जनीयः"
    },
    {
      "sutra_id": "8.3.24",
      "source_key": "83024",
      "text": "नश्चापदान्तस्य झलि"
    },
    {
      "sutra_id": "8.3.55",
      "source_key": "83055",
      "text": "अपदान्तस्य मूर्धन्यः"
    },
    {
      "sutra_id": "8.3.57",
      "source_key": "83057",
      "text": "इण्कोः"
    },
    {
      "sutra_id": "8.3.58",
      "source_key": "83058",
      "text": "नुम्विसर्जनीयशर्व्यवायेऽपि"
    },
    {
      "sutra_id": "8.3.59",
      "source_key": "83059",
      "text": "आदेशप्रत्यययोः"
    },
    {
      "sutra_id": "8.3.78",
      "source_key": "83078",
      "text": "इणः षीध्वंलुङ्लिटां धोऽङ्गात्"
    },
    {
      "sutra_id": "8.3.79",
      "source_key": "83079",
      "text": "विभाषेटः"
    },
    {
      "sutra_id": "8.4.1",
      "source_key": "84001",
      "text": "रषाभ्यां नो णः समानपदे"
    },
    {
      "sutra_id": "8.4.2",
      "source_key": "84002",
      "text": "अट्कुप्वाङ्नुम्व्यवायेऽपि"
    },
    {
      "sutra_id": "8.4.14",
      "source_key": "84014",
      "text": "उपसर्गादसमासेऽपि णोपदेशस्य"
    },
    {
      "sutra_id": "8.4.15",
      "source_key": "84015",
      "text": "हिनुमीना"
    },
    {
      "sutra_id": "8.4.17",
      "source_key": "84017",
      "text": "नेर्गदनदपतपदघुमास्यतिहन्तियातिवातिद्रातिप्सातिवपतिवहतिशाम्यतिचिनोतिदेग्धिषु च"
    },
    {
      "sutra_id": "8.4.18",
      "source_key": "84018",
      "text": "शेषे विभाषाऽकखादावषान्त उपदेशे"
    },
    {
      "sutra_id": "8.4.37",
      "source_key": "84037",
      "text": "पदान्तस्य"
    },
    {
      "sutra_id": "8.4.38",
      "source_key": "84038",
      "text": "पदव्यवायेऽपि"
    },
    {
      "sutra_id": "8.4.39",
      "source_key": "84039",
      "text": "क्षुभ्नाऽऽदिषु च"
    },
    {
      "sutra_id": "8.4.41",
      "source_key": "84041",
      "text": "ष्टुना ष्टुः"
    },
    {
      "sutra_id": "8.4.53",
      "source_key": "84053",
      "text": "झलां जश् झशि"
    },
    {
      "sutra_id": "8.4.54",
      "source_key": "84054",
      "text": "अभ्यासे चर्च"
    },
    {
      "sutra_id": "8.4.56",
      "source_key": "84056",
      "text": "वाऽवसाने"
    },
    {
      "sutra_id": "8.4.58",
      "source_key": "84058",
      "text": "अनुस्वारस्य ययि परसवर्णः"
    },
    {
      "sutra_id": "8.4.65",
      "source_key": "84065",
      "text": "झरो झरि सवर्णे"
    }
  ],
  "commentary_entries": [
    {
      "source": "kashika",
      "sutra_id": "1.3.81",
      "source_key": "13081",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG110_P_EXCEPTION_SAMPRASARANA_OR_CONTACT",
      "text": "<<वह प्रापणे>> (धा० पा० १००४) स्वरितेत्। तत्र कर्त्रभिप्रायक्रियाफलविवक्षायात्मनेपदे प्राप्ते परस्मैपदं विधीयते। प्रपूर्वाद्वहतेः परस्मैपदं भवति। प्रवहति, प्रवहतः, प्रवहन्ति। प्रादिति किम्? आवहते॥"
    },
    {
      "source": "kashika",
      "sutra_id": "6.1.15",
      "source_key": "61015",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG110_P_EXCEPTION_SAMPRASARANA_OR_CONTACT",
      "text": "संप्रसारणमिति वर्तते। ष्यङ इति निवृत्तम्। वचि — <<वच परिभाषणे>>  <<ब्रुवो वचिः>> [[२.४.५३]] इति च। स्वपि — <<ञिष्वप् शये>>। यजादयो <<यज देवपूजासंगतिकरणदानेषु>>  इत्यतः प्रभृति आगणान्ताः। तेषां वचिस्वपियजादीनां किति प्रत्यये परतः संप्रसारणं भवति। वचि — उक्तः। उक्तवान्। स्वपि — सुप्तः। सुप्तवान्। यज — इष्टः। इष्टवान्। वप — उप्तः। उप्तवान्। वह — ऊढः। ऊढवान्। वस — उषितः। उषितवान्। वेञ् — उतः। उतवान्। व्येञ् — संवीतः। संवीतवान्। ह्वेञ् — आहूतः। आहूतवान्। वद — उदितः। उदितवान्। टुओश्वि — शूनः। शूनवान्। <<धातोःस्वरूपग्रहणे तत्प्रत्यये कार्यं विज्ञायते>>। तेनेह न भवति — वाच्यति, वाचिक इति॥"
    },
    {
      "source": "kashika",
      "sutra_id": "6.1.17",
      "source_key": "61017",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG110_P_EXCEPTION_SAMPRASARANA_OR_CONTACT",
      "text": "उभयेषां वच्यादीनां ग्रह्यादीनां च लिटि परतोऽभ्यासस्य संप्रसारणं भवति। वचि — उवाच। उवचिथ। स्वप् — सुष्वाप। सुष्वपिथ। यज — इयाज। इयजिथ। डुवप् — उवाप। उवपिथ। ग्रह्यादीनाम् — तत्र ग्रहेरविशेषः। जग्राह। जग्रहिथ। ज्या — जिज्यौ। जिज्यिथ। वयि — उवाय। उवयिथ। व्यध — विव्याध। विव्यधिथ। वश — उवाश। उवशिथ। व्यच — विव्याच। विव्यचिथ। वृश्चतेः सत्यसति वा योगे नास्ति विशेषः। योगारम्भे तु सति यदि संप्रसारणमकृत्वा हलादिशेषेण [[७.४.६०]] रेफो निवर्त्यते, तदा वकारस्य  संप्रसारणं प्राप्नोति। अथ रेफस्य संप्रसारणं कृत्वा उरदत्वं रपरत्वं च क्रियते, तदानीमुरदत्वस्य स्थानिवद्भावाद् <<न संप्रसारणे संप्रसारणम्>> [[६.१.३७]] इति प्रतिषेधो भवतीत्यस्ति विशेषः। वव्रश्च। वव्रश्चिथ। पृच्छतिभृज्जत्योरविशेषः। अकिदर्थं चेदमभ्यासस्य संप्रसारणं विधीयते। किति हि परत्वाद् धातोः संप्रसारणे कृते <<पुनः प्रसङ्गविज्ञानाद्०>> द्विवर्चनम् — ऊचतुः, ऊचुरिति। अधिकारादेवोभयेषां ग्रहणे सिद्धे पुनरुभयेषामिति वचनं हलादिशेषम् [[७.४.६०]] अपि बाधित्वा संप्रसारणमेव यथा स्यादिति। विव्याध॥"
