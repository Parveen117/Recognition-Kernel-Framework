  "sutra_texts": [
    {
      "sutra_id": "1.1.5",
      "source_key": "11005",
      "text": "क्ङिति च"
    },
    {
      "sutra_id": "1.1.6",
      "source_key": "11006",
      "text": "दीधीवेवीटाम्"
    },
    {
      "sutra_id": "1.1.20",
      "source_key": "11020",
      "text": "दाधा घ्वदाप्"
    },
    {
      "sutra_id": "1.1.46",
      "source_key": "11046",
      "text": "आद्यन्तौ टकितौ"
    },
    {
      "sutra_id": "1.1.52",
      "source_key": "11052",
      "text": "अलोऽन्त्यस्य"
    },
    {
      "sutra_id": "1.1.55",
      "source_key": "11055",
      "text": "अनेकाल्शित्सर्वस्य"
    },
    {
      "sutra_id": "1.2.4",
      "source_key": "12004",
      "text": "सार्वधातुकमपित्"
    },
    {
      "sutra_id": "1.2.5",
      "source_key": "12005",
      "text": "असंयोगाल्लिट् कित्"
    },
    {
      "sutra_id": "1.2.11",
      "source_key": "12011",
      "text": "लिङ्सिचावात्मनेपदेषु"
    },
    {
      "sutra_id": "1.2.12",
      "source_key": "12012",
      "text": "उश्च"
    },
    {
      "sutra_id": "1.2.13",
      "source_key": "12013",
      "text": "वा गमः"
    },
    {
      "sutra_id": "1.2.15",
      "source_key": "12015",
      "text": "यमो गन्धने"
    },
    {
      "sutra_id": "1.2.16",
      "source_key": "12016",
      "text": "विभाषोपयमने"
    },
    {
      "sutra_id": "1.2.17",
      "source_key": "12017",
      "text": "स्था घ्वोरिच्च"
    },
    {
      "sutra_id": "1.2.41",
      "source_key": "12041",
      "text": "अपृक्त एकाल् प्रत्ययः"
    },
    {
      "sutra_id": "1.3.2",
      "source_key": "13002",
      "text": "उपदेशेऽजनुनासिक इत्"
    },
    {
      "sutra_id": "1.3.3",
      "source_key": "13003",
      "text": "हलन्त्यम्"
    },
    {
      "sutra_id": "1.3.9",
      "source_key": "13009",
      "text": "तस्य लोपः"
    },
    {
      "sutra_id": "1.3.12",
      "source_key": "13012",
      "text": "अनुदात्तङित आत्मनेपदम्"
    },
    {
      "sutra_id": "1.3.17",
      "source_key": "13017",
      "text": "नेर्विशः"
    },
    {
      "sutra_id": "1.3.28",
      "source_key": "13028",
      "text": "आङो यमहनः"
    },
    {
      "sutra_id": "1.3.54",
      "source_key": "13054",
      "text": "समस्तृतीयायुक्तात्"
    },
    {
      "sutra_id": "1.3.55",
      "source_key": "13055",
      "text": "दाणश्च सा चेच्चतुर्थ्यर्थे"
    },
    {
      "sutra_id": "1.3.56",
      "source_key": "13056",
      "text": "उपाद्यमः स्वकरणे"
    },
    {
      "sutra_id": "1.3.57",
      "source_key": "13057",
      "text": "ज्ञाश्रुस्मृदृशां सनः"
    },
    {
      "sutra_id": "1.3.58",
      "source_key": "13058",
      "text": "नानोर्ज्ञः"
    },
    {
      "sutra_id": "1.3.59",
      "source_key": "13059",
      "text": "प्रत्याङ्भ्यां श्रुवः"
    },
    {
      "sutra_id": "1.3.62",
      "source_key": "13062",
      "text": "पूर्ववत् सनः"
    },
    {
      "sutra_id": "1.3.75",
      "source_key": "13075",
      "text": "समुदाङ्भ्यो यमोऽग्रन्थे"
    },
    {
      "sutra_id": "1.3.77",
      "source_key": "13077",
      "text": "विभाषोपपदेन प्रतीयमाने"
    },
    {
      "sutra_id": "1.3.78",
      "source_key": "13078",
      "text": "शेषात् कर्तरि परस्मैपदम्"
    },
    {
      "sutra_id": "1.4.58",
      "source_key": "14058",
      "text": "प्रादयः"
    },
    {
      "sutra_id": "1.4.59",
      "source_key": "14059",
      "text": "उपसर्गाः क्रियायोगे"
    },
    {
      "sutra_id": "2.4.77",
      "source_key": "24077",
      "text": "गातिस्थाघुपाभूभ्यः सिचः परस्मैपदेषु"
    },
    {
      "sutra_id": "2.4.85",
      "source_key": "24085",
      "text": "लुटः प्रथमस्य डारौरसः"
    },
    {
      "sutra_id": "3.1.33",
      "source_key": "31033",
      "text": "स्यतासी लृलुटोः"
    },
    {
      "sutra_id": "3.1.43",
      "source_key": "31043",
      "text": "च्लि लुङि"
    },
    {
      "sutra_id": "3.1.44",
      "source_key": "31044",
      "text": "च्लेः सिच्"
    },
    {
      "sutra_id": "3.1.68",
      "source_key": "31068",
      "text": "कर्तरि शप्"
    },
    {
      "sutra_id": "3.2.110",
      "source_key": "32110",
      "text": "लुङ्"
    },
    {
      "sutra_id": "3.2.111",
      "source_key": "32111",
      "text": "अनद्यतने लङ्"
    },
    {
      "sutra_id": "3.2.115",
      "source_key": "32115",
      "text": "परोक्षे लिट्"
    },
    {
      "sutra_id": "3.2.123",
      "source_key": "32123",
      "text": "वर्तमाने लट्"
    },
    {
      "sutra_id": "3.3.13",
      "source_key": "33013",
      "text": "लृट् शेषे च"
    },
    {
      "sutra_id": "3.3.15",
      "source_key": "33015",
      "text": "अनद्यतने लुट्"
    },
    {
      "sutra_id": "3.3.139",
      "source_key": "33139",
      "text": "लिङ्निमित्ते लृङ् क्रियातिपत्तौ"
    },
    {
      "sutra_id": "3.3.147",
      "source_key": "33147",
      "text": "जातुयदोर्लिङ्"
    },
    {
      "sutra_id": "3.3.161",
      "source_key": "33161",
      "text": "विधिनिमन्त्रणामन्त्रणाधीष्टसंप्रश्नप्रार्थनेषु लिङ्"
    },
    {
      "sutra_id": "3.3.162",
      "source_key": "33162",
      "text": "लोट् च"
    },
    {
      "sutra_id": "3.3.173",
      "source_key": "33173",
      "text": "आशिषि लिङ्लोटौ"
    },
    {
      "sutra_id": "3.4.78",
      "source_key": "34078",
      "text": "तिप्तस्झिसिप्थस्थमिब्वस्मस् तातांझथासाथांध्वमिड्वहिमहिङ्"
    },
    {
      "sutra_id": "3.4.79",
      "source_key": "34079",
      "text": "टित आत्मनेपदानां टेरे"
    },
    {
      "sutra_id": "3.4.80",
      "source_key": "34080",
      "text": "थासस्से"
    },
    {
      "sutra_id": "3.4.81",
      "source_key": "34081",
      "text": "लिटस्तझयोरेशिरेच्"
    },
    {
      "sutra_id": "3.4.82",
      "source_key": "34082",
      "text": "परस्मैपदानां णलतुसुस्थलथुसणल्वमाः"
    },
    {
      "sutra_id": "3.4.85",
      "source_key": "34085",
      "text": "लोटो लङ्वत्"
    },
    {
      "sutra_id": "3.4.86",
      "source_key": "34086",
      "text": "एरुः"
    },
    {
      "sutra_id": "3.4.87",
      "source_key": "34087",
      "text": "सेर्ह्यपिच्च"
    },
    {
      "sutra_id": "3.4.90",
      "source_key": "34090",
      "text": "आमेतः"
    },
    {
      "sutra_id": "3.4.91",
      "source_key": "34091",
      "text": "सवाभ्यां वामौ"
    },
    {
      "sutra_id": "3.4.92",
      "source_key": "34092",
      "text": "आडुत्तमस्य पिच्च"
    },
    {
      "sutra_id": "3.4.93",
      "source_key": "34093",
      "text": "एत ऐ"
    },
    {
      "sutra_id": "3.4.94",
      "source_key": "34094",
      "text": "लेटोऽडाटौ"
    },
    {
      "sutra_id": "3.4.99",
      "source_key": "34099",
      "text": "नित्यं ङितः"
    },
    {
      "sutra_id": "3.4.100",
      "source_key": "34100",
      "text": "इतश्च"
    },
    {
      "sutra_id": "3.4.101",
      "source_key": "34101",
      "text": "तस्थस्थमिपां तांतंतामः"
    },
    {
      "sutra_id": "3.4.102",
      "source_key": "34102",
      "text": "लिङस्सीयुट्"
    },
    {
      "sutra_id": "3.4.103",
      "source_key": "34103",
      "text": "यासुट् परस्मैपदेषूदात्तो ङिच्च"
    },
    {
      "sutra_id": "3.4.104",
      "source_key": "34104",
      "text": "किदाशिषि"
    },
    {
      "sutra_id": "3.4.105",
      "source_key": "34105",
      "text": "झस्य रन्"
    },
    {
      "sutra_id": "3.4.106",
      "source_key": "34106",
      "text": "इटोऽत्"
    },
    {
      "sutra_id": "3.4.107",
      "source_key": "34107",
      "text": "सुट् तिथोः"
    },
    {
      "sutra_id": "3.4.108",
      "source_key": "34108",
      "text": "झेर्जुस्"
    },
    {
      "sutra_id": "3.4.113",
      "source_key": "34113",
      "text": "तिङ्शित्सार्वधातुकम्"
    },
    {
      "sutra_id": "3.4.114",
      "source_key": "34114",
      "text": "आर्धधातुकं शेषः"
    },
    {
      "sutra_id": "3.4.115",
      "source_key": "34115",
      "text": "लिट् च"
    },
    {
      "sutra_id": "3.4.116",
      "source_key": "34116",
      "text": "लिङाशिषि"
    },
    {
      "sutra_id": "6.1.8",
      "source_key": "61008",
      "text": "लिटि धातोरनभ्यासस्य"
    },
    {
      "sutra_id": "6.1.59",
      "source_key": "61059",
      "text": "अनुदात्तस्य चर्दुपधस्यान्यतरस्याम्"
    },
    {
      "sutra_id": "6.1.66",
      "source_key": "61066",
      "text": "लोपो व्योर्वलि"
    },
    {
      "sutra_id": "6.1.73",
      "source_key": "61073",
      "text": "छे च"
    },
    {
      "sutra_id": "6.1.87",
      "source_key": "61087",
      "text": "आद्गुणः"
    },
    {
      "sutra_id": "6.1.88",
      "source_key": "61088",
      "text": "वृद्धिरेचि"
    },
    {
      "sutra_id": "6.1.90",
      "source_key": "61090",
      "text": "आटश्च"
    },
    {
      "sutra_id": "6.1.97",
      "source_key": "61097",
      "text": "अतो गुणे"
    },
    {
      "sutra_id": "6.1.101",
      "source_key": "61101",
      "text": "अकः सवर्णे दीर्घः"
    },
    {
      "sutra_id": "6.4.37",
      "source_key": "64037",
      "text": "अनुदात्तोपदेशवनतितनोत्यादीनामनुनासिक लोपो झलि क्ङिति"
    },
    {
      "sutra_id": "6.4.64",
      "source_key": "64064",
      "text": "आतो लोप इटि च"
    },
    {
      "sutra_id": "6.4.66",
      "source_key": "64066",
      "text": "घुमास्थागापाजहातिसां हलि"
    },
    {
      "sutra_id": "6.4.67",
      "source_key": "64067",
      "text": "एर्लिङि"
    },
    {
      "sutra_id": "6.4.68",
      "source_key": "64068",
      "text": "वाऽन्यस्य संयोगादेः"
    },
    {
      "sutra_id": "6.4.71",
      "source_key": "64071",
      "text": "लुङ्लङ्लृङ्क्ष्वडुदात्तः"
    },
    {
      "sutra_id": "6.4.74",
      "source_key": "64074",
      "text": "न माङ्योगे"
    },
    {
      "sutra_id": "6.4.120",
      "source_key": "64120",
      "text": "अत एकहल्मध्येऽनादेशादेर्लिटि"
    },
    {
      "sutra_id": "7.1.3",
      "source_key": "71003",
      "text": "झोऽन्तः"
    },
    {
      "sutra_id": "7.1.5",
      "source_key": "71005",
      "text": "आत्मनेपदेष्वनतः"
    },
    {
      "sutra_id": "7.2.1",
      "source_key": "72001",
      "text": "सिचि वृद्धिः परस्मैपदेषु"
    },
    {
      "sutra_id": "7.2.10",
      "source_key": "72010",
      "text": "एकाच उपदेशेऽनुदात्तात्"
    },
    {
      "sutra_id": "7.2.13",
      "source_key": "72013",
      "text": "कृसृभृवृस्तुद्रुस्रुश्रुवो लिटि"
    },
    {
      "sutra_id": "7.2.35",
      "source_key": "72035",
      "text": "आर्धधातुकस्येड् वलादेः"
    },
    {
      "sutra_id": "7.2.58",
      "source_key": "72058",
      "text": "गमेरिट् परस्मैपदेषु"
    },
    {
      "sutra_id": "7.2.73",
      "source_key": "72073",
      "text": "यमरमनमातां सक् च"
    },
    {
      "sutra_id": "7.2.79",
      "source_key": "72079",
      "text": "लिङः सलोपोऽनन्त्यस्य"
    },
    {
      "sutra_id": "7.2.80",
      "source_key": "72080",
      "text": "अतो येयः"
    },
    {
      "sutra_id": "7.2.81",
      "source_key": "72081",
      "text": "आतो ङितः"
    },
    {
      "sutra_id": "7.3.77",
      "source_key": "73077",
      "text": "इषुगमियमां छः"
    },
    {
      "sutra_id": "7.3.78",
      "source_key": "73078",
      "text": "पाघ्राध्मास्थाम्नादाण्दृश्यर्त्तिसर्त्तिशदसदां पिबजिघ्रधमतिष्ठमनयच्छपश्यर्च्छधौशीयसीदाः"
    },
    {
      "sutra_id": "7.3.96",
      "source_key": "73096",
      "text": "अस्तिसिचोऽपृक्ते"
    },
    {
      "sutra_id": "7.3.101",
      "source_key": "73101",
      "text": "अतो दीर्घो यञि"
    },
    {
      "sutra_id": "7.4.50",
      "source_key": "74050",
      "text": "तासस्त्योर्लोपः"
    },
    {
      "sutra_id": "7.4.51",
      "source_key": "74051",
      "text": "रि च"
    },
    {
      "sutra_id": "7.4.52",
      "source_key": "74052",
      "text": "ह एति"
    },
    {
      "sutra_id": "7.4.59",
      "source_key": "74059",
      "text": "ह्रस्वः"
    },
    {
      "sutra_id": "7.4.60",
      "source_key": "74060",
      "text": "हलादिः शेषः"
    },
    {
      "sutra_id": "8.2.1",
      "source_key": "82001",
      "text": "पूर्वत्रासिद्धम्"
    },
    {
      "sutra_id": "8.2.25",
      "source_key": "82025",
      "text": "धि च"
    },
    {
      "sutra_id": "8.2.26",
      "source_key": "82026",
      "text": "झलो झलि"
    },
    {
      "sutra_id": "8.2.27",
      "source_key": "82027",
      "text": "ह्रस्वादङ्गात्"
    },
    {
      "sutra_id": "8.2.28",
      "source_key": "82028",
      "text": "इट ईटि"
    },
    {
      "sutra_id": "8.2.66",
      "source_key": "82066",
      "text": "ससजुषो रुः"
    },
    {
      "sutra_id": "8.3.15",
      "source_key": "83015",
      "text": "खरवसानयोर्विसर्जनीयः"
    },
    {
      "sutra_id": "8.3.23",
      "source_key": "83023",
      "text": "मोऽनुस्वारः"
    },
    {
      "sutra_id": "8.3.24",
      "source_key": "83024",
      "text": "नश्चापदान्तस्य झलि"
    },
    {
      "sutra_id": "8.3.59",
      "source_key": "83059",
      "text": "आदेशप्रत्यययोः"
    },
    {
      "sutra_id": "8.3.78",
      "source_key": "83078",
      "text": "इणः षीध्वंलुङ्लिटां धोऽङ्गात्"
    },
    {
      "sutra_id": "8.3.79",
      "source_key": "83079",
      "text": "विभाषेटः"
    },
    {
      "sutra_id": "8.4.37",
      "source_key": "84037",
      "text": "पदान्तस्य"
    },
    {
      "sutra_id": "8.4.40",
      "source_key": "84040",
      "text": "स्तोः श्चुना श्चुः"
    },
    {
      "sutra_id": "8.4.41",
      "source_key": "84041",
      "text": "ष्टुना ष्टुः"
    },
    {
      "sutra_id": "8.4.58",
      "source_key": "84058",
      "text": "अनुस्वारस्य ययि परसवर्णः"
    },
    {
      "sutra_id": "8.4.59",
      "source_key": "84059",
      "text": "वा पदान्तस्य"
    }
  ],
  "commentary_entries": [
    {
      "source": "kashika",
      "sutra_id": "1.3.75",
      "source_key": "13075",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG106_COLLECTION_GRANTHA_RESULT_SIC_KIT_OR_PREFIX_BOUNDARY",
      "text": "कर्त्रभिप्राये इति वर्तते। सम् उद् आङ् इत्येवंपूर्वाद् यमेः कर्त्रभिप्राये क्रियाफले आत्मनेपदं भवति, ग्रन्थविषयश्चेत्प्रयोगो न भवति। व्रीहीन् संयच्छते। भारमुद्यच्छते। वस्त्रमायच्छते। आङ्पूर्वादकर्मकाद् <<आङो यमहनः>> [[१.३.२८]] इति सिद्धमेवात्मनेपदम्, सकर्मकार्थमिदं पुनर्ग्रहणम्। अग्रन्थ इति किम्? उद्यच्छति चिकित्सां वैद्यः। कर्त्रभिप्राय इत्येव — संयच्छति। उद्यच्छति। आयच्छति॥"
    },
    {
      "source": "kashika",
      "sutra_id": "1.3.77",
      "source_key": "13077",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG106_COLLECTION_GRANTHA_RESULT_SIC_KIT_OR_PREFIX_BOUNDARY",
      "text": "<<स्वरितञितः०>> [[१.३.७२]] इति पञ्चभिः सूत्रैरात्मनेपदं कर्त्रभिप्राये क्रियाफले द्योतिते विहितम्, तदुपपदेन द्योतिते न प्राप्नोतीति वचनमारभ्यते। समीपे श्रूयमाणं शब्दान्तरमुपपदम्, तेन प्रतीयमाने कर्त्रभिप्राये क्रियाफले विभाषाऽऽत्मनेपदं भवति। स्वं यज्ञं यजति, स्वं यज्ञं यजते। स्वं कटं करोति, स्वं कटं कुरुते। स्वं पुत्रमपवदति, स्वं पुत्रमपवदते। एवं पञ्चसूत्र्यामुदाहार्यम्॥"
    },
    {
      "source": "kashika",
      "sutra_id": "1.3.78",
      "source_key": "13078",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG106_COLLECTION_GRANTHA_RESULT_SIC_KIT_OR_PREFIX_BOUNDARY",
      "text": "पूर्वेण प्रकरणेनात्मनेपदनियमः कृतः, न परस्मैपदनियमः। तत् सर्वतः प्राप्नोति, तदर्थमिदमुच्यते। येभ्यो धातुभ्यो येन विशेषणेनात्मनेपदमुक्तं ततो यदन्यत् स शेषः। शेषात् कर्तरि परस्मैपदं भवति, शेषादेव नान्यस्मात्। <<अनुदात्तङित आत्मनेपदम्>> [[१.३.१२]] उक्तम् — आस्ते। शेते। ततोऽन्यत्र परस्मैपदं भवति — याति। वाति। <<नेर्विशः>> [[१.३.१७]] आत्मनेपदमुक्तम् — निविशते। ततोऽन्यत्र परस्मैपदम् — आविशति। प्रविशति। कर्तरीति किम्? पच्यते। गम्यते। कर्मकर्तरि कस्मात्परस्मैपदं न भवति — पच्यत ओदनः स्वयमेव? <<कर्तरि कर्मव्यतिहारे>> [[१.३.१४]] इति द्वितीयं कर्तृग्रहणमनुवर्तते। तेन कर्तैव यः कर्ता (म० भा० [[१.३.३८]]), तत्र परस्मैपदं भवति, कर्मकर्तरि न भवति॥"
    },
    {
      "source": "kashika",
      "sutra_id": "1.3.28",
      "source_key": "13028",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG106_COLLECTION_GRANTHA_RESULT_SIC_KIT_OR_PREFIX_BOUNDARY",
      "text": "अकर्मकादिति वर्तते। <<यम उपरमे>> (धा.पा. ९८४),<<हन हिंसागत्योः>> (धा.पा. १०१२) इति परस्मैपदिनौ। ताभ्यामकर्मकक्रियावचनाभ्यामाङ्पूर्वाभ्यामात्मनेपदं भवति। आयच्छते, आयच्छेते, आयच्छन्ते। हनः खल्वपि — आहते, आघ्नाते, आघ्नते। अकर्मकादित्येव — आयच्छति कूपाद् रज्जुम्। आहन्ति वृषलं पादेन (म.भा. [[१.३.२८]] वा. १))॥ स्वाङ्गकर्मकाच्चेति वक्तव्यम् (म.भा. [[१.३.२८]] वा. २)) ॥ आयच्छते पाणिम्। आहते शिरः (म.भा. [[१.३.२८]]) । स्वाङ्गं चेह न पारिभाषिकं गृह्यते। किं तर्हि ? स्वमङ्गं स्वाङ्गम्, तेनेह न भवति — आहन्ति शिरः परकीयमिति॥"
    },
    {
      "source": "kashika",
      "sutra_id": "1.2.15",
      "source_key": "12015",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG106_COLLECTION_GRANTHA_RESULT_SIC_KIT_OR_PREFIX_BOUNDARY",
      "text": "सिच्, आत्मनेपदेषु इति वर्तते। यमेर्धातोर्गन्धने वर्तमानात् परः सिच् प्रत्ययः किद् भवति आत्मनेपदेषु परतः। गन्धनम् = सूचनम्, परेण प्रच्छाद्यमानस्यावद्यस्याविष्करणम्। अनेकार्थत्वाद्धातूनां यमिस्तत्र वर्तते। उदायत उदायसाताम्, उदायसत। सूचितवानित्यर्थः। सिचः कित्त्वादनुनासिकलोपः ([[६.४.३७]])। <<आङो यमहनः>> [[१.३.२८]] इत्यात्मनेपदम्। गन्धन इति किम्? उदायंस्त पादम्। उदायंस्त कूपादुदकम् । उद्धृतवानित्यर्थः। सकर्मकत्वेऽपि <<समुदाङ्भ्यो यमोऽग्रन्थे>> [[१.३.७५]] इत्यात्मनेपदम्॥"
    },
    {
      "source": "kashika",
      "sutra_id": "1.2.16",
      "source_key": "12016",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG106_COLLECTION_GRANTHA_RESULT_SIC_KIT_OR_PREFIX_BOUNDARY",
      "text": "यमः सिजात्मनेपदेष्विति वर्तते। यमेर्धातोरुपयमने वर्तमानात् परः सिच् प्रत्ययो विभाषा किद् भवत्यात्मनेपदेषु परतः। उपायत कन्याम्, उपायंस्त कन्याम्। उपायत भार्याम्, उपायंस्त भार्याम्। उपयमनं स्वीकरणम्, विवाहः, दारकर्म, पाणिग्रहणमित्यर्थः। <<उपाद् यमः स्वकरणे>> (१.३.५६) इत्यात्मनेपदम्॥"
    },
    {
      "source": "kashika",
      "sutra_id": "8.3.23",
      "source_key": "83023",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG106_COLLECTION_GRANTHA_RESULT_SIC_KIT_OR_PREFIX_BOUNDARY",
      "text": "मकारान्तस्य पदस्य अनुस्वार आदेशो भवति हलि परतः। कुण्डं हसति। वनं हसति। कुण्डं याति। वनं याति। हलीत्येव — त्वमत्र। किमत्र। पदान्तस्येत्येव — गम्यते। रम्यते॥"
    },
    {
      "source": "kashika",
      "sutra_id": "8.4.59",
      "source_key": "84059",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG106_COLLECTION_GRANTHA_RESULT_SIC_KIT_OR_PREFIX_BOUNDARY",
      "text": "पदान्तस्यानुस्वारस्य ययि परतो वा परसवर्णादेशो भवति। तङ् कथञ् चित्रपक्षण् डयमानन् नभःस्थम् पुरुषोऽवधीत्, तं कथं चित्रपक्षं डयमानं नभःस्थं पुरुषोऽवधीत्॥"
    },
    {
      "source": "nyaas",
      "sutra_id": "1.3.75",
      "source_key": "13075",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG106_COLLECTION_GRANTHA_RESULT_SIC_KIT_OR_PREFIX_BOUNDARY",
      "text": "`उद्यचछति` इति। `चिकित्सा वैद्यः` इति। चिकित्साशास्त्रमधिगन्तुमुद्यमं करोतीत्यर्थः॥"
    },
    {
      "source": "kaumudi",
      "sutra_id": "1.3.75",
      "source_key": "13075",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG106_COLLECTION_GRANTHA_RESULT_SIC_KIT_OR_PREFIX_BOUNDARY",
      "text": "अग्रन्थे इति च्छेदः । व्रीहीन्संयच्छते । भारमुद्यच्छते । वस्त्रमायच्छते । अग्रन्थे किम् । उद्यच्छति वेदम् । अधिगन्तुमुद्यमं करोतीत्यर्थः । कर्त्रभिप्राये इत्येव ॥"
    },
    {
      "source": "kaumudi",
      "sutra_id": "1.2.15",
      "source_key": "12015",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG106_COLLECTION_GRANTHA_RESULT_SIC_KIT_OR_PREFIX_BOUNDARY",
      "text": "सिच्कित्सयात् । गन्धनं सूचनं परदोषाविष्करणम् । उदायत । गन्धने किम् ? उदायंस्त पादम् । आकृष्टवानित्यर्थः ॥"
    },
    {
      "source": "kaumudi",
      "sutra_id": "1.2.16",
      "source_key": "12016",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG106_COLLECTION_GRANTHA_RESULT_SIC_KIT_OR_PREFIX_BOUNDARY",
      "text": "यमः सिच् किद्वा स्याद्विवाहे । रामः सीतामुपायत । उपायंस्त वा । उदवोढेत्यर्थः । गन्धनाङ्गे उपयमे तु पूर्वविप्रतिषेधान्नित्यं कित्त्वम् ॥"
    },
    {
      "source": "balamanorama",
      "sutra_id": "1.3.75",
      "source_key": "13075",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG106_COLLECTION_GRANTHA_RESULT_SIC_KIT_OR_PREFIX_BOUNDARY",
      "text": "<<समुदाङ्भ्यो यमोऽग्रन्थे>> - समुदाङ्भ्यो । सम्, उत्, आङ् एतत्पूर्वादग्रन्थविषयकाद्यमेरात्मनेपदमित्यर्थः । व्रीहीन्संयच्छते इति । संगृह्णातीत्यर्थः । भारमुद्यच्छते इति । उदृह्णातीत्यर्थः । वरुआमायच्छते इति । कटआदौ निबध्नातीत्यर्थः । कत्र्रभिप्राये इत्येवेति । व्रीहीन् संयच्छतीति । परार्थं संगृह्णातीत्यर्थः । 'आङो यमहनः' इत्येव सिद्धे आड्ग्रहणं सकर्मकार्थम्, तस्य अकर्मकादेव प्रवृत्तेरिति बोध्यम् ।"
    },
    {
      "source": "tattvabodhini",
      "sutra_id": "1.3.75",
      "source_key": "13075",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG106_COLLECTION_GRANTHA_RESULT_SIC_KIT_OR_PREFIX_BOUNDARY",
      "text": "<<समुदाङ्भ्यो यमोऽग्रन्थे>> - समुदाङ्भ्यो ।आङो यमहनः॑ इत्येव सिद्धे आङ्पूर्वकस्य वचनं सकर्मकार्थमिति ध्वनयन्नुदाहरति —  वस्त्रमायच्छत इति ।"
    }
  ],
