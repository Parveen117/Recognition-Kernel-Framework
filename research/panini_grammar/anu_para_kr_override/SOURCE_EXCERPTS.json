  "policy": "Literal traditional fields; Karyatidesa boundary selected; alternate double-kartr references preserved without reconciliation.",
  "sutra_texts": [
    {
      "sutra_id": "1.1.5",
      "source_key": "11005",
      "text": "क्ङिति च"
    },
    {
      "sutra_id": "1.1.46",
      "source_key": "11046",
      "text": "आद्यन्तौ टकितौ"
    },
    {
      "sutra_id": "1.1.47",
      "source_key": "11047",
      "text": "मिदचोऽन्त्यात्परः"
    },
    {
      "sutra_id": "1.1.50",
      "source_key": "11050",
      "text": "स्थानेऽन्तरतमः"
    },
    {
      "sutra_id": "1.1.52",
      "source_key": "11052",
      "text": "अलोऽन्त्यस्य"
    },
    {
      "sutra_id": "1.1.56",
      "source_key": "11056",
      "text": "स्थानिवदादेशोऽनल्विधौ"
    },
    {
      "sutra_id": "1.1.57",
      "source_key": "11057",
      "text": "अचः परस्मिन् पूर्वविधौ"
    },
    {
      "sutra_id": "1.1.58",
      "source_key": "11058",
      "text": "न पदान्तद्विर्वचनवरेयलोपस्वरसवर्णानुस्वारदीर्घजश्चर्विधिषु"
    },
    {
      "sutra_id": "1.2.4",
      "source_key": "12004",
      "text": "सार्वधातुकमपित्"
    },
    {
      "sutra_id": "1.2.5",
      "source_key": "12005",
      "text": "असंयोगाल्लिट् कित्"
    },
    {
      "sutra_id": "1.2.11",
      "source_key": "12011",
      "text": "लिङ्सिचावात्मनेपदेषु"
    },
    {
      "sutra_id": "1.2.41",
      "source_key": "12041",
      "text": "अपृक्त एकाल् प्रत्ययः"
    },
    {
      "sutra_id": "1.3.2",
      "source_key": "13002",
      "text": "उपदेशेऽजनुनासिक इत्"
    },
    {
      "sutra_id": "1.3.3",
      "source_key": "13003",
      "text": "हलन्त्यम्"
    },
    {
      "sutra_id": "1.3.4",
      "source_key": "13004",
      "text": "न विभक्तौ तुस्माः"
    },
    {
      "sutra_id": "1.3.5",
      "source_key": "13005",
      "text": "आदिर्ञिटुडवः"
    },
    {
      "sutra_id": "1.3.7",
      "source_key": "13007",
      "text": "चुटू"
    },
    {
      "sutra_id": "1.3.8",
      "source_key": "13008",
      "text": "लशक्वतद्धिते"
    },
    {
      "sutra_id": "1.3.9",
      "source_key": "13009",
      "text": "तस्य लोपः"
    },
    {
      "sutra_id": "1.3.13",
      "source_key": "13013",
      "text": "भावकर्मणोः"
    },
    {
      "sutra_id": "1.3.14",
      "source_key": "13014",
      "text": "कर्तरि कर्मव्यतिहारे"
    },
    {
      "sutra_id": "1.3.17",
      "source_key": "13017",
      "text": "नेर्विशः"
    },
    {
      "sutra_id": "1.3.32",
      "source_key": "13032",
      "text": "गन्धनावक्षेपणसेवनसाहसिक्यप्रतियत्नप्रकथनोपयोगेषु कृञः"
    },
    {
      "sutra_id": "1.3.72",
      "source_key": "13072",
      "text": "स्वरितञितः कर्त्रभिप्राये क्रियाफले"
    },
    {
      "sutra_id": "1.3.77",
      "source_key": "13077",
      "text": "विभाषोपपदेन प्रतीयमाने"
    },
    {
      "sutra_id": "1.3.78",
      "source_key": "13078",
      "text": "शेषात् कर्तरि परस्मैपदम्"
    },
    {
      "sutra_id": "1.3.79",
      "source_key": "13079",
      "text": "अनुपराभ्यां कृञः"
    },
    {
      "sutra_id": "1.4.49",
      "source_key": "14049",
      "text": "कर्तुरीप्सिततमं कर्म"
    },
    {
      "sutra_id": "1.4.54",
      "source_key": "14054",
      "text": "स्वतन्त्रः कर्ता"
    },
    {
      "sutra_id": "1.4.58",
      "source_key": "14058",
      "text": "प्रादयः"
    },
    {
      "sutra_id": "1.4.59",
      "source_key": "14059",
      "text": "उपसर्गाः क्रियायोगे"
    },
    {
      "sutra_id": "1.4.60",
      "source_key": "14060",
      "text": "गतिश्च"
    },
    {
      "sutra_id": "1.4.80",
      "source_key": "14080",
      "text": "ते प्राग्धातोः"
    },
    {
      "sutra_id": "1.4.81",
      "source_key": "14081",
      "text": "छन्दसि परेऽपि"
    },
    {
      "sutra_id": "1.4.82",
      "source_key": "14082",
      "text": "व्यवहिताश्च"
    },
    {
      "sutra_id": "1.4.101",
      "source_key": "14101",
      "text": "तिङस्त्रीणि त्रीणि प्रथममध्यमोत्तमाः"
    },
    {
      "sutra_id": "1.4.102",
      "source_key": "14102",
      "text": "तान्येकवचनद्विवचनबहुवचनान्येकशः"
    },
    {
      "sutra_id": "1.4.104",
      "source_key": "14104",
      "text": "विभक्तिश्च"
    },
    {
      "sutra_id": "1.4.105",
      "source_key": "14105",
      "text": "युष्मद्युपपदे समानाधिकरणे स्थानिन्यपि मध्यमः"
    },
    {
      "sutra_id": "1.4.107",
      "source_key": "14107",
      "text": "अस्मद्युत्तमः"
    },
    {
      "sutra_id": "1.4.108",
      "source_key": "14108",
      "text": "शेषे प्रथमः"
    },
    {
      "sutra_id": "2.4.77",
      "source_key": "24077",
      "text": "गातिस्थाघुपाभूभ्यः सिचः परस्मैपदेषु"
    },
    {
      "sutra_id": "2.4.78",
      "source_key": "24078",
      "text": "विभाषा घ्राधेट्शाच्छासः"
    },
    {
      "sutra_id": "2.4.79",
      "source_key": "24079",
      "text": "तनादिभ्यस्तथासोः"
    },
    {
      "sutra_id": "2.4.85",
      "source_key": "24085",
      "text": "लुटः प्रथमस्य डारौरसः"
    },
    {
      "sutra_id": "3.1.33",
      "source_key": "31033",
      "text": "स्यतासी लृलुटोः"
    },
    {
      "sutra_id": "3.1.43",
      "source_key": "31043",
      "text": "च्लि लुङि"
    },
    {
      "sutra_id": "3.1.44",
      "source_key": "31044",
      "text": "च्लेः सिच्"
    },
    {
      "sutra_id": "3.1.45",
      "source_key": "31045",
      "text": "शल इगुपधादनिटः क्सः"
    },
    {
      "sutra_id": "3.1.46",
      "source_key": "31046",
      "text": "श्लिष आलिङ्गने"
    },
    {
      "sutra_id": "3.1.47",
      "source_key": "31047",
      "text": "न दृशः"
    },
    {
      "sutra_id": "3.1.48",
      "source_key": "31048",
      "text": "णिश्रिद्रुस्रुभ्यः कर्तरि चङ्"
    },
    {
      "sutra_id": "3.1.49",
      "source_key": "31049",
      "text": "विभाषा धेट्श्व्योः"
    },
    {
      "sutra_id": "3.1.50",
      "source_key": "31050",
      "text": "गुपेश्छन्दसि"
    },
    {
      "sutra_id": "3.1.51",
      "source_key": "31051",
      "text": "नोनयतिध्वनयत्येलयत्यर्दयतिभ्यः"
    },
    {
      "sutra_id": "3.1.52",
      "source_key": "31052",
      "text": "अस्यतिवक्तिख्यातिभ्योऽङ्"
    },
    {
      "sutra_id": "3.1.53",
      "source_key": "31053",
      "text": "लिपिसिचिह्वश्च"
    },
    {
      "sutra_id": "3.1.54",
      "source_key": "31054",
      "text": "आत्मनेपदेष्वन्यतरस्याम्"
    },
    {
      "sutra_id": "3.1.55",
      "source_key": "31055",
      "text": "पुषादिद्युताद्यॢदितः परस्मैपदेषु"
    },
    {
      "sutra_id": "3.1.56",
      "source_key": "31056",
      "text": "सर्त्तिशास्त्यर्तिभ्यश्च"
    },
    {
      "sutra_id": "3.1.57",
      "source_key": "31057",
      "text": "इरितो वा"
    },
    {
      "sutra_id": "3.1.58",
      "source_key": "31058",
      "text": "जॄस्तम्भुम्रुचुम्लुचुग्रुचुग्लुचुग्लुञ्चुश्विभ्यश्च"
    },
    {
      "sutra_id": "3.1.59",
      "source_key": "31059",
      "text": "कृमृदृरुहिभ्यश्छन्दसि"
    },
    {
      "sutra_id": "3.1.60",
      "source_key": "31060",
      "text": "चिण् ते पदः"
    },
    {
      "sutra_id": "3.1.61",
      "source_key": "31061",
      "text": "दीपजनबुधपूरितायिप्यायिभ्योऽन्यतरस्याम्"
    },
    {
      "sutra_id": "3.1.62",
      "source_key": "31062",
      "text": "अचः कर्मकर्तरि"
    },
    {
      "sutra_id": "3.1.63",
      "source_key": "31063",
      "text": "दुहश्च"
    },
    {
      "sutra_id": "3.1.64",
      "source_key": "31064",
      "text": "न रुधः"
    },
    {
      "sutra_id": "3.1.65",
      "source_key": "31065",
      "text": "तपोऽनुतापे च"
    },
    {
      "sutra_id": "3.1.66",
      "source_key": "31066",
      "text": "चिण् भावकर्मणोः"
    },
    {
      "sutra_id": "3.1.68",
      "source_key": "31068",
      "text": "कर्तरि शप्"
    },
    {
      "sutra_id": "3.1.73",
      "source_key": "31073",
      "text": "स्वादिभ्यः श्नुः"
    },
    {
      "sutra_id": "3.1.77",
      "source_key": "31077",
      "text": "तुदादिभ्यः शः"
    },
    {
      "sutra_id": "3.1.78",
      "source_key": "31078",
      "text": "रुधादिभ्यः श्नम्"
    },
    {
      "sutra_id": "3.1.79",
      "source_key": "31079",
      "text": "तनादिकृञ्भ्य उः"
    },
    {
      "sutra_id": "3.1.87",
      "source_key": "31087",
      "text": "कर्मवत् कर्मणा तुल्यक्रियः"
    },
    {
      "sutra_id": "3.2.110",
      "source_key": "32110",
      "text": "लुङ्"
    },
    {
      "sutra_id": "3.2.111",
      "source_key": "32111",
      "text": "अनद्यतने लङ्"
    },
    {
      "sutra_id": "3.2.115",
      "source_key": "32115",
      "text": "परोक्षे लिट्"
    },
    {
      "sutra_id": "3.2.123",
      "source_key": "32123",
      "text": "वर्तमाने लट्"
    },
    {
      "sutra_id": "3.3.13",
      "source_key": "33013",
      "text": "लृट् शेषे च"
    },
    {
      "sutra_id": "3.3.15",
      "source_key": "33015",
      "text": "अनद्यतने लुट्"
    },
    {
      "sutra_id": "3.3.139",
      "source_key": "33139",
      "text": "लिङ्निमित्ते लृङ् क्रियातिपत्तौ"
    },
    {
      "sutra_id": "3.3.147",
      "source_key": "33147",
      "text": "जातुयदोर्लिङ्"
    },
    {
      "sutra_id": "3.3.161",
      "source_key": "33161",
      "text": "विधिनिमन्त्रणामन्त्रणाधीष्टसंप्रश्नप्रार्थनेषु लिङ्"
    },
    {
      "sutra_id": "3.3.162",
      "source_key": "33162",
      "text": "लोट् च"
    },
    {
      "sutra_id": "3.3.173",
      "source_key": "33173",
      "text": "आशिषि लिङ्लोटौ"
    },
    {
      "sutra_id": "3.4.69",
      "source_key": "34069",
      "text": "लः कर्मणि च भावे चाकर्मकेभ्यः"
    },
    {
      "sutra_id": "3.4.77",
      "source_key": "34077",
      "text": "लस्य"
    },
    {
      "sutra_id": "3.4.78",
      "source_key": "34078",
      "text": "तिप्तस्झिसिप्थस्थमिब्वस्मस् तातांझथासाथांध्वमिड्वहिमहिङ्"
    },
    {
      "sutra_id": "3.4.79",
      "source_key": "34079",
      "text": "टित आत्मनेपदानां टेरे"
    },
    {
      "sutra_id": "3.4.80",
      "source_key": "34080",
      "text": "थासस्से"
    },
    {
      "sutra_id": "3.4.81",
      "source_key": "34081",
      "text": "लिटस्तझयोरेशिरेच्"
    },
    {
      "sutra_id": "3.4.82",
      "source_key": "34082",
      "text": "परस्मैपदानां णलतुसुस्थलथुसणल्वमाः"
    },
    {
      "sutra_id": "3.4.83",
      "source_key": "34083",
      "text": "विदो लटो वा"
    },
    {
      "sutra_id": "3.4.84",
      "source_key": "34084",
      "text": "ब्रुवः पञ्चानामादित आहो ब्रुवः"
    },
    {
      "sutra_id": "3.4.85",
      "source_key": "34085",
      "text": "लोटो लङ्वत्"
    },
    {
      "sutra_id": "3.4.86",
      "source_key": "34086",
      "text": "एरुः"
    },
    {
      "sutra_id": "3.4.87",
      "source_key": "34087",
      "text": "सेर्ह्यपिच्च"
    },
    {
      "sutra_id": "3.4.88",
      "source_key": "34088",
      "text": "वा छन्दसि"
    },
    {
      "sutra_id": "3.4.89",
      "source_key": "34089",
      "text": "मेर्निः"
    },
    {
      "sutra_id": "3.4.90",
      "source_key": "34090",
      "text": "आमेतः"
    },
    {
      "sutra_id": "3.4.91",
      "source_key": "34091",
      "text": "सवाभ्यां वामौ"
    },
    {
      "sutra_id": "3.4.92",
      "source_key": "34092",
      "text": "आडुत्तमस्य पिच्च"
    },
    {
      "sutra_id": "3.4.93",
      "source_key": "34093",
      "text": "एत ऐ"
    },
    {
      "sutra_id": "3.4.98",
      "source_key": "34098",
      "text": "स उत्तमस्य"
    },
    {
      "sutra_id": "3.4.99",
      "source_key": "34099",
      "text": "नित्यं ङितः"
    },
    {
      "sutra_id": "3.4.100",
      "source_key": "34100",
      "text": "इतश्च"
    },
    {
      "sutra_id": "3.4.101",
      "source_key": "34101",
      "text": "तस्थस्थमिपां तांतंतामः"
    },
    {
      "sutra_id": "3.4.102",
      "source_key": "34102",
      "text": "लिङस्सीयुट्"
    },
    {
      "sutra_id": "3.4.103",
      "source_key": "34103",
      "text": "यासुट् परस्मैपदेषूदात्तो ङिच्च"
    },
    {
      "sutra_id": "3.4.104",
      "source_key": "34104",
      "text": "किदाशिषि"
    },
    {
      "sutra_id": "3.4.105",
      "source_key": "34105",
      "text": "झस्य रन्"
    },
    {
      "sutra_id": "3.4.106",
      "source_key": "34106",
      "text": "इटोऽत्"
    },
    {
      "sutra_id": "3.4.107",
      "source_key": "34107",
      "text": "सुट् तिथोः"
    },
    {
      "sutra_id": "3.4.108",
      "source_key": "34108",
      "text": "झेर्जुस्"
    },
    {
      "sutra_id": "3.4.109",
      "source_key": "34109",
      "text": "सिजभ्यस्तविदिभ्यश्च"
    },
    {
      "sutra_id": "3.4.113",
      "source_key": "34113",
      "text": "तिङ्शित्सार्वधातुकम्"
    },
    {
      "sutra_id": "3.4.114",
      "source_key": "34114",
      "text": "आर्धधातुकं शेषः"
    },
    {
      "sutra_id": "3.4.115",
      "source_key": "34115",
      "text": "लिट् च"
    },
    {
      "sutra_id": "3.4.116",
      "source_key": "34116",
      "text": "लिङाशिषि"
    },
    {
      "sutra_id": "6.1.8",
      "source_key": "61008",
      "text": "लिटि धातोरनभ्यासस्य"
    },
    {
      "sutra_id": "6.1.66",
      "source_key": "61066",
      "text": "लोपो व्योर्वलि"
    },
    {
      "sutra_id": "6.1.68",
      "source_key": "61068",
      "text": "हल्ङ्याब्भ्यो दीर्घात् सुतिस्यपृक्तं हल्"
    },
    {
      "sutra_id": "6.1.77",
      "source_key": "61077",
      "text": "इको यणचि"
    },
    {
      "sutra_id": "6.1.78",
      "source_key": "61078",
      "text": "एचोऽयवायावः"
    },
    {
      "sutra_id": "6.1.87",
      "source_key": "61087",
      "text": "आद्गुणः"
    },
    {
      "sutra_id": "6.1.97",
      "source_key": "61097",
      "text": "अतो गुणे"
    },
    {
      "sutra_id": "6.1.101",
      "source_key": "61101",
      "text": "अकः सवर्णे दीर्घः"
    },
    {
      "sutra_id": "6.4.23",
      "source_key": "64023",
      "text": "श्नान्नलोपः"
    },
    {
      "sutra_id": "6.4.71",
      "source_key": "64071",
      "text": "लुङ्लङ्लृङ्क्ष्वडुदात्तः"
    },
    {
      "sutra_id": "6.4.74",
      "source_key": "64074",
      "text": "न माङ्योगे"
    },
    {
      "sutra_id": "6.4.77",
      "source_key": "64077",
      "text": "अचि श्नुधातुभ्रुवां य्वोरियङुवङौ"
    },
    {
      "sutra_id": "6.4.82",
      "source_key": "64082",
      "text": "एरनेकाचोऽसंयोगपूर्वस्य"
    },
    {
      "sutra_id": "6.4.87",
      "source_key": "64087",
      "text": "हुश्नुवोः सार्वधातुके"
    },
    {
      "sutra_id": "6.4.105",
      "source_key": "64105",
      "text": "अतो हेः"
    },
    {
      "sutra_id": "6.4.106",
      "source_key": "64106",
      "text": "उतश्च प्रत्ययादसंयोगपूर्वात्"
    },
    {
      "sutra_id": "6.4.107",
      "source_key": "64107",
      "text": "लोपश्चास्यान्यतरस्यां म्वोः"
    },
    {
      "sutra_id": "6.4.108",
      "source_key": "64108",
      "text": "नित्यं करोतेः"
    },
    {
      "sutra_id": "6.4.109",
      "source_key": "64109",
      "text": "ये च"
    },
    {
      "sutra_id": "6.4.110",
      "source_key": "64110",
      "text": "अत उत् सार्वधातुके"
    },
    {
      "sutra_id": "6.4.111",
      "source_key": "64111",
      "text": "श्नसोरल्लोपः"
    },
    {
      "sutra_id": "6.4.120",
      "source_key": "64120",
      "text": "अत एकहल्मध्येऽनादेशादेर्लिटि"
    },
    {
      "sutra_id": "6.4.121",
      "source_key": "64121",
      "text": "थलि च सेटि"
    },
    {
      "sutra_id": "6.4.143",
      "source_key": "64143",
      "text": "टेः"
    },
    {
      "sutra_id": "7.1.3",
      "source_key": "71003",
      "text": "झोऽन्तः"
    },
    {
      "sutra_id": "7.1.5",
      "source_key": "71005",
      "text": "आत्मनेपदेष्वनतः"
    },
    {
      "sutra_id": "7.1.35",
      "source_key": "71035",
      "text": "तुह्योस्तातङ्ङाशिष्यन्यतरस्याम्"
    },
    {
      "sutra_id": "7.1.91",
      "source_key": "71091",
      "text": "णलुत्तमो वा"
    },
    {
      "sutra_id": "7.2.1",
      "source_key": "72001",
      "text": "सिचि वृद्धिः परस्मैपदेषु"
    },
    {
      "sutra_id": "7.2.2",
      "source_key": "72002",
      "text": "अतो ल्रान्तस्य"
    },
    {
      "sutra_id": "7.2.3",
      "source_key": "72003",
      "text": "वदव्रजहलन्तस्याचः"
    },
    {
      "sutra_id": "7.2.4",
      "source_key": "72004",
      "text": "नेटि"
    },
    {
      "sutra_id": "7.2.5",
      "source_key": "72005",
      "text": "ह्म्यन्तक्षणश्वसजागृणिश्व्येदिताम्"
    },
    {
      "sutra_id": "7.2.6",
      "source_key": "72006",
      "text": "ऊर्णोतेर्विभाषा"
    },
    {
      "sutra_id": "7.2.7",
      "source_key": "72007",
      "text": "अतो हलादेर्लघोः"
    },
    {
      "sutra_id": "7.2.10",
      "source_key": "72010",
      "text": "एकाच उपदेशेऽनुदात्तात्"
    },
    {
      "sutra_id": "7.2.13",
      "source_key": "72013",
      "text": "कृसृभृवृस्तुद्रुस्रुश्रुवो लिटि"
    },
    {
      "sutra_id": "7.2.35",
      "source_key": "72035",
      "text": "आर्धधातुकस्येड् वलादेः"
    },
    {
      "sutra_id": "7.2.42",
      "source_key": "72042",
      "text": "लिङ्सिचोरात्मनेपदेषु"
    },
    {
      "sutra_id": "7.2.61",
      "source_key": "72061",
      "text": "अचस्तास्वत् थल्यनिटो नित्यम्"
    },
    {
      "sutra_id": "7.2.62",
      "source_key": "72062",
      "text": "उपदेशेऽत्वतः"
    },
    {
      "sutra_id": "7.2.63",
      "source_key": "72063",
      "text": "ऋतो भारद्वाजस्य"
    },
    {
      "sutra_id": "7.2.70",
      "source_key": "72070",
      "text": "ऋद्धनोः स्ये"
    },
    {
      "sutra_id": "7.2.79",
      "source_key": "72079",
      "text": "लिङः सलोपोऽनन्त्यस्य"
    },
    {
      "sutra_id": "7.2.80",
      "source_key": "72080",
      "text": "अतो येयः"
    },
    {
      "sutra_id": "7.2.81",
      "source_key": "72081",
      "text": "आतो ङितः"
    },
    {
      "sutra_id": "7.2.115",
      "source_key": "72115",
      "text": "अचो ञ्णिति"
    },
    {
      "sutra_id": "7.2.116",
      "source_key": "72116",
      "text": "अत उपधायाः"
    },
    {
      "sutra_id": "7.3.72",
      "source_key": "73072",
      "text": "क्सस्याचि"
    },
    {
      "sutra_id": "7.3.73",
      "source_key": "73073",
      "text": "लुग्वा दुहदिहलिहगुहामात्मनेपदे दन्त्ये"
    },
    {
      "sutra_id": "7.3.84",
      "source_key": "73084",
      "text": "सार्वधातुकार्धधातुकयोः"
    },
    {
      "sutra_id": "7.3.86",
      "source_key": "73086",
      "text": "पुगन्तलघूपधस्य च"
    },
    {
      "sutra_id": "7.3.96",
      "source_key": "73096",
      "text": "अस्तिसिचोऽपृक्ते"
    },
    {
      "sutra_id": "7.3.101",
      "source_key": "73101",
      "text": "अतो दीर्घो यञि"
    },
    {
      "sutra_id": "7.4.25",
      "source_key": "74025",
      "text": "अकृत्सार्वधातुकयोर्दीर्घः"
    },
    {
      "sutra_id": "7.4.28",
      "source_key": "74028",
      "text": "रिङ् शयग्लिङ्क्षु"
    },
    {
      "sutra_id": "7.4.50",
      "source_key": "74050",
      "text": "तासस्त्योर्लोपः"
    },
    {
      "sutra_id": "7.4.51",
      "source_key": "74051",
      "text": "रि च"
    },
    {
      "sutra_id": "7.4.52",
      "source_key": "74052",
      "text": "ह एति"
    },
    {
      "sutra_id": "7.4.59",
      "source_key": "74059",
      "text": "ह्रस्वः"
    },
    {
      "sutra_id": "7.4.60",
      "source_key": "74060",
      "text": "हलादिः शेषः"
    },
    {
      "sutra_id": "7.4.62",
      "source_key": "74062",
      "text": "कुहोश्चुः"
    },
    {
      "sutra_id": "7.4.66",
      "source_key": "74066",
      "text": "उरत्"
    },
    {
      "sutra_id": "8.2.1",
      "source_key": "82001",
      "text": "पूर्वत्रासिद्धम्"
    },
    {
      "sutra_id": "8.2.23",
      "source_key": "82023",
      "text": "संयोगान्तस्य लोपः"
    },
    {
      "sutra_id": "8.2.26",
      "source_key": "82026",
      "text": "झलो झलि"
    },
    {
      "sutra_id": "8.2.27",
      "source_key": "82027",
      "text": "ह्रस्वादङ्गात्"
    },
    {
      "sutra_id": "8.2.28",
      "source_key": "82028",
      "text": "इट ईटि"
    },
    {
      "sutra_id": "8.2.29",
      "source_key": "82029",
      "text": "स्कोः संयोगाद्योरन्ते च"
    },
    {
      "sutra_id": "8.2.30",
      "source_key": "82030",
      "text": "चोः कुः"
    },
    {
      "sutra_id": "8.2.36",
      "source_key": "82036",
      "text": "व्रश्चभ्रस्जसृजमृजयजराजभ्राजच्छशां षः"
    },
    {
      "sutra_id": "8.2.39",
      "source_key": "82039",
      "text": "झलां जशोऽन्ते"
    },
    {
      "sutra_id": "8.2.41",
      "source_key": "82041",
      "text": "षढोः कः सि"
    },
    {
      "sutra_id": "8.2.66",
      "source_key": "82066",
      "text": "ससजुषो रुः"
    },
    {
      "sutra_id": "8.2.77",
      "source_key": "82077",
      "text": "हलि च"
    },
    {
      "sutra_id": "8.2.79",
      "source_key": "82079",
      "text": "न भकुर्छुराम्"
    },
    {
      "sutra_id": "8.3.15",
      "source_key": "83015",
      "text": "खरवसानयोर्विसर्जनीयः"
    },
    {
      "sutra_id": "8.3.24",
      "source_key": "83024",
      "text": "नश्चापदान्तस्य झलि"
    },
    {
      "sutra_id": "8.3.55",
      "source_key": "83055",
      "text": "अपदान्तस्य मूर्धन्यः"
    },
    {
      "sutra_id": "8.3.57",
      "source_key": "83057",
      "text": "इण्कोः"
    },
    {
      "sutra_id": "8.3.59",
      "source_key": "83059",
      "text": "आदेशप्रत्यययोः"
    },
    {
      "sutra_id": "8.3.78",
      "source_key": "83078",
      "text": "इणः षीध्वंलुङ्लिटां धोऽङ्गात्"
    },
    {
      "sutra_id": "8.3.79",
      "source_key": "83079",
      "text": "विभाषेटः"
    },
    {
      "sutra_id": "8.4.1",
      "source_key": "84001",
      "text": "रषाभ्यां नो णः समानपदे"
    },
    {
      "sutra_id": "8.4.2",
      "source_key": "84002",
      "text": "अट्कुप्वाङ्नुम्व्यवायेऽपि"
    },
    {
      "sutra_id": "8.4.14",
      "source_key": "84014",
      "text": "उपसर्गादसमासेऽपि णोपदेशस्य"
    },
    {
      "sutra_id": "8.4.15",
      "source_key": "84015",
      "text": "हिनुमीना"
    },
    {
      "sutra_id": "8.4.17",
      "source_key": "84017",
      "text": "नेर्गदनदपतपदघुमास्यतिहन्तियातिवातिद्रातिप्सातिवपतिवहतिशाम्यतिचिनोतिदेग्धिषु च"
    },
    {
      "sutra_id": "8.4.18",
      "source_key": "84018",
      "text": "शेषे विभाषाऽकखादावषान्त उपदेशे"
    },
    {
      "sutra_id": "8.4.37",
      "source_key": "84037",
      "text": "पदान्तस्य"
    },
    {
      "sutra_id": "8.4.38",
      "source_key": "84038",
      "text": "पदव्यवायेऽपि"
    },
    {
      "sutra_id": "8.4.39",
      "source_key": "84039",
      "text": "क्षुभ्नाऽऽदिषु च"
    },
    {
      "sutra_id": "8.4.41",
      "source_key": "84041",
      "text": "ष्टुना ष्टुः"
    },
    {
      "sutra_id": "8.4.53",
      "source_key": "84053",
      "text": "झलां जश् झशि"
    },
    {
      "sutra_id": "8.4.54",
      "source_key": "84054",
      "text": "अभ्यासे चर्च"
    },
    {
      "sutra_id": "8.4.56",
      "source_key": "84056",
      "text": "वाऽवसाने"
    },
    {
      "sutra_id": "8.4.58",
      "source_key": "84058",
      "text": "अनुस्वारस्य ययि परसवर्णः"
    },
    {
      "sutra_id": "8.4.65",
      "source_key": "84065",
      "text": "झरो झरि सवर्णे"
    }
  ],
  "commentary_entries": [
    {
      "source": "kashika",
      "sutra_id": "1.3.3",
      "source_key": "13003",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG108_DIRECT_P_EXCEPTION_VOICE_SOURCE_POLICY_OR_PREFIX_BOUNDARY",
      "text": "उपदेशे इति वर्त्तते। अन्ते भवमन्त्यम्। धात्वादेः समुदायस्य यदन्त्यं हल्, तदित्संज्ञं भवति। अइउण् — णकारः। ऋऌक् — ककारः। एओङ् — ङकारः। ऐऔच् — चकारः। उपदेश इत्येव — अग्निचित्। सोमसुत्। हस्य ल् हलिति द्वितीयमत्र हल्ग्रहणं तन्त्रेणोपात्तं द्रष्टव्यम्। तेन प्रत्याहारपाठे हलित्यत्र लकारस्येत्संज्ञा क्रियते। तथा च सति हलन्त्यम् [[१.३.३]] इत्यत्र प्रत्याहारे नेतरेतराश्रयदोषो भवति॥"
    },
    {
      "source": "kashika",
      "sutra_id": "1.3.5",
      "source_key": "13005",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG108_DIRECT_P_EXCEPTION_VOICE_SOURCE_POLICY_OR_PREFIX_BOUNDARY",
      "text": "इदिति वर्तते। आदिशब्दः प्रत्येकमभिसंबध्यते। ञि टु डु इत्येतेषां समुदायानामादितो वर्तमानानामित्संज्ञा भवति। ञिमिदा (धा.पा. ७४३) — मिन्नः। ञिधृषा (धा.पा. १२६९) — धृष्टः। ञिक्ष्विदा (धा.पा. ७४४) — क्ष्विण्णः। ञिइन्धी (धा.पा. १४४८) — इद्धः। टुवेपृ (धा.पा. ३६७)— वेपथुः [[३.३.८९]]। टुओश्वि (धा.पा. १०१०) — श्वयथुः। डुपचष् (धा.पा. ९९६) — पक्त्रिमम् [[३.३.८८]]। डुवप् (धा.पा. १००३)— उप्त्रिमम्। डुकृञ् (धा.पा. १४७२) — कृत्रिमम्। आदिरिति किम्? पटूयति [[५.१.१२२]]। कण्डूयति [[३.१.२७]]। उपदेशे इत्येव — ञिकारीयति॥"
    },
    {
      "source": "kashika",
      "sutra_id": "1.3.9",
      "source_key": "13009",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG108_DIRECT_P_EXCEPTION_VOICE_SOURCE_POLICY_OR_PREFIX_BOUNDARY",
      "text": "तस्य इत्संज्ञकस्य लोपो भवति। तथा चैवोदाहृतम्। \"तस्य\"ग्रहणं सर्वलोपार्थम्। <<अलोऽन्त्यस्य>> [[१.१.५२]] मा भूत् — <<आदिर्ञिटुडवः>> [[१.३.५]] इति॥"
    },
    {
      "source": "kashika",
      "sutra_id": "1.3.13",
      "source_key": "13013",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG108_DIRECT_P_EXCEPTION_VOICE_SOURCE_POLICY_OR_PREFIX_BOUNDARY",
      "text": "<<लः कर्मणि च भावे चाकर्मकेभ्यः>> [[३.४.६९]] इति भावकर्मणोर्विहितस्य लस्य तिबादयः सामान्येन वक्ष्यन्ते, तत्रेदमुच्यते, भावे कर्मणि चात्मनेपदं भवति। भावे — ग्लायते भवता। सुप्यते भवता। आस्यते भवता। कर्मणि — क्रियते कटः। ह्रियते भारः। कर्मकर्तरि — लूयते केदारः स्वयमेवेति परस्मैपदं न भवति। तस्य विधाने द्वितीयं कर्तृग्रहणमनुवर्तते। तेन कर्तैव यः कर्ता तत्र परस्मैपदं भवति॥"
    },
    {
      "source": "kashika",
      "sutra_id": "1.3.32",
      "source_key": "13032",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG108_DIRECT_P_EXCEPTION_VOICE_SOURCE_POLICY_OR_PREFIX_BOUNDARY",
      "text": "कर्त्रभिप्राये क्रियाफले सिद्धमेवात्मनेपदम्। अकर्त्रभिप्रायार्थोऽयमारम्भः। गन्धनादिष्वर्थेषु वर्तमानात् करोतेरात्मनेपदं भवति। गन्धनमपकारप्रयुक्तं हिंसात्मकं सूचनम्। तथाहि — <<बस्त गन्ध अर्दने>>, (धा.पा. १६८४,१६८५) <<अर्द हिंसायाम्>> (धा.पा. १८२९) इति चुरादौ पठ्यते। अवक्षेपणं भर्त्सनम्। सेवनमनुवृत्तिः। साहसिक्यं साहसिकं कर्म। प्रतियत्नः सतो गुणान्तराधानम्। प्रकथनं प्रकर्षेण कथनम्। उपयोगो धर्मादिप्रयोजनो विनियोगः। गन्धने तावत् — उत्कुरुते। उदाकुरुते। सूचयतीत्यर्थः। अवक्षेपणे — श्येनो वर्त्तिकामुदाकुरुते। भर्त्सयतीत्यर्थः। सेवने — गणकानुपकुरुते। महामात्रानुपकुरुते। सेवते इत्यर्थः। साहसिक्येपरदारान् प्रकुरुते। तेषु सहसा प्रवर्तते इत्यर्थः। प्रतियत्ने — एधोदकस्योपस्कुरुते। काण्डं गुडस्योपस्कुरुते। तस्य सतो गुणान्तराधानं करोतीत्यर्थः। षष्ठीसुटौ करोतेः प्रतियत्न एव विधीयते ([[२.३.५३]],  [[६.१.१३९]]) ।। प्रकथने — गाथाः प्रकुरुते। जनापवादान् प्रकुरुते। प्रकर्षेण कथयतीत्यर्थः। उपयोगे — शतं प्रकुरुते। सहस्रं प्रकुरुते। धर्मार्थं शतं विनियुङ्क्त इत्यर्थः। एतेष्विति किम् ? कटं करोति॥"
    },
    {
      "source": "kashika",
      "sutra_id": "1.3.72",
      "source_key": "13072",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG108_DIRECT_P_EXCEPTION_VOICE_SOURCE_POLICY_OR_PREFIX_BOUNDARY",
      "text": "णेरिति निवृत्तम्। शेषात् कर्तरि परस्मैपदे ([[१.३.७८]]) प्राप्ते, स्वरितेतो ये धातवो ञितश्च तेभ्य आत्मनेपदं भवति, कर्तारं चेत्क्रियाफलमभिप्रैति। क्रियायाः फलं क्रियाफलं प्रधानभूतम्, यदर्थमसौ क्रियारभ्यते तच्चेत् कर्तुर्लकारवाच्यस्य भवति। यजते। पचते। ञितः खल्वपि — सुनुते। कुरुते। स्वर्गादि प्रधानफलमिह कर्तारमभिप्रैति। कर्त्रभिप्राये इति किम्? यजन्ति याजकाः। पचन्ति पाचकाः। कुर्वन्ति कर्मकराः। यद्यपि दक्षिणा भृतिश्च कर्तुः फलमिहास्ति, तथापि न तदर्थः क्रियारम्भः॥"
    },
    {
      "source": "kashika",
      "sutra_id": "1.3.77",
      "source_key": "13077",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG108_DIRECT_P_EXCEPTION_VOICE_SOURCE_POLICY_OR_PREFIX_BOUNDARY",
      "text": "<<स्वरितञितः०>> [[१.३.७२]] इति पञ्चभिः सूत्रैरात्मनेपदं कर्त्रभिप्राये क्रियाफले द्योतिते विहितम्, तदुपपदेन द्योतिते न प्राप्नोतीति वचनमारभ्यते। समीपे श्रूयमाणं शब्दान्तरमुपपदम्, तेन प्रतीयमाने कर्त्रभिप्राये क्रियाफले विभाषाऽऽत्मनेपदं भवति। स्वं यज्ञं यजति, स्वं यज्ञं यजते। स्वं कटं करोति, स्वं कटं कुरुते। स्वं पुत्रमपवदति, स्वं पुत्रमपवदते। एवं पञ्चसूत्र्यामुदाहार्यम्॥"
    },
    {
      "source": "kashika",
      "sutra_id": "1.3.78",
      "source_key": "13078",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG108_DIRECT_P_EXCEPTION_VOICE_SOURCE_POLICY_OR_PREFIX_BOUNDARY",
      "text": "पूर्वेण प्रकरणेनात्मनेपदनियमः कृतः, न परस्मैपदनियमः। तत् सर्वतः प्राप्नोति, तदर्थमिदमुच्यते। येभ्यो धातुभ्यो येन विशेषणेनात्मनेपदमुक्तं ततो यदन्यत् स शेषः। शेषात् कर्तरि परस्मैपदं भवति, शेषादेव नान्यस्मात्। <<अनुदात्तङित आत्मनेपदम्>> [[१.३.१२]] उक्तम् — आस्ते। शेते। ततोऽन्यत्र परस्मैपदं भवति — याति। वाति। <<नेर्विशः>> [[१.३.१७]] आत्मनेपदमुक्तम् — निविशते। ततोऽन्यत्र परस्मैपदम् — आविशति। प्रविशति। कर्तरीति किम्? पच्यते। गम्यते। कर्मकर्तरि कस्मात्परस्मैपदं न भवति — पच्यत ओदनः स्वयमेव? <<कर्तरि कर्मव्यतिहारे>> [[१.३.१४]] इति द्वितीयं कर्तृग्रहणमनुवर्तते। तेन कर्तैव यः कर्ता (म० भा० [[१.३.३८]]), तत्र परस्मैपदं भवति, कर्मकर्तरि न भवति॥"
    },
    {
      "source": "kashika",
      "sutra_id": "1.3.79",
      "source_key": "13079",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG108_DIRECT_P_EXCEPTION_VOICE_SOURCE_POLICY_OR_PREFIX_BOUNDARY",
      "text": "कर्त्रभिप्राये क्रियाफले गन्धनादिषु च करोतेरात्मनेपदं विहितम्, तदपवादः परस्मैपदं विधीयते। अनु परा इत्येवंपूर्वात् करोतेः परस्मैपदं भवति। अनुकरोति। पराकरोति॥"
    },
    {
      "source": "kashika",
      "sutra_id": "3.1.87",
      "source_key": "31087",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG108_DIRECT_P_EXCEPTION_VOICE_SOURCE_POLICY_OR_PREFIX_BOUNDARY",
      "text": "कर्मणि क्रिया कर्म, कर्मस्थया क्रियया तुल्यक्रियःकर्ता कर्मवद् भवति। यस्मिन् कर्मणि कर्तृभूतेऽपि तद्वत् क्रिया लक्ष्यते यथा कर्मणि, स कर्ता कर्मवद् भवति। कर्माश्रयाणि कार्याणि प्रतिपद्यते। <<कर्तरि शप्>> (३.१.६८) इति कर्तृग्रहणमिहानुवृत्तं प्रथमया विपरिणम्यते। यगात्मनेपदचिण्चिण्वद्भावाः प्रयोजनम्। भिद्यते काष्ठं स्वयमेव। अभेदि काष्ठं स्वयमेव। कारिष्यते कटः स्वयमेव। वत्करणं स्वाश्रयमपि यथा स्यात्। भिद्यते कुसूलेनेति। अकर्मकाणां भावे लः सिद्धो भवति। <<लिङ्याशिष्यङ्>> (३.१.८६) इति द्विलकारको निर्देशः। तत्र लानुवृत्तेर्लान्तस्य कर्ता कर्मवद् भवतीति कुसूलाद् द्वितीया न भवति। कर्मणेति किम्? करणाधिकरणाभ्यां तुल्यक्रियस्य मा भूत् — साध्वसिश्छिनत्ति। साधु स्थाली पचति। धात्वधिकारात् समाने धातौ कर्मवद्भावः। इह न भवति — पचत्योदनं देवदत्तः, राध्यत्योदनः स्वयमेवेति। कर्मस्थभावकानां कर्मस्थक्रियाणां च कर्ता कर्मवद् भवति, न कर्तृस्थभावकानां न वा कर्तृस्थक्रियाणाम्।\n\nकर्मस्थः पचतेर्भावः कर्मस्था च भिदेः क्रिया ।\n\nमासासिभावः कर्तृस्थः कर्तृस्था च गमेः क्रिया॥"
    },
    {
      "source": "kashika",
      "sutra_id": "6.1.77",
      "source_key": "61077",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG108_DIRECT_P_EXCEPTION_VOICE_SOURCE_POLICY_OR_PREFIX_BOUNDARY",
      "text": "अचि परत इको यणादेशो भवति। दध्यत्र। मध्वत्र। कर्त्रर्थम्। हर्त्रर्थम्। लाकृतिः॥ इकः प्लुतपूर्वस्य सवर्णदीर्घबाधनार्थं यणादेशो वक्तव्यः॥ भो३ इ इन्द्रम्। भो३यिन्द्रम्। अचीति चायमधिकारः  <<संप्रसारणाच्च>> [[६.१.१०८]] इति यावत्॥"
    },
    {
      "source": "kashika",
      "sutra_id": "6.1.101",
      "source_key": "61101",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG108_DIRECT_P_EXCEPTION_VOICE_SOURCE_POLICY_OR_PREFIX_BOUNDARY",
      "text": "अकः सवर्णेऽचि परतः पूर्वपरयोः स्थाने दीर्घ एकादेशो भवति। दण्डाग्रम्। दधीन्द्रः। मधूदके। होतश्यः। अक इति किम् ? अग्नये। सवर्ण इति किम् ? दध्यत्र। अचीत्येव — कुमारी शेते। <<नाज्झलौ>> [[१.१.१०]] इत्यत्र यदजिति प्रत्याहारग्रहणं तत्र ग्रहणकशास्त्रस्यानभिनिर्वृत्तत्वात् सवर्णा न गृह्यन्त इति सवर्णत्वमीकारशकारयोरप्रतिषिद्धम्॥ सवर्णदीर्घत्व ऋति ऋ वा वचनम्॥ ऋति सवर्णे परभूते तत्र ऋ वा भवतीति वक्त व्यम्। होतृ ऋकारो होतृकारः। यदा न ऋ तदा दीर्घ एव होतकारः॥ ऌति ऌ वा वचनम्॥ ऌति सवर्णे परतो ऌ वा भवतीति वक्त व्यम्॥ होतृ ऌकारो होत्ऌकारः, होतकारः। ऋकारऌकारयोः सवर्णसंज्ञाविधिरुक्त ः (का० १.१.९)। दीर्घपक्षे तु समुदायान्तरतमस्य ऌवर्णस्य दीर्घस्याभावात् ॠकारः क्रियते॥"
    },
    {
      "source": "kaumudi",
      "sutra_id": "1.3.79",
      "source_key": "13079",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG108_DIRECT_P_EXCEPTION_VOICE_SOURCE_POLICY_OR_PREFIX_BOUNDARY",
      "text": "कर्तृगेऽपि फले गन्धनादौ च परस्मैपदार्थमिदम् । अनुकरोति । पराकरोति । कर्तरीत्येव । भावकर्मणोर्मा भूत् । न चैवमपि कर्मकर्तरि प्रसङ्गः । कार्यातिदेशपक्षस्य मुख्यतया तत्र कर्मवत्कर्मणा <{SK2766}> इत्यात्मनेपदेन परेणास्य बाधात् । शास्त्रातिदेशपक्षे तु कर्तरि शप् <{SK2167}> इत्यतः शेषात् <{SK2159}> इत्यतश्च कर्तृग्रहणद्वयमुवर्त्य कर्तैव यः कर्ता नतु कर्मकर्ता तत्रेति व्याख्येयम् ॥"
    },
    {
      "source": "balamanorama",
      "sutra_id": "1.3.79",
      "source_key": "13079",
      "status": "LITERAL_COMPLETE_SELECTED_FIELD",
      "use": "PG108_DIRECT_P_EXCEPTION_VOICE_SOURCE_POLICY_OR_PREFIX_BOUNDARY",
      "text": "<<अनुपराभ्यां कृञः>> - अनुपराभ्यां कृञः ।परस्मैपदमिति शेषः । ननु 'स्वरितञितः' इत्यात्मनेपदस्य कर्तगाम्नियेव फले विधानादकर्तृगामिनि फलेशेषात्कर्तरी॑ति परस्मैपदस्य सिद्धत्वात् किमर्थ मिदमित्यत आह —  कर्तृगेऽपीति । गन्धनादाविति । गन्धनावक्षेपणसेवनसाहसिक्यप्रतियत्नप्रकथनोपयोगेषु इत्यर्थः । मा भूदिति । भावे कर्मणि लकारस्य कर्तृगे फलेपरस्मपैदनिवृत्त्यर्थं कर्तरीत्यस्याऽनुवृत्तिरिति भावः । ननु कर्तरीत्यस्यानुवृत्तावपिअनुक्रियते शब्दः स्वयमेवे॑त्यत्र कर्मकर्तरि परस्मैपदं दुर्वारमित्याशङ्क्य परिहरति —  नचेति । एवमपि = कर्तरीत्यस्यानुवृत्तावपि कर्मकर्तरि आत्मनेपदस्य प्रसङ्गो न शङ्क्य इत्यर्थः । कुत इत्यत आह —  कार्यातिदेशेति । तत्र कर्मकर्तरिकर्मवत्कर्मणा तुल्यक्रियः॑ इत्यात्मनेपदेन परेणाऽस्य परस्मैपदस्य बाधादित्यन्वयः । नु कर्मणि यच्छास्त्रं तत्कर्मवत्कर्मणे॑ति कर्मकर्तर्यतिदिश्यते, तथा चाऽत्र कर्मकर्तरिभावकर्मणो॑रित्यात्मनेपदशास्त्रमिह प्राप्तम् । तस्य च परत्वाऽभावात् 'अनुपराभ्यां कृञः' इत्यनेन कथं बाधः स्यादित्यत आह —  कार्यातिदेशपक्षस्य मुख्यतयेति । शास्त्रातिदेशस्य कार्यातिदेशार्थतया कार्यातिदेशस्य मुख्यत्वम् । ततश्चकर्मवत् कर्मणे॑त्यनेन कर्मणि विहितमात्मनेपदं कर्मकर्तरि विधीयते । तस्य च परत्वात्तेनात्मनेपदेनअनुपराभ्याटमिति परस्मैपदं कर्मकर्तरि बाधमर्हतीति भावः ।कर्मवत्कर्मणे॑त्यत्र शास्त्रातिदेशमभ्युपगम्याअह —  - शास्त्रातिदेशपक्षे त्विति । 'अनुपराभ्यां कृञः' इत्यत्रकर्तरि कर्मव्यतिहारे॑ इत्यस्मादेकं कर्तृघणमनुवर्तते । तथाशेषात्कर्तरि परस्मैपद॑मित्यस्माद्द्वितीयं कर्तृग्रहणमनुवर्तते । तथा चस्वभावतः एव यः कर्ता, नतु विवक्षाधीनः कर्मकर्ता तथाविधकर्तर्येव अनुपराभ्यां कृञः परस्मैपद॑मिति लभ्यते । एवं च कर्मकर्तरि नास्य प्रवृत्तिरित्यर्थः ।"
    },
