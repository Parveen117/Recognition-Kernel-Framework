  "source_policy_decisions": [
    {
      "id": "YEAR",
      "sources": "KS,KS2,K91,K92",
      "decision": "Retain both electronic readings of the pari slot. Five recipient nouns do not constitute five cha derivatives. No inferred short-id masculine Kāṭhaka attestation."
    },
    {
      "id": "KH",
      "sources": "TB,BH,K91,K92",
      "decision": "Admit two grammar-regular and two explicitly commented exceptional kha forms in the petitions. No productive generalization to every year name."
    },
    {
      "id": "MAR",
      "sources": "TS,AV,RV,RV2",
      "decision": "One Marut adjective with two witnesses. Keep the annual brahma and temporal readings of the frog verse on one written form."
    },
    {
      "id": "VOW",
      "sources": "K93,K94,SB",
      "decision": "Separate the input case and referent at 93 and 94. Rite as subject, means or object receives its independently justified output case. The moon and the practitioner differ even at identical spelling."
    },
    {
      "id": "FEE",
      "sources": "K94,K95,K96",
      "decision": "Sacrifice name can be nontemporal. Possessive fee and locative food have different semantic and agreement histories."
    },
    {
      "id": "SCOPE",
      "sources": "K96,K97,JAY",
      "decision": "Preserve the imported seasonal variants, the end of the time restriction, the list guard and the given/done predicates. Rain clouds alone supply no 5.1.96 gift."
    }
  ]
}
