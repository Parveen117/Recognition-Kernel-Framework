  "source_policy_decisions":[
    {"id":"CENSURE_NAME","status":"Accepted/Open","decision":"Require a name reading for kan; preserve Kāśikā pūrṇaka and Vasu cūrṇaka separately pending critical priority."},
    {"id":"COMPASSION_FORKS","status":"Accepted/Open","decision":"Accept the shared compassion outputs and retain bubhukṣitaka/bubhukṣika and śvasitaki/viśvasitaki as source-labelled forks."},
    {"id":"COURTESY_MEANS","status":"Accepted","decision":"Distinguish the gift/action used to relieve the pitied entity from the entity directly evoking compassion."},
    {"id":"HUMAN_NAME_GUARD","status":"Accepted/Excluded","decision":"Restrict optional ṭhac to polysyllabic human personal names; exclude short-name and descriptive-epithet controls."},
    {"id":"GHAN_ILAC_OPTIONS","status":"Accepted","decision":"Keep ghan/ilac outputs and retained ṭhac/kan alternatives under separate histories."},
    {"id":"EASTERN_UPA_OPTIONS","status":"Accepted/Open","decision":"Accept aḍac/vuc only as the Eastern-school option on upa-initial human names; wider school priority remains Open."},
    {"id":"JATI_PERSONAL_NAME","status":"Accepted/Excluded","decision":"License a jāti word used as a personal name, not the literal word jāti or an unrestricted species noun."},
    {"id":"AJINA_LOPA","status":"Accepted","decision":"Attach second-member lopa to personal names ending in -ajina and preserve their histories on shared surfaces."}
