  "new_fields": [
    {
      "source": "kashika.txt",
      "field": "53081",
      "text": "बह्वच इति नानुवर्तते। सामान्येन विधानम्। जातिशब्दो यो मनुष्यनामधेयो व्याघ्र सिंह इत्येवमादिः, तस्मादनुकम्पायां नीतौ च कन् प्रत्ययो भवति। व्याघ्रकः। सिंहकः। शरभकः। वावचनानुवृत्तेर्यथादर्शनमन्योऽपि भवति। व्याघ्रिलः। सिंहिलः। नामग्रहणं स्वरूपनिवृत्त्यर्थम्॥"
    },
    {
      "source": "kashika.txt",
      "field": "53082",
      "text": "कनित्यनुवर्तते, मनुष्यनाम्न इति च। अजिनशब्दान्तात् प्रातिपदिकाद् मनुष्यनाम्नोऽनुकम्पायां कन् प्रत्ययो भवति, तस्य चोत्तरपदलोपः। व्याघ्राजिनो नाम कश्चिद् मनुष्यः, सोऽनुकम्पितो व्याघ्रकः। सिंहकः॥"
    },
    {
      "source": "kashika.txt",
      "field": "61163",
      "text": "चितोऽन्त उदात्तो भवति। <<भञ्जभासमिदो घुरच्>> [[३.२.१६१]] — भ॒ङ्गु॒रम्। भा॒सुरम्। मे॒दु॒रम्।  <<आगस्त्यकौण्डिन्ययोरगस्तिकुण्डिनच्>> [[२.४.७०]] — कु॒ण्डि॒नाः। चिति प्रत्यये प्रकृ तिप्रत्ययसमुदायस्यान्त उदात्त इष्यते। ब॒हु॒प॒टवः॑। उच्चकैः॥"
    },
    {
      "source": "nyaas_5744762.txt",
      "field": "53081",
      "text": "`नामग्रहणम्` इति। असति हि नामग्रहणे जातिस्वरूपग्रहणं स्यात्। अतः स्वरूपग्रवणं मा भूदित्येवमर्थं जातिग्रहणम्॥"
    },
    {
      "source": "nyaas_5744762.txt",
      "field": "53082",
      "text": "`व्याघ्राजिनो नाम कश्चित्` इति। व्याघ्रस्याजिनम्, व्याघ्राजिनमिवाजिनं यस्येति व्याघ्राजिनः। `सप्तम्युपमानपूर्वस्य बहुव्रीहिरुत्तरपदलोपश्च` (वा। 99) इति बहुव्रीहावुत्तरपदलोपे कृते व्याघ्राजिन इत्येष शब्दः सम्पद्यते। अथाजिनलोपश्चेत्येवं कस्मान्नोक्तम्, किमुत्तरपदग्रहणेन? नैवं शक्यम्; व्याघ्रमहाजिनौ नामकश्चित्, सोऽनुकम्पितः - व्माघ्रक इत्यत्राजिनशब्दस्य लोप उच्यमाने महच्छब्दस्य निवृत्तिर्न स्यात्। उत्तरपदस्यतु लोपे विधीयमाने भवति। तस्माद्यथान्यासमेवास्तु। महदजिनं महाजिनम्, व्याघ्रस्य महाजिनमिव महाजिनमस्येति पूर्ववदुत्तरपदलोपी बहुव्रीहिः, ततः कन्॥"
    },
    {
      "source": "balamanorama.txt",
      "field": "53082",
      "text": "<<अजिनान्तस्योत्तरपदलोपश्च>> - अजिनान्तस्य । व्याघ्रक इति । 'व्याघ्राजिन' इति कस्यचिन्मनुष्यस्य नाम । तस्मात्कनि अजिनकस्य लोपः । सिंहक इति । सिंहाजिनशब्दात्कनि अजिनस्य लोपः ।"
    }
  ],
