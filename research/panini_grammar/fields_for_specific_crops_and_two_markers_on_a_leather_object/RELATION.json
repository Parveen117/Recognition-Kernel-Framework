  "source_policy_decisions": [
    {
      "id": "FIELD",
      "sources": "K1,K2,K3,AM,HEMA",
      "decision": "Record the grain that grows. Price, seed measure and benefit are separate historical owners."
    },
    {
      "id": "TEXT",
      "sources": "K2,K4,AM,IDX",
      "decision": "The later examples resolve the isolated tala reading. Preserve the index’s short vowel; exclude it as an optional Pāṇinian spelling without additional evidence."
    },
    {
      "id": "UNITS",
      "sources": "K3,K4,AM",
      "decision": "Separate words actually written in the verse from compounds, an index expansion and an authored case paradigm."
    },
    {
      "id": "NASAL",
      "sources": "K4,GRID,NAT",
      "decision": "Keep the ṇ of the field suffix apart from an outer instrumental n, neuter num or genitive nuṭ. The same ṣ cannot cross an intervening ṇ."
    },
    {
      "id": "SCOPE",
      "sources": "K5,K6",
      "decision": "Leather describes the material and sarva the product. The whole face and the reflection support in the second mirror example are different referents."
    }
  ]
}
