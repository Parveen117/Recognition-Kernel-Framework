  "source_policy_decisions":[
    {"id":"GENERAL_DEGREE","status":"Accepted","decision":"Keep tamap and iṣṭhan histories distinct and allow a further degree suffix on a degree base only where positively displayed."},
    {"id":"FINITE_SUPERLATIVE","status":"Accepted/Excluded","decision":"Accept finite-base tamap with ām; exclude iṣṭhan from the finite path under the quality restriction."},
    {"id":"COMPARISON_DOMAIN","status":"Accepted","decision":"Distinguish two-member comparison from a grammatically expressed comparison set; do not impose yathāsaṃkhya on tarap/īyasun."},
    {"id":"QUALITY_RESTRICTION","status":"Accepted/Excluded","decision":"Restrict iṣṭhan/īyasun to quality words while retaining tarap/tamap for both quality and nonquality bases."},
    {"id":"VEDIC_TR_EXTENSION","status":"Accepted/Open","decision":"Accept only the displayed Vedic tṛ-base outputs; wider register, accent and recensional evidence remain Open."},
    {"id":"PRASASYA_SHR","status":"Accepted","decision":"Own śr replacement and prevent otherwise expected lopa under the stated one-vowel preservation."},
    {"id":"PRASASYA_JY","status":"Accepted","decision":"Keep the optional praśasya→jy history distinct from praśasya→śr."},
    {"id":"VRDDHA_REPLACEMENTS","status":"Accepted","decision":"Attach vṛddha→jy readings to existing surfaces and preserve optional vṛddha→varṣ outputs separately."},
    {"id":"NED_SADH","status":"Accepted","decision":"Apply antika→ned and bāḍha→sādh without pairing the two suffixes by yathāsaṃkhya."},
    {"id":"YUVAN_ALPA_KAN","status":"Accepted","decision":"Keep yuvan and alpa as two histories of shared kan surfaces and preserve each unreplaced alternative."},
    {"id":"VIN_MAT_LOPA","status":"Accepted","decision":"Own vin/mat lopa only before iṣṭhan/īyasun and retain separate sraj/tvac stem histories."}
  ]
