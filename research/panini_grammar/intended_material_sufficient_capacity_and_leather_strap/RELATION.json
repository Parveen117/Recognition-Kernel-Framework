  "source_policy_decisions": [
    {
      "id": "MATERIAL",
      "sources": "K12,BV",
      "decision": "Intention alone fails for scabbard and sword; material origin alone fails without dedication. The two old PG748 examples are controls."
    },
    {
      "id": "UPADHI",
      "sources": "K13,KI,BV",
      "decision": "A named inner prefixed ki and a different outer ḍhañ survive in two readings of the wheel wood. The English digital auṣadheya is not an adopted alternative in this history."
    },
    {
      "id": "OFFERING",
      "sources": "K13,RA",
      "decision": "The corpus contributes a neuter accusative, separate from the grammar’s masculine rice nominative plural. Ritual purpose in the poem has explicit commentator authority."
    },
    {
      "id": "LEATHER",
      "sources": "K14,K15",
      "decision": "Neither leather as a following material nor a surface substring selects añ. Shoe-production and the already admitted sanaṅgu retain earlier priority."
    },
    {
      "id": "STRAP",
      "sources": "K15,U28,PM",
      "decision": "Connect the earlier named strap to vṛdh + ran, derivative aṇ and feminine ṅīp. Tattva’s independent vadhrī analysis remains a separate branch."
    },
    {
      "id": "CAPACITY",
      "sources": "K12,K16,K17",
      "decision": "Hold the wall and bricks fixed and vary intention versus adequacy. Support case and role are queryable at zero even when the resulting endings coincide."
    },
    {
      "id": "SYLLABLE",
      "sources": "SB",
      "decision": "PG747 extension: the Śatapatha has a direct five-formula count with a different final exclamation in §16. This supplies neither an MS emendation nor the exact missing adjective."
    }
  ]
