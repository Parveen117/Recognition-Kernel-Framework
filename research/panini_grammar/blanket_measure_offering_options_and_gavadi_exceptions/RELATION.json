  "source_policy_decisions": [
    {
      "id": "SCOPE",
      "sources": "K1,K4",
      "decision": "Benefit, intended raw material and potential inclusion are distinct input relations under the heading, PG36 5.1.5/12/16. The next price meaning bounds the heading."
    },
    {
      "id": "PRIORITY",
      "sources": "K2,N2,K4",
      "decision": "Literal priority for sanaṅgu, caru and saktu. The optionality for offering names does not supply a cha on these protected requests."
    },
    {
      "id": "WHEEL",
      "sources": "K2,N2",
      "decision": "Only the wheel-nave lexical route owns nabha. Terminal i deletion on the body-part path leaves its long ā."
    },
    {
      "id": "DOG",
      "sources": "N2,K2",
      "decision": "The two segmental alternatives share n retention. Nyāsa correlates final accent with optional length, where the archived English Vasu displays both words with final marking."
    },
    {
      "id": "WELL",
      "sources": "K2,N2",
      "decision": "Read kūpaḥ as the explicit cited head in this edition. K's pinned roster instead punctuates kūpa as a separate item; status as a member in other lists remains source-specific."
    },
    {
      "id": "MEASURE",
      "sources": "K3,IT,H34",
      "decision": "Naming or citing the unit and deriving it with a t-marked suffix supply different information. Keep the same-surface Haima ya and the two P semantic explanations distinct."
    },
    {
      "id": "CALIBRATION",
      "sources": "K3,H34,H186",
      "decision": "The K and Dhundhikā witnesses give 100 palas. Retain the two alternative numerical expressions as attributed reports. No physical conversion or global unit definition follows."
    },
    {
      "id": "PURCHASE",
      "sources": "B22,K22,K28",
      "decision": "Inner named unit survives; the outer price affix is the token deleted. The outer result is an ordinary purchase description. The measure-specific block acts on ṅīp."
    },
    {
      "id": "OPTION",
      "sources": "K4,K2",
      "decision": "Literal havis and a word designating an offering have different membership tests. PG744 already owns the Vedic praise case with its inner offering history."
    }
  ]
