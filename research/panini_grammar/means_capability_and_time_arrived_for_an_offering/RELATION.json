  "source_policy_decisions": [
    {
      "id": "PAIR",
      "sources": "K98,K99",
      "decision": "Pair the affixes in order, allowing both given and done independently for each. An indeclinable has no visible instrumental inflection."
    },
    {
      "id": "KARM",
      "sources": "K99,K101,K103,EPIC",
      "decision": "Disambiguate karman by underlying syntactic support and sense. Bow is the explicit entitlement guard. The epic supplies the object case."
    },
    {
      "id": "PORT",
      "sources": "K104,SB,HARI,TS,PU",
      "decision": "One portion with two explanatory addresses, three separately attested cases/layers and a different adjective for the ineligible eater. Preserve the literal attributed cross-reference."
    },
    {
      "id": "YEAR",
      "sources": "K104,K106,RV,AV",
      "decision": "The regular aṇ and Vedic ghas differ in class and grade. Keep the Ṛgvedic commentator's occurrence paraphrase distinct from the grammatical arrival predicate. The AV parallel adds no duplicate word."
    },
    {
      "id": "DEBT",
      "sources": "K107,NAR,NLOC,MAN",
      "decision": "Duration of a debt, periodicity of interest and Manu's compound are separate lexical and temporal evidence."
    }
