  "source_policy_decisions": [
    {
      "id": "PHON",
      "sources": "K131,K132,GITA,YOGA",
      "decision": "Enforce the immediately relevant syllable, not a merely similar spelling. Record nominative, ablative and accusative śauca on their individual governors."
    },
    {
      "id": "SAH",
      "sources": "K132,BV",
      "decision": "Keep Jayāditya’s choice and the reported Bhāgavṛtti rejection separate."
    },
    {
      "id": "SCHOOL",
      "sources": "K133,K134,BV",
      "decision": "Coordinated father and son is not a lineage predicate. Identical instrumentals of self-praise and disparagement acquire one case each."
    },
    {
      "id": "OFFICE",
      "sources": "K135,VAS,AB,GB19",
      "decision": "Preserve literal source forms. Direct neṣṭrīyāyai at 6.14 is evidence of the neṣṭṛ office, not a silent emendation of Vasu’s field or a spelling of tvaṣṭṛ."
    },
    {
      "id": "BRAH",
      "sources": "K136,GB11,GB19,PG129",
      "decision": "Register distinct bases, suffixes and cases of the office holder, the office performed and the class property known."
    },
    {
      "id": "EDGE",
      "sources": "AB,K135",
      "decision": "The first oblique āgnīdhrīyāyā before uktham has no overt -yai. No third dative is credited by analogy. The accusative under the causal verb is secure."
    }
  ]
}
