{
  "edition": "5744762f010d677cfb43f347a42d02796cf615d6",
  "fields": [
    {
      "work": "kashika",
      "rule": "3.1.20",
      "field": "31020",
      "text": "करण इति वर्तते। पुच्छ भाण्ड चीवर इत्येतेभ्यो णिङ् प्रत्ययो भवति, करणविशेषे॥ पुच्छादुदसने पर्यसने वा॥ उत्पुच्छयते। परिपुच्छयते॥ भाण्डात् समाचयने॥ संभाण्डयते॥ चीवरादर्जने परिधाने वा॥ संचीवरयते भिक्षुः। ङकार आत्मनेपदार्थः। णकारः सामान्यग्रहणार्थः <<णेरनिटि>> (६.४.५१) इति॥"
    },
    {
      "work": "kashika",
      "rule": "3.1.120",
      "field": "31120",
      "text": "कृञो वृषश्च विभाषा क्यप् प्रत्ययो भवति। करोतेर्ण्यति प्राप्ते, वर्षतेर्ऋदुपधत्वाद् नित्ये क्यपि प्राप्ते विभाषारभ्यते। कृत्यम्, कार्यम्। वृष्यम्, वर्ष्यम्॥"
    },
    {
      "work": "kashika",
      "rule": "3.4.35",
      "field": "34035",
      "text": "कर्मणीत्येव। शुष्कादिषु कर्मवाचिषूपपदेषु पिषेर्धातोर्णमुल् प्रत्ययो भवति। शुष्कपेषं पिनष्टि। शुष्कं पिनष्टीत्यर्थः। चूर्णपेषं पिनष्टि। चूर्णं पिनष्टीत्यर्थः। रूक्षपेषं पिनष्टि। रूक्षं पिनष्टीत्यर्थः॥"
    },
    {
      "work": "kashika",
      "rule": "6.4.161",
      "field": "64161",
      "text": "रशब्द आदेशो भवति ऋकारस्य हलादेर्लघोरिष्ठेमेयस्सु परतः। प्रथिष्ठः। प्रथिमा। प्रथीयान्। म्रदिष्ठः। म्रदिमा। म्रदीयान्। ऋत इति किम्? पटिष्ठः। पटिमा। पटीयान्। हलादेरिति किम्? ऋजिष्ठः। ऋजिमा। ऋजीयान्। लघोरिति किम्? कृष्ण — कृष्णिष्ठः। कृष्णिमा। कृष्णीयान्। परिगणनमत्र कर्तव्यम्।\n\nपृथुं मृदुं भृशं चैव कृशं च दृढमेव च।\n\nपरिपूर्वं वृढं चैव षडेतान् रविधौ स्मरेत्॥\n\nतत इह न भवति — कृतमाचष्टे कृतयति। मातरमाचष्टे मातयति। भ्रातयति॥"
    }
  ],
