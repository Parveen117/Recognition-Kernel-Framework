  "source_policy_decisions": [
    {
      "id": "ROW",
      "sources": "K59,SB",
      "decision": "Five feet are explicit in the metre and five items in the ritual list. A line of ants need not have five members."
    },
    {
      "id": "TEAM",
      "sources": "RV5,RV6,MR",
      "decision": "The number's case and grammatical number belong to the numeral. The restored extra syllable in the edition has no second case credit."
    },
    {
      "id": "PRICE",
      "sources": "R8",
      "decision": "The price construction gives another inflection of the lexical hundred, without an outer price derivative."
    },
    {
      "id": "CLASS",
      "sources": "K59,K60",
      "decision": "The pre-varga d spelling is voiced contact of the final stop. The optional kan is an independently licensed alternative."
    },
    {
      "id": "TITLE",
      "sources": "K62,H,KAU,AIT",
      "decision": "The evidence verifies the two chapter counts. Edition identity rests on Haug's interpretation; exact independent occurrences of the names for those specific books remain Open."
    }
  ]
