  "source_policy_decisions": [
    {
      "id": "PAY",
      "sources": "K37",
      "decision": "A plural number of beans can constitute payment. Neither the instrumental agent nor the buyer's hand does. A bare dual of a capacity word is not automatically a numbered-price compound."
    },
    {
      "id": "SIGN",
      "sources": "K38,K39",
      "decision": "Connection and perceived omen are separately typed. The medical vocabulary is a traditional supplement on pacification or aggravation, with no clinical inference and no new cases credited."
    },
    {
      "id": "EPIC",
      "sources": "K40,RAM,RC,R14",
      "decision": "The feminine accusative has explicit commentary assigning cha. Both verses and numbering traditions support one position."
    },
    {
      "id": "ROYAL",
      "sources": "K41,K42,K43,AB,RG,ML",
      "decision": "Six requests, two lexical bases and three senses. Source attestations corroborate the two royal cases and add no duplicate cases on the same histories."
    },
    {
      "id": "EARTH",
      "sources": "RV",
      "decision": "The Vedic neuter adjective concerns earth-related regions. Exclude this occurrence from the sovereign, occasion and fame branches. Leave its precise general outer rule Open here."
    },
    {
      "id": "FIELD",
      "sources": "K44,K45,K46",
      "decision": "A world as locus of fame, seed-measure for a field and a paid measure are distinct predicates. Preserve the ṅīṣ of the field portion separately from PG752’s ṅīp."
    }
  ]
