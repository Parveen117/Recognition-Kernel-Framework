  "source_policy_decisions": [
    {
      "id": "MONEY",
      "sources": "K47,M7,M8,MED",
      "decision": "The non-agent amount is the subject of being given. The recipient may be dative under an addition or construed as locus. Manu 7.85 provides the latter analogy; 8.141–142 independently supplies numeric interest forms."
    },
    {
      "id": "HALF",
      "sources": "K48,K49",
      "decision": "The commercial half takes ṭhan on this relation although the earlier single-price half took ṭiṭhan. The result agreeing with viṃśati has two short-stem feminine ā outcomes."
    },
    {
      "id": "LOAD",
      "sources": "K50",
      "decision": "The explicit load noun and its alternative semantic interpretation generate separate derivatives. A load of unlisted rice fails either policy."
    },
    {
      "id": "FEE",
      "sources": "K51,RV9,RV10,VI",
      "decision": "Preserve vasna and its inner Uṇādi relation. The Vedic lexical base and price phrase do not attest the derived word vasnika."
    },
    {
      "id": "COOK",
      "sources": "K52,B45",
      "decision": "The droṇa cook has aṇ or ṭhañ according to Bāla. The same commentator assigns droṇa-field ṭhak at 45."
    },
    {
      "id": "DVIGU",
      "sources": "K53,K54,K55",
      "decision": "Keep the ownership of ordinary ṭhañ, special ṣṭhan and kha. The selected feminine endings and position of strengthening show which branches survive."
    }
  ]
}
