{
  "kind": "exact selected rendered-line payload; line metadata separate; no raw HTML or scan claim",
  "printed_address_labels": "KA_III,402.3-403.24 / Ro_V,389-391 as supplied by electronic edition,not independently collated print",
  "rows": [
    {
      "rendered_line": 2726,
      "record": 1,
      "text": "धि सकारे सिचः लोपः ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2728,
      "record": 2,
      "text": "धि सकारे सिचः लोपः वक्तव्यः ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2730,
      "record": 3,
      "text": "किम् प्रयोजनम् ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2732,
      "record": 4,
      "text": "चकाद्धि इति प्रयोजनम् । इह मा भूत् ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2734,
      "record": 5,
      "text": "चकाद्धि पलितम् शिरः ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2735,
      "record": 6,
      "text": "यदि तर्हि सिचः लोपः इति उच्यते ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2737,
      "record": 7,
      "text": "आशाध्वम् तु कथम् ते स्यात् । आशाध्वम् इति अत्र न प्राप्नोति ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2739,
      "record": 8,
      "text": "जश्त्वम् सस्य भविष्यति । जश्त्वम् अत्र सकारस्य भविष्यति ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2741,
      "record": 9,
      "text": "सर्वत्र एवम् प्रसिद्धम् स्यात् । सर्वत्र एवम् जश्त्वेन सिद्धम् स्यात् ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2742,
      "record": 10,
      "text": "इह अपि आयन्ध्वम् अरन्ध्वम् इति जश्त्वेन एव सिद्धम् ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2744,
      "record": 11,
      "text": "श्रुतिः च अपि न भिद्यते । श्रुतिकृतः च अपि न कः चित् भेदः भवति ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2746,
      "record": 12,
      "text": "लुङः च अपि न मूर्धन्ये ग्रहणम् । तत्र अयम् अपि अर्थः इणःषीध्वंलुङ्लिटान्धोऽङ्गात् इति अत्र लुङ्ग्रहणम् न कर्तव्यम् ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2747,
      "record": 13,
      "text": "इह अपि अच्योड्ढ्वम् अप्लोड्ढ्वम् इति षत्वे सिचः धस्य ष्टुत्वे च कृते जश्त्वेन सिद्धम् ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2749,
      "record": 14,
      "text": "सेटि दुष्यति । सेटि दोषः भवति ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2751,
      "record": 15,
      "text": "इदम् एव रूपम् स्यात् अलविड्ढ्वम् इदम् न स्यात् अलविध्वम् इति ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2753,
      "record": 16,
      "text": "तस्मात् सिचः ग्रहणम् कर्तव्यम् ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2754,
      "record": 17,
      "text": "यदि तर्हि सिचः ग्रहणम् क्रियते ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2756,
      "record": 18,
      "text": "घसिभस्योः न सिध्येत् तु । घसिभस्योः न सिध्यति ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2758,
      "record": 19,
      "text": "सग्धिः च मे सपीतिः च मे, बब्धाम् ते हरी धानाः इति अत्र न प्राप्नोति ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2760,
      "record": 20,
      "text": "तस्मात् सिज्ग्रहणम् न तत् । तस्मात् धिच इति अत्र सिचः ग्रहणम् न कर्तव्यम् ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2761,
      "record": 21,
      "text": "कथम् चकाद्धि पलितम् शिरः इति ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2763,
      "record": 22,
      "text": "एवम् तर्हि सिज्ग्रहणम् कर्तव्यम् ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2765,
      "record": 23,
      "text": "कथम् सग्धिः च मे सपीतिः च मे , बब्धम् ते हरी धानाः इति ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2767,
      "record": 24,
      "text": "इह तावत् सग्धिः इति न एतत् घसेः रूपम् ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2769,
      "record": 25,
      "text": "किम् तर्हि सघेः एतत् रूपम् ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2770,
      "record": 26,
      "text": "बब्धाम् ते हरी धानाः इति न एतत् भसेः रूपम् ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2772,
      "record": 27,
      "text": "किम् तर्हि बन्धेः एतत् रूपम् ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2774,
      "record": 28,
      "text": "छान्दसः वर्णलोपः वा यथा इष्कर्तारमध्वरे । अथ वा छान्दसः वर्णलोपः भविष्यति यथा इष्कर्तारमध्वरे ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2776,
      "record": 29,
      "text": "तत् यथा ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2778,
      "record": 30,
      "text": "तुभ्येदम् अग्ने ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2779,
      "record": 31,
      "text": "तुभ्यम् इदम् अग्ने इति प्राप्ते ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2781,
      "record": 32,
      "text": "आम्बानाम् चरुः ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2783,
      "record": 33,
      "text": "नाम्बानाम् चरुः इति प्राप्ते ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2785,
      "record": 34,
      "text": "आव्याधिनीः उगणाः ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2787,
      "record": 35,
      "text": "आव्याधिनीः सुगणाः इति प्राप्ते ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2789,
      "record": 36,
      "text": "इष्कर्तारम् अध्वरस्य ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2790,
      "record": 37,
      "text": "निष्कर्तारम् इति प्राप्ते ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2792,
      "record": 38,
      "text": "शिवा उद्रस्य भेषजी ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2794,
      "record": 39,
      "text": "शिवा रुद्रस्य भेषजीति प्राप्ते ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2796,
      "record": 40,
      "text": "तस्मात् सिज्ग्रहणम् कर्तव्यम् ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2798,
      "record": 41,
      "text": "न कर्तव्यम् ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2800,
      "record": 42,
      "text": "यत् एतत् रात्सस्य इति सकारग्रहणम् तत् सिचः ग्रहणम् विज्ञास्यते ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2801,
      "record": 43,
      "text": "कथम् ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2803,
      "record": 44,
      "text": "रात्सस्य इति उच्यते न च अन्यः रेफात् परः सकारः अस्ति अन्यत् अतः सिचः ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2805,
      "record": 45,
      "text": "ननु च अयम् अस्ति मातुः पितुः इति ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2807,
      "record": 46,
      "text": "तस्मात् सिचः ग्रहणम् कर्तव्यम् ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2809,
      "record": 47,
      "text": "न कर्तव्यम् ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2810,
      "record": 48,
      "text": "कस्मात् न भवति चकाद्धि पलितम् शिरः इति ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2812,
      "record": 49,
      "text": "इष्टम् एव एतत् सङ्गृहीतम् ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2814,
      "record": 50,
      "text": "चकाधि इति एव भवितव्यम् ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2816,
      "record": 51,
      "text": "धि सकारे सिचः लोपः ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2818,
      "record": 52,
      "text": "चकाद्धि इति प्रयोजनम् ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2820,
      "record": 53,
      "text": "आशाध्वम् तु कथम् ते स्यात् ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2821,
      "record": 54,
      "text": "जश्त्वम् सस्य भविष्यति ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2823,
      "record": 55,
      "text": "सर्वत्र एवम् प्रसिद्धम् स्यात् ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2825,
      "record": 56,
      "text": "श्रुतिः च अपि न भिद्यते ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2827,
      "record": 57,
      "text": "लुङः च अपि न मूर्धन्ये ग्रहणम् ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2829,
      "record": 58,
      "text": "सेटि दुष्यति ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2831,
      "record": 59,
      "text": "घसिभस्योः न सिध्येत् तु ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2832,
      "record": 60,
      "text": "तस्मात् सिज्ग्रहणम् न तत् ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2834,
      "record": 61,
      "text": "छान्दसः वर्णलोपः वा यथा इष्कर्तारमध्वरे ।",
      "allocation": "dialogue_or_recap"
    },
    {
      "rendered_line": 2836,
      "record": 62,
      "text": "दादेः धातोः घः ।",
      "allocation": "next_heading_not_consumed"
    }
  ]
}
