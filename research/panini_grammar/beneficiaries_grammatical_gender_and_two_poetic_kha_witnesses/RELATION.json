  "source_policy_decisions": [
    {
      "id": "NOSE",
      "sources": "K6,NAS",
      "decision": "Only the targeted benefit use receives nas. PG748’s navel oil is already credited. The city and speech-sound senses are separate controls."
    },
    {
      "id": "LEX",
      "sources": "K7",
      "decision": "Vṛṣan and the lexical brāhmaṇa do not substitute for the literal operands. The explanatory dative phrase does not receive an additional suffix by default."
    },
    {
      "id": "FEM",
      "sources": "K8,PV,BV",
      "decision": "Female beneficiary and feminine target have different owners. The same word can qualify yūthi or bhūmi without a second spelling."
    },
    {
      "id": "PS-GAP",
      "sources": "PS,K9,BH,GH",
      "decision": "The K apparatus cites PS 5.11.8. In the checked recension ātmana enaṃ are separate; a direct positive classical case with an explicit rule attribution is available in Bhāravi 13.69."
    },
    {
      "id": "MESSAGE",
      "sources": "BV,MA,K9",
      "decision": "Identify the actual Māgha verse and its passive nominative message. Preserve the distinction from PG739's locative fitness form with vṛddhi."
    },
    {
      "id": "COMPOUND",
      "sources": "K9,BV",
      "decision": "Use the supplied compound analysis before affix selection. A lexical bahuc prefix is insufficient to meet the body-as-final-member test."
    },
    {
      "id": "DENTAL",
      "sources": "K9,RET",
      "decision": "Separate the n of the outer suffix and the body compound. The explicitly excepted teacher-body form retains dental n."
    },
    {
      "id": "ORDER",
      "sources": "K10,K11,BV",
      "decision": "Sarva and puruṣa map by order. Khañ, including ñ-conditioned first grade, has its own address even where kha already exposes īna."
    }
  ]
}
