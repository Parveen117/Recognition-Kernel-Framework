  "source_policy_decisions": [
    {
      "id": "QUAL",
      "sources": "K63,K65",
      "decision": "Separate the predicate qualification from affix choice. Block śīrṣa replacement without its co-conditioned affix."
    },
    {
      "id": "MARK",
      "sources": "K66,MAN",
      "decision": "Keep literal ya and adopted yat histories. Count the shared unaccented word once on each actual case address."
    },
    {
      "id": "POST",
      "sources": "K67,BAU",
      "decision": "Treat the Śrautasūtra as a witness to lexical use. Its two oblique cases do not establish a general unrestricted Classical yat rule."
    },
    {
      "id": "PAIR",
      "sources": "K68,K69,K71,SUP",
      "decision": "Both suffixes distribute to both bases at 69; apply ordered pairing at 71. Exclude a reversed assignment."
    },
    {
      "id": "GODS",
      "sources": "RV3,RV46",
      "decision": "The names are objects. The plural in 4 and 6 shares one inflection but has two documented interpretations."
    },
    {
      "id": "POEM",
      "sources": "BHK,JAY,MAL",
      "decision": "Separate verse inflections, a compound-internal stem, the commentator's explanatory nominative and a play's Sanskrit chāyā. The different Bhaṭṭi citation in S1 stays Open."
    }
  ]
